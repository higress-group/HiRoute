{
  "artifact_kind": "hiroute.model-metadata-source-registry",
  "default_refresh_days": 30,
  "policy": {
    "allowed_evidence": [
      "provider-controlled documentation",
      "provider-controlled product or model pages",
      "authenticated service metadata captured without secrets"
    ],
    "allowed_client_metadata_sources": [
      "Hermes Agent source tree pinned to an exact Git commit",
      "OpenClaw source tree pinned to an exact Git commit"
    ],
    "metadata_usage": [
      "derive scenario eligibility from field completeness",
      "retain provenance for audit, refresh, identity normalization, and conflict handling",
      "never assign a record-wide confidence tier from source type"
    ],
    "discovery_only": [
      "third-party aggregate catalogs",
      "search snippets",
      "community posts without provider confirmation"
    ],
    "new_authority_requirements": [
      "confirm provider or product-owner control",
      "use the narrowest stable HTTPS prefix",
      "declare evidence scope and refresh interval",
      "add a concrete catalog evidence source separately"
    ]
  },
  "authorities": [
    {
      "authority_key": "alibaba-model-studio",
      "allowed_https_prefixes": [
        "https://help.aliyun.com/"
      ],
      "scope": [
        "interfaces",
        "models",
        "pricing",
        "products"
      ],
      "refresh_days": 14
    },
    {

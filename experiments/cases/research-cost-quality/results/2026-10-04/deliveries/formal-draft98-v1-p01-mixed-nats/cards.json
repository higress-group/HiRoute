    {
      "id": "nats-14",
      "verdict": "supported",
      "fact": "AckNak 表示该消息当前不处理、处理可移向下一消息，被 NAK 的消息会被重试。",
      "citations": [
        {
          "source": "nats",
          "start": 176,
          "end": 176
        }
      ]
    },
    {
      "id": "nats-15",
      "verdict": "supported",
      "fact": "在 AckWait 到期前发送 AckProgress 表示工作仍在进行，并将等待期再延长一个 AckWait。",
      "citations": [
        {
          "source": "nats",
          "start": 177,
          "end": 177
        }
      ]
    },
    {
      "id": "nats-16",
      "verdict": "refuted",
      "fact": "AckTerm 不是确认消息已成功处理；资料说它指示服务器停止重投该消息，但不将其作为成功处理确认。",
      "citations": [
        {
          "source": "nats",
          "start": 179,
          "end": 179
        }
      ]
    },
    {
      "id": "nats-17",
      "verdict": "refuted",
      "fact": "AckNext 不支持 double acknowledgement；资料明确说除 AckNext 外的其他 acknowledgement modes 支持 double ack。",
      "citations": [
        {
          "source": "nats",
          "start": 181,
          "end": 181
        }
      ]
    },
    {
      "id": "nats-18",
      "verdict": "supported",
      "fact": "资料用 Message Deduplication 与 double ack 的组合来说明 JetStream 支持 exactly-once publication and consumption。",
      "citations": [
        {
          "source": "nats",
          "start": 184,
          "end": 184
        }
      ]
    },
    {
      "id": "nats-19",
      "verdict": "supported",
      "fact": "DeliverPolicy 只决定首次从哪里开始；资料明确说它只是 starting point，启动后仍会给出未看到或未确认的消息，而不是持续重置的重放过滤器。",
      "citations": [
        {
          "source": "nats",
          "start": 196,
          "end": 196
        }
      ]
    },
    {
      "id": "nats-20",
      "verdict": "supported",
      "fact": "Durable consumer 在断开后仍存在；ephemeral consumer 仅在 delivery subject 有活跃订阅时存在，并在无订阅者后经短暂宽限期被移除。",
      "citations": [
        {
          "source": "nats",
          "start": 248,
          "end": 249
        }
      ]
    },
    {
      "id": "nats-21",
      "verdict": "supported",
      "fact": "消费者文档区分 Core NATS 的 at most once delivery guarantee，并说明 JetStream consumer 可提供 at least once delivery guarantee。",
      "citations": [
        {
          "source": "nats-consumers",
          "start": 4,
          "end": 4
        }
      ]
    },
    {
      "id": "nats-22",
      "verdict": "supported",
      "fact": "Push consumer 将消息投递到指定 subject；Pull consumer 允许客户端按需请求一批消息。",
      "citations": [
        {
          "source": "nats-consumers",
          "start": 9,
          "end": 10
        }
      ]
    },
    {
      "id": "nats-23",
      "verdict": "supported",
      "fact": "资料推荐新项目优先使用 pull consumer，尤其当扩展性、详细流控或错误处理是关注点时。",
      "citations": [
        {
          "source": "nats-consumers",
          "start": 14,
          "end": 15
        }
      ]
    },
    {
      "id": "nats-24",
      "verdict": "refuted",
      "fact": "Ordered consumer 不是 durable；资料明确说它总是 ephemeral。",
      "citations": [
        {
          "source": "nats-consumers",
          "start": 19,
          "end": 19
        }
      ]
    },
    {
      "id": "nats-25",
      "verdict": "supported",
      "fact": "Ordered consumer 不使用确认；检测到 gap 时，consumer 会被重建。",

          "source": "nats-consumers",
          "start": 22,
          "end": 23
        }
      ]
    },
    {
      "id": "nats-27",
      "verdict": "refuted",
      "fact": "只设置 Name 不设置 Durable 不会创建 durable consumer；资料说这只会创建 named consumer，服务器仍将其作为 ephemeral consumer。",
      "citations": [
        {
          "source": "nats-consumers",
          "start": 26,
          "end": 26

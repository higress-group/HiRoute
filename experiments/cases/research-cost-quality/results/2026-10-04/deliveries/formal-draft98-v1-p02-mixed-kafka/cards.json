          "end": 9
        }
      ]
    },
    {
      "id": "kafka-04",
      "verdict": "refuted",
      "fact": "文档说明：自 0.11.0.0 起，Kafka 生产者支持使用事务将消息原子写入多个 topic partition，因此并非只能支持单分区。",
      "citations": [
        {
          "source": "kafka",
          "start": 9,
          "end": 9
        }
      ]

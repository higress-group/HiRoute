    {
      "id": "redis-09",
      "verdict": "supported",
      "fact": "受支持：消费者崩溃恢复时先读取 pending history 可能导致消息被重复处理；历史消费完后，可改用大于号开始消费新消息。",
      "citations": [
        {
          "source": "redis",
          "start": 435,
          "end": 436
        }

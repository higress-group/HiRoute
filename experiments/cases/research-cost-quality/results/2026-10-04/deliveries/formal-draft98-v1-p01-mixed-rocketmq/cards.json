    },
    {
      "id": "rocketmq-02",
      "verdict": "supported",
      "fact": "消费失败、系统异常、超时，或消息在 push consumer 队列停留过久，均可触发消费重试。",
      "citations": [
        {
          "source": "rocketmq",
          "start": 21,
          "end": 23
        }

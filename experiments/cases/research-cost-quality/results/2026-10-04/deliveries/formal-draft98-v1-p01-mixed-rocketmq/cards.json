          "end": 32
        }
      ]
    },
    {
      "id": "rocketmq-04",
      "verdict": "supported",
      "fact": "在 PushConsumer 和 SimpleConsumer 状态机中，Ready 表示消息在 broker 上等待消费，Inflight 表示已被获取但消费结果尚未返回。",
      "citations": [

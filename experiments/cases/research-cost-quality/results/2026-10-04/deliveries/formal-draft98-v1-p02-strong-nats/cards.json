{
  "cards": [
    {
      "id": "nats-01",
      "verdict": "supported",
      "fact": "MaxMsgs、MaxBytes、MaxAge 在 WorkQueuePolicy 与 InterestPolicy 下仍作为消息保留的数量、总大小和年龄上限。",
      "citations": [{"source": "nats", "start": 11, "end": 13}]
    },
    {
      "id": "nats-02",
      "verdict": "refuted",
      "fact": "WorkQueuePolicy 不允许定义匹配范围重叠的消费者；stream 捕获的每个 subject 同一时间只能对应一个消费者。",
      "citations": [{"source": "nats", "start": 9, "end": 9}]
    },
    {
      "id": "nats-03",
      "verdict": "supported",
      "fact": "InterestPolicy 在所有当前已定义且匹配该消息 subject 的消费者都收到应用的显式确认后，按该策略删除消息；年龄、大小和数量上限仍可使消息更早被移除。",
      "citations": [{"source": "nats", "start": 10, "end": 13}]
    },
    {
      "id": "nats-04",
      "verdict": "supported",
      "fact": "Stream 可通过 MaxMsgSize 设置低于 NATS 总体最大消息限制的单条消息上限；文档举例将 stream 上限设为 1024 字节。",
      "citations": [{"source": "nats", "start": 14, "end": 14}]
    },
    {
      "id": "nats-05",
      "verdict": "supported",
      "fact": "文档在达到 LimitsPolicy 所设限制的语境下说明：DiscardOld 删除旧消息以腾出空间，DiscardNew 拒绝新消息。",
      "citations": [{"source": "nats", "start": 15, "end": 15}]
    },
    {
      "id": "nats-06",
      "verdict": "refuted",
      "fact": "JetStream 发布去重依据 Nats-Msg-Id 消息头中的 ID，而不比较消息 body。",
      "citations": [{"source": "nats", "start": 18, "end": 25}]
    },
    {
      "id": "nats-07",
      "verdict": "supported",
      "fact": "该快照记载默认发布去重窗口为 2 分钟，可在创建 stream 时通过 --dupe-window 配置。",
      "citations": [{"source": "nats", "start": 36, "end": 36}]
    },
    {
      "id": "nats-08",
      "verdict": "refuted",
      "fact": "向 stream 配置覆盖的 subject 发送 Request()，服务会在存储消息后回复；普通 publish 不会收到这种回复。Stream 还可通过 NoAck=true 关闭确认，因此不能声称两者总有相同响应。",
      "citations": [{"source": "nats", "start": 38, "end": 38}]
    },
    {
      "id": "nats-09",
      "verdict": "supported",
      "fact": "Stream 可在配置中设置 NoAck=true，以关闭 stream 接收消息的确认。",
      "citations": [{"source": "nats", "start": 38, "end": 38}]
    },
    {
      "id": "nats-10",
      "verdict": "supported",
      "fact": "该快照的确认模式表确实将 AckExplicit 描述为 pull consumer 唯一支持的选项；但同文后续 pull 示例又使用 --ack none，存在内部不一致，不能据此形成无条件的产品支持范围结论。",
      "citations": [
        {"source": "nats", "start": 39, "end": 45},
        {"source": "nats", "start": 198, "end": 206}
      ]
    },
    {
      "id": "nats-11",
      "verdict": "supported",
      "fact": "在 AckAll 模式下，确认消息 100 也会确认消息 1 至 99。",
      "citations": [{"source": "nats", "start": 43, "end": 43}]
    },
    {
      "id": "nats-12",
      "verdict": "supported",
      "fact": "该快照明确将 AckFlowControl 标注为 2.14 特性。",
      "citations": [{"source": "nats", "start": 45, "end": 45}]
    },
    {
      "id": "nats-13",
      "verdict": "supported",
      "fact": "AckAck 表示确认消息已完成处理。",
      "citations": [{"source": "nats", "start": 175, "end": 175}]
    },
    {
      "id": "nats-14",
      "verdict": "supported",
      "fact": "AckNak 表示当前不处理该消息，处理可转向下一条；被 NAK 的消息将被重试。",
      "citations": [{"source": "nats", "start": 176, "end": 176}]
    },
    {
      "id": "nats-15",
      "verdict": "supported",
      "fact": "在 AckWait 到期前发送 AckProgress，表示工作仍在进行，并将等待期再延长一个 AckWait。",
      "citations": [{"source": "nats", "start": 177, "end": 177}]
    },
    {
      "id": "nats-16",
      "verdict": "refuted",
      "fact": "AckTerm 指示服务器停止重投该消息，但不确认消息已成功处理。",
      "citations": [{"source": "nats", "start": 179, "end": 179}]
    },
    {
      "id": "nats-17",
      "verdict": "refuted",
      "fact": "AckNext 是文中所列确认类型里不支持 double acknowledgement 的例外；其他所列类型可通过在确认时设置回复 subject，让服务器确认已收到 ACK。",
      "citations": [{"source": "nats", "start": 181, "end": 181}]
    },
    {
      "id": "nats-18",
      "verdict": "supported",
      "fact": "文档以消息去重与 double ack 的组合说明 JetStream 的 exactly-once 发布和消费语义。其中，AckSync() 收到服务器成功响应所确认的是 ACK 已被接收和处理，从而避免因该 ACK 丢失而重投。",
      "citations": [{"source": "nats", "start": 183, "end": 186}]
    },
    {
      "id": "nats-19",
      "verdict": "supported",
      "fact": "DeliverPolicy 决定消费起点，即如何选择第一条消息；开始消费后，继续投递尚未见到或尚未确认的消息，而不是不断重置起点。",
      "citations": [{"source": "nats", "start": 187, "end": 196}]
    },
    {
      "id": "nats-20",
      "verdict": "supported",
      "fact": "该快照说明 durable consumer 在断开连接后仍存在；其所述基于 delivery subject 订阅的 ephemeral consumer，在没有订阅者后经过短暂宽限期会被自动移除。",
      "citations": [{"source": "nats", "start": 247, "end": 249}]
    },
    {
      "id": "nats-21",
      "verdict": "supported",
      "fact": "消费者文档将 Core NATS 的至多一次投递保证，与 JetStream consumer 可提供的至少一次投递保证作了区分。",
      "citations": [{"source": "nats-consumers", "start": 4, "end": 4}]
    },
    {
      "id": "nats-22",
      "verdict": "supported",
      "fact": "Push consumer 向指定 subject 推送消息；pull consumer 允许客户端按需请求一批消息。",
      "citations": [{"source": "nats-consumers", "start": 8, "end": 10}]
    },
    {
      "id": "nats-23",
      "verdict": "supported",
      "fact": "该页推荐新项目采用 pull consumer，尤其是在关注扩展能力、细致流控或错误处理时；这是推荐而非强制要求。",
      "citations": [{"source": "nats-consumers", "start": 14, "end": 15}]
    },
    {
      "id": "nats-24",
      "verdict": "refuted",
      "fact": "Ordered consumer 总是 ephemeral，而不是 durable。",
      "citations": [{"source": "nats-consumers", "start": 16, "end": 19}]
    },
    {
      "id": "nats-25",
      "verdict": "supported",
      "fact": "Ordered consumer 不使用确认；检测到消息间隙时会重建 consumer。",
      "citations": [{"source": "nats-consumers", "start": 16, "end": 20}]
    },
    {
      "id": "nats-26",
      "verdict": "supported",
      "fact": "Ordered consumer 使用单线程分发，不提供负载均衡。",
      "citations": [{"source": "nats-consumers", "start": 16, "end": 23}]
    },
    {
      "id": "nats-27",
      "verdict": "refuted",
      "fact": "Name 与 Durable 是不同字段；只设置 Name 而不设置 Durable，会创建具名但仍被服务器视为 ephemeral 的消费者。创建 durable consumer 需要在 Durable 字段中显式设置名称。",
      "citations": [{"source": "nats-consumers", "start": 26, "end": 26}]
    },
    {
      "id": "nats-28",
      "verdict": "refuted",
      "fact": "设置 InactiveThreshold 不会使消费者变成 durable，它只控制不活跃消费者的自动清理。该阈值适用于 durable 和 ephemeral，但在 2.9 以前仅适用于 ephemeral。",
      "citations": [{"source": "nats-consumers", "start": 26, "end": 26}]
    },
    {
      "id": "nats-29",
      "verdict": "supported",
      "fact": "该页专门描述 ephemeral consumer 时，明确称其状态仅在服务器内存中，没有持久状态或容错；后文关于消费者可从故障恢复的一般性描述，不能无条件套用于这一明确例外。",
      "citations": [{"source": "nats-consumers", "start": 27, "end": 30}]
    },
    {
      "id": "nats-30",
      "verdict": "supported",
      "fact": "消费者默认继承所消费 stream 的复制因子；显式设置 InactiveThreshold 会控制不活跃消费者的自动清理。该阈值在 2.9 以前只适用于 ephemeral，且不能把一般性的闲置保留描述理解为 ephemeral 永不自动清理。",
      "citations": [
        {"source": "nats-consumers", "start": 26, "end": 30},
        {"source": "nats-consumers", "start": 52, "end": 52}
      ]
    },
    {
      "id": "nats-31",
      "verdict": "supported",
      "fact": "Durable 名称不能含空白、点、星号、大于号、正斜杠或反斜杠路径分隔符，以及不可打印字符。",
      "citations": [{"source": "nats-consumers", "start": 39, "end": 39}]
    },
    {
      "id": "nats-32",
      "verdict": "refuted",
      "fact": "FilterSubject 与 FilterSubjects 不能同时使用。",
      "citations": [{"source": "nats-consumers", "start": 40, "end": 40}]
    },
    {
      "id": "nats-33",
      "verdict": "supported",
      "fact": "AckWait 配置只在未配置 BackOff 时生效；配置 BackOff 后，它完全覆盖 AckWait，并由列表首值确定等待时间。",
      "citations": [
        {"source": "nats-consumers", "start": 42, "end": 42},
        {"source": "nats-consumers", "start": 50, "end": 50}
      ]
    },
    {
      "id": "nats-34",
      "verdict": "supported",
      "fact": "Description 自 2.3.3 引入，可在消费者创建后修改，可用于说明 ephemeral consumer 的用途。",
      "citations": [
        {"source": "nats-consumers", "start": 34, "end": 35},
        {"source": "nats-consumers", "start": 46, "end": 46}
      ]
    },
    {
      "id": "nats-35",
      "verdict": "supported",
      "fact": "在 2.9 以前，InactiveThreshold 仅适用于 ephemeral consumer；该页说明其现在也适用于 durable consumer。",
      "citations": [{"source": "nats-consumers", "start": 26, "end": 26}]
    },
    {
      "id": "nats-36",
      "verdict": "supported",
      "fact": "MaxAckPending 默认值为 1000，跨同一 consumer 的所有绑定订阅限制未确认消息总数；设为 -1 表示不限制待确认消息数量。",
      "citations": [{"source": "nats-consumers", "start": 48, "end": 48}]
    },
    {
      "id": "nats-37",
      "verdict": "refuted",
      "fact": "达到 MaxDeliver 最大投递次数的消息仍留在 stream 中，不会仅因达到该次数而自动删除。",
      "citations": [{"source": "nats-consumers", "start": 49, "end": 49}]
    },
    {
      "id": "nats-38",
      "verdict": "refuted",
      "fact": "BackOff 用于确认超时后的重投，不适用于普通 nak；普通 nak 会立即触发重投，除非使用 nakWithDelay 显式指定延迟。",
      "citations": [{"source": "nats-consumers", "start": 50, "end": 50}]
    },
    {
      "id": "nats-39",
      "verdict": "supported",
      "fact": "BackOff 序列长度不得超过 MaxDeliver；当 MaxDeliver 大于列表长度时，其余投递使用列表中的最后一个延迟。这些延迟针对确认超时重投，不适用于普通 nak。",
      "citations": [{"source": "nats-consumers", "start": 50, "end": 50}]
    },
    {
      "id": "nats-40",
      "verdict": "supported",
      "fact": "配置 BackOff 后，它完全覆盖 AckWait，列表中的第一个值确定 AckWait。",
      "citations": [{"source": "nats-consumers", "start": 50, "end": 50}]
    },
    {
      "id": "nats-41",
      "verdict": "supported",
      "fact": "ReplayOriginal 按消息原先被接收的节奏重放；默认的 ReplayInstant 尽可能快地投递，但仍遵守确认策略、MaxAckPending 以及客户端消费能力的约束。",
      "citations": [{"source": "nats-consumers", "start": 51, "end": 51}]
    },
    {
      "id": "nats-42",
      "verdict": "supported",
      "fact": "Replicas=0 表示继承 stream 的副本数；该配置自 2.8.3 引入，可在消费者创建后修改。",
      "citations": [
        {"source": "nats-consumers", "start": 34, "end": 35},
        {"source": "nats-consumers", "start": 52, "end": 52}
      ]
    },
    {
      "id": "nats-43",
      "verdict": "supported",
      "fact": "设置 MemoryStorage 会强制将 consumer 状态保存在内存中，而不是继承 stream 的存储类型。",
      "citations": [{"source": "nats-consumers", "start": 53, "end": 53}]
    },
    {
      "id": "nats-44",
      "verdict": "supported",
      "fact": "SampleFrequency 的值为字符串，\"30\" 与 \"30%\" 均为有效的 30% 确认采样配置。",
      "citations": [{"source": "nats-consumers", "start": 54, "end": 54}]
    },
    {
      "id": "nats-45",
      "verdict": "supported",
      "fact": "Consumer Metadata 是应用定义的键值对集合，自 2.10.0 引入，可在消费者创建后修改。",
      "citations": [
        {"source": "nats-consumers", "start": 34, "end": 35},
        {"source": "nats-consumers", "start": 55, "end": 55}
      ]
    },
    {
      "id": "nats-46",
      "verdict": "supported",
      "fact": "HeadersOnly 只投递消息头，并添加 Nats-Msg-Size 消息头表示被移除的 payload 大小。",
      "citations": [{"source": "nats-consumers", "start": 57, "end": 57}]
    },
    {
      "id": "nats-47",
      "verdict": "refuted",
      "fact": "服务器可能接受超过确认时间窗才到达的 ACK。文档举例说明，在队列场景中，即使消息因首个进程未及时确认而已重投给另一消费者，首个进程随后发来的确认仍会被考虑。",
      "citations": [{"source": "nats-consumers", "start": 66, "end": 67}]
    },
    {
      "id": "nats-48",
      "verdict": "supported",
      "fact": "DeliverLastPerSubject 从 stream 中每个过滤 subject 当前最新的一条消息开始投递。",
      "citations": [{"source": "nats-consumers", "start": 72, "end": 72}]
    },
    {
      "id": "nats-49",
      "verdict": "supported",
      "fact": "DeliverByStartTime 从指定时间及之后的消息开始，消费者必须设置 OptStartTime 来定义起始时间。",
      "citations": [{"source": "nats-consumers", "start": 75, "end": 75}]
    },
    {
      "id": "nats-50",
      "verdict": "supported",
      "fact": "MaxAckPending 的流控能力同时适用于 push 和 pull consumer。",
      "citations": [{"source": "nats-consumers", "start": 76, "end": 77}]
    },
    {
      "id": "nats-51",
      "verdict": "supported",
      "fact": "使用多个 FilterSubjects 时，文档给出的创建权限主题为 $JS.API.CONSUMER.DURABLE.CREATE.{stream}.{consumer}，其中不含 {filter} token；文档因此要求采用其他策略实现细粒度权限。",
      "citations": [{"source": "nats-consumers", "start": 82, "end": 83}]
    },
    {
      "id": "nats-52",
      "verdict": "supported",
      "fact": "MaxWaiting 限制等待中的 pull 请求数量，消费者创建后不可修改。",
      "citations": [
        {"source": "nats-consumers", "start": 34, "end": 35},
        {"source": "nats-consumers", "start": 84, "end": 88}
      ]
    },
    {
      "id": "nats-53",
      "verdict": "supported",
      "fact": "MaxRequestExpires 限制单个 pull 请求等待消息可供拉取的最长时间。",
      "citations": [{"source": "nats-consumers", "start": 89, "end": 89}]
    },
    {
      "id": "nats-54",
      "verdict": "supported",
      "fact": "同时设置 MaxRequestBatch 与 MaxRequestMaxBytes 时，批次受先触及的消息数量或总字节数限制约束。",
      "citations": [{"source": "nats-consumers", "start": 90, "end": 91}]
    },
    {
      "id": "nats-55",
      "verdict": "supported",
      "fact": "DeliverAll 是默认投递起点策略，从 stream 中最早可用的消息开始。",
      "citations": [{"source": "nats-consumers", "start": 68, "end": 70}]
    },
    {
      "id": "nats-56",
      "verdict": "supported",
      "fact": "DeliverSubject 的设置决定消费者采用 push 还是 pull 模式；设置投递 subject 后，服务器向订阅该 subject 的客户端推送消息。",
      "citations": [{"source": "nats-consumers", "start": 96, "end": 96}]
    },
    {
      "id": "nats-57",
      "verdict": "supported",
      "fact": "DeliverGroup 指定用于在订阅者之间分配消息的 queue group 名称。",
      "citations": [{"source": "nats-consumers", "start": 97, "end": 97}]
    },
    {
      "id": "nats-58",
      "verdict": "supported",
      "fact": "Push 专属配置表将 FlowControl 描述为每订阅的滑动窗口流控，与跨该 consumer 所有绑定订阅的 MaxAckPending 共同工作；这与前文称 MaxAckPending 是 push 唯一流控形式的表述存在不一致，不能据前文排除该配置。",
      "citations": [
        {"source": "nats-consumers", "start": 77, "end": 77},
        {"source": "nats-consumers", "start": 92, "end": 98}
      ]
    },
    {
      "id": "nats-59",
      "verdict": "supported",
      "fact": "设置 IdleHeartbeat 后，服务器在空闲期间定期发送状态消息，其状态码为 100，且没有 reply 地址。",
      "citations": [{"source": "nats-consumers", "start": 99, "end": 99}]
    },
    {
      "id": "nats-60",
      "verdict": "refuted",
      "fact": "RateLimit 的单位是每秒比特数，而不是每秒字节数。",
      "citations": [{"source": "nats-consumers", "start": 100, "end": 100}]
    }
  ]

          "source": "pulsar",
          "start": 86,
          "end": 88
        }
      ]
    },
    {
      "id": "pulsar-18",
      "verdict": "supported",
      "fact": "当应用需要可靠的重试上限时，文档建议使用 reconsumeLater 并设置 enableRetry(true)，因为重试计数会作为消息属性持久化。",

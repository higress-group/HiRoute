+from __future__ import annotations
+
+import codecs
+import email.message
+import json
+import typing
+
+from ._exceptions import DecodingError
+
+_WHITESPACE = " \t\r\n"
+
+
+def json_stream_settings(content_type: str) -> tuple[str, str | None]:
+    message = email.message.Message()
+    message["content-type"] = content_type
+    media_type = message.get_content_type()
+    if media_type in ("application/ndjson", "application/x-ndjson"):
+        mode = "ndjson"
+    elif media_type == "application/json-seq":
+        mode = "json-seq"
+    elif media_type == "application/json" or (
+        media_type.startswith("application/")
+        and media_type.endswith("+json")
+        and len(media_type) > len("application/+json")
+    ):
+        mode = "json"
+    else:
+        raise DecodingError(f"Unsupported JSON media type: {media_type!r}")
+    encoding = message.get_content_charset()
+    if encoding is not None:
+        try:
+            codecs.lookup(encoding)
+        except LookupError as exc:
+            raise DecodingError(f"Unknown JSON charset: {encoding!r}") from exc
+    return mode, encoding
+
+
+def _detect_encoding(data: bytes, final: bool) -> str | None:
+    boms = (
+        codecs.BOM_UTF32_BE,
+        codecs.BOM_UTF32_LE,
+        codecs.BOM_UTF8,
+        codecs.BOM_UTF16_BE,
+        codecs.BOM_UTF16_LE,
+    )
+    if not final and len(data) < 4:
+        if len(data) < 2 or any(bom.startswith(data) for bom in boms):
+            return None
+        if data[0] == 0 or data[1] == 0:
+            return None
+    if data.startswith((codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+        return "utf-16"
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+    if len(data) >= 4:
+        if data[0] == 0:
+            return "utf-16-be" if data[1] else "utf-32-be"
+        if data[1] == 0:
+            return "utf-16-le" if data[2] or data[3] else "utf-32-le"
+    if len(data) >= 2:
+        if data[0] == 0:
+            return "utf-16-be"
+        if data[1] == 0:
+            return "utf-16-le"
+    return "utf-8"
+
+
+class JSONStreamDecoder:
+    """Incrementally decode JSON documents, lines, and text sequences."""
+
+    def __init__(self, mode: str, encoding: str | None) -> None:
+        self.mode = mode
+        self.encoding = encoding
+        self.decoder: codecs.IncrementalDecoder | None = None
+        self.prefix = b""
+        self.buffer: list[str] = []
+        self.state = "prelude"
+        self.seen_bom = False
+        self.seen_line = False
+        self.depth = 0
+        self.in_string = False
+        self.escaped = False
+
+    def _text(self, data: bytes, final: bool) -> str:
+        try:
+            if self.decoder is None:
+                self.prefix += data
+                encoding = self.encoding or _detect_encoding(self.prefix, final)
+                if encoding is None:
+                    return ""
+                if (
+                    self.mode != "json-seq"
+                    and codecs.lookup(encoding).name == "utf-8-sig"
+                ):
+                    encoding = "utf-8"
+                self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+                data, self.prefix = self.prefix, b""
+            text = self.decoder.decode(data, final=final)
+            if not isinstance(text, str):
+                raise DecodingError("JSON charset must decode bytes to text")
+            return text
+        except (UnicodeError, LookupError, ValueError) as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _value(self) -> typing.Any:
+        text = "".join(self.buffer).strip(_WHITESPACE)
+        self.buffer.clear()
+        try:
+            return json.loads(text)
+        except ValueError as exc:
+            raise DecodingError(str(exc)) from exc
+
+    def _line(self) -> typing.Iterator[typing.Any]:
+        text = "".join(self.buffer).strip(_WHITESPACE)
+        self.buffer.clear()
+        if not text:
+            return
+        if not self.seen_line and text.startswith("\ufeff"):
+            text = text[1:]
+        self.seen_line = True
+        self.buffer.append(text)
+        yield self._value()
+
+    def _record(self, final: bool) -> typing.Iterator[typing.Any]:
+        text = "".join(self.buffer)
+        self.buffer.clear()
+        if text.endswith("\n"):
+            text = text[:-1]
+        if not final and not text.strip(_WHITESPACE):
+            return
+        self.buffer.append(text)
+        yield self._value()
+
+    def decode(self, data: bytes, final: bool = False) -> typing.Iterator[typing.Any]:
+        text = self._text(data, final)
+        for char in text:
+            if self.mode == "ndjson":
+                if char in "\r\n":
+                    yield from self._line()
+                else:
+                    self.buffer.append(char)
+                continue
+            if self.mode == "json-seq":
+                if self.state == "prelude":
+                    if char in _WHITESPACE:
+                        continue
+                    if char != "\x1e":
+                        raise DecodingError("JSON sequence must start with RS")
+                    self.state = "record"
+                elif char == "\x1e":
+                    yield from self._record(final=False)
+                else:
+                    self.buffer.append(char)
+                continue
+            yield from self._document(char)
+        if final:
+            if self.mode == "ndjson":
+                yield from self._line()
+            elif self.mode == "json-seq":
+                if self.state == "record":
+                    yield from self._record(final=True)
+            elif self.state == "text":
+                yield self._value()
+            elif self.state != "array_end":
+                raise DecodingError("Incomplete JSON document")
+
+    def _document(self, char: str) -> typing.Iterator[typing.Any]:
+        if self.state == "prelude":
+            if char in _WHITESPACE:
+                return
+            if char == "\ufeff" and not self.seen_bom:
+                self.seen_bom = True
+                return
+            self.state = "array_start" if char == "[" else "text"
+            if self.state == "array_start":
+                return
+        if self.state == "text":
+            self.buffer.append(char)
+            return
+        if self.state == "array_end":
+            if char not in _WHITESPACE:
+                raise DecodingError("Trailing data after JSON array")
+            return
+        if self.state == "item_end":
+            if char in _WHITESPACE:
+                return
+            if char not in ",]":
+                raise DecodingError("Expected comma or closing JSON array bracket")
+            self.state = "array_item" if char == "," else "array_end"
+            return
+        if self.state in ("array_start", "array_item"):
+            if char in _WHITESPACE:
+                return
+            if char == "]" and self.state == "array_start":
+                self.state = "array_end"
+                return
+            self.state = "item"
+        if self.in_string:
+            self.buffer.append(char)
+            if self.escaped:
+                self.escaped = False
+            elif char == "\\":
+                self.escaped = True
+            elif char == '"':
+                self.in_string = False
+                if self.depth == 0:
+                    self.state = "item_end"
+                    yield self._value()
+        elif self.depth == 0 and char in _WHITESPACE:
+            self.state = "item_end"
+            yield self._value()
+        elif self.depth == 0 and char in ",]":
+            self.state = "array_item" if char == "," else "array_end"
+            yield self._value()
+        else:
+            self.buffer.append(char)
+            if char == '"':
+                self.in_string = True
+            elif char in "[{":
+                self.depth += 1
+            elif char in "]}":
+                self.depth -= 1
+                if self.depth == 0:
+                    self.state = "item_end"
+                    yield self._value()

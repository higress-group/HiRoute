+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestHiRouteExecutionHeaderIncludesFailuresAndRejectsUpstreamSpoof(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, status := range []int{200, 401, 404, 503} {
+		recorder := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(recorder)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+		ctx := withHiRouteExecution(context.Background(), c)
+		coreexecutor.HiRouteInferenceStarted(ctx)
+		coreexecutor.HiRouteInferenceResponse(ctx, status)
+		coreexecutor.HiRouteInferenceResult(ctx, 1, status, nil)
+		c.Writer.Header().Set(coreexecutor.HiRouteExecutionHeader, "untrusted-provider-text")
+		if status == 200 {
+			c.Writer.WriteHeader(status)
+			_, _ = c.Writer.Write([]byte("{}"))
+		} else {
+			NewBaseAPIHandlers(nil, nil).WriteErrorResponse(c, &interfaces.ErrorMessage{
+				StatusCode: status, Error: errors.New("fixture error"),
+			})
+		}
+		unauthorized := 0
+		if status == 401 {
+			unauthorized = 1
+		}
+		expected := fmt.Sprintf("v2;1;%d;0;0;%d;1,%d,headers,none;1,%d,headers,none", unauthorized, status, status, status)
+		if got := recorder.Result().Header.Get(coreexecutor.HiRouteExecutionHeader); got != expected {
+			t.Fatalf("status=%d trace=%q, want %q", status, got, expected)
+		}
+		if got := FilterUpstreamHeaders(http.Header{coreexecutor.HiRouteExecutionHeader: {"v1;32;0;0;0"}}); len(got) != 0 {
+			t.Fatalf("reserved header passed upstream filter: %v", got)
+		}
+	}
+}
+
+func TestHiRouteExecutionHeaderFreezesAtStreamCommit(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+	ctx := withHiRouteExecution(context.Background(), c)
+	coreexecutor.HiRouteInferenceStarted(ctx)
+	coreexecutor.HiRouteInferenceResponse(ctx, 401)
+	coreexecutor.HiRouteInferenceResult(ctx, 1, 401, nil)
+	coreexecutor.HiRouteAuthRecovery(ctx, false)
+	coreexecutor.HiRouteAuthRecovery(ctx, true)
+	coreexecutor.HiRouteInferenceStarted(ctx)
+	coreexecutor.HiRouteInferenceResult(ctx, 2, 200, nil)
+	_, _ = c.Writer.WriteString("data: {}\n\n")
+	c.Writer.Flush()
+	coreexecutor.HiRouteInferenceResult(ctx, 2, 200, context.Canceled)
+	coreexecutor.HiRouteInferenceStarted(ctx)
+	_, _ = c.Writer.WriteString("data: [DONE]\n\n")
+	if got := recorder.Result().Header.Get(coreexecutor.HiRouteExecutionHeader); got != "v2;2;1;1;1;200;1,401,headers,none;2,200,headers,none" {
+		t.Fatalf("stream commit trace=%q", got)
+	}
+}

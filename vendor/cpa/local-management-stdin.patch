diff --git a/sdk/api/handlers/hiroute_execution.go b/sdk/api/handlers/hiroute_execution.go
new file mode 100644
index 0000000..15168d3
--- /dev/null
+++ b/sdk/api/handlers/hiroute_execution.go
@@ -0,0 +1,53 @@
+package handlers
+
+import (
+	"context"
+	"github.com/gin-gonic/gin"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// Snapshot immediately before the first downstream commit, including error
+// replies. Upstream/plugin headers cannot forge this reserved value. All stock
+// auth recovery finishes before a stream becomes visible to the downstream.
+func withHiRouteExecution(ctx context.Context, c *gin.Context) context.Context {
+	if c == nil || c.Writer == nil {
+		return ctx
+	}
+	if writer, ok := c.Writer.(*hiRouteExecutionWriter); ok {
+		return writer.trace.Context(ctx)
+	}
+	tracked, trace := coreexecutor.WithHiRouteExecution(ctx)
+	c.Writer = &hiRouteExecutionWriter{ResponseWriter: c.Writer, trace: trace}
+	return tracked
+}
+
+type hiRouteExecutionWriter struct {
+	gin.ResponseWriter
+	trace *coreexecutor.HiRouteExecution
+}
+
+func (w *hiRouteExecutionWriter) snapshot() {
+	if !w.Written() {
+		w.Header().Set(coreexecutor.HiRouteExecutionHeader, w.trace.Header())
+	}
+}
+func (w *hiRouteExecutionWriter) WriteHeader(code int) {
+	w.snapshot()
+	w.ResponseWriter.WriteHeader(code)
+}
+func (w *hiRouteExecutionWriter) WriteHeaderNow() {
+	w.snapshot()
+	w.ResponseWriter.WriteHeaderNow()
+}
+func (w *hiRouteExecutionWriter) Write(data []byte) (int, error) {
+	w.snapshot()
+	return w.ResponseWriter.Write(data)
+}
+func (w *hiRouteExecutionWriter) WriteString(data string) (int, error) {
+	w.snapshot()
+	return w.ResponseWriter.WriteString(data)
+}
+func (w *hiRouteExecutionWriter) Flush() {
+	w.snapshot()
+	w.ResponseWriter.Flush()
+}

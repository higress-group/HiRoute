diff --git a/internal/api/handlers/management/hiroute_oauth_callback.go b/internal/api/handlers/management/hiroute_oauth_callback.go
new file mode 100644
index 0000000..7aac5b4
--- /dev/null
+++ b/internal/api/handlers/management/hiroute_oauth_callback.go
@@ -0,0 +1,107 @@
+package management
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"syscall"
+
+	"github.com/gin-gonic/gin"
+)
+
+// The registered localhost redirect can resolve to either family. Never fall
+// back to another interface or retain half a listener when the other is occupied.
+func listenHiRouteCallbackLoopback(port int) ([]net.Listener, error) {
+	var listeners []net.Listener
+	for _, address := range []struct{ network, host string }{{"tcp4", "127.0.0.1"}, {"tcp6", "::1"}} {
+		listener, err := net.Listen(address.network, net.JoinHostPort(address.host, strconv.Itoa(port)))
+		if err != nil {
+			if errors.Is(err, syscall.EAFNOSUPPORT) || errors.Is(err, syscall.EPROTONOSUPPORT) || errors.Is(err, syscall.EADDRNOTAVAIL) {
+				continue
+			}
+			for _, opened := range listeners {
+				_ = opened.Close()
+			}
+			return nil, fmt.Errorf("callback loopback unavailable: %w", err)
+		}
+		listeners = append(listeners, listener)
+	}
+	if len(listeners) == 0 {
+		return nil, errors.New("callback loopback unavailable")
+	}
+	return listeners, nil
+}
+
+func startHiRouteCallbackReceiver(port int, provider, state, authDir string) (*callbackForwarder, error) {
+	return startCallbackServer(port, provider, hiRouteCallbackHandler(port, provider, state, authDir))
+}
+
+func hiRouteCallbackHandler(port int, provider, state, authDir string) http.Handler {
+	path := "/auth/callback"
+	if provider == "anthropic" {
+		path = "/callback"
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		w.Header().Set("Referrer-Policy", "no-referrer")
+		w.Header().Set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")
+		w.Header().Set("X-Content-Type-Options", "nosniff")
+		host, requestPort, err := net.SplitHostPort(r.Host)
+		if err != nil || requestPort != strconv.Itoa(port) || (host != "localhost" && host != "127.0.0.1" && host != "::1") {
+			http.Error(w, "Invalid callback address.", http.StatusBadRequest)
+			return
+		}
+		if r.Method != http.MethodGet || r.URL.Path != path || r.URL.RawPath != "" || len(r.RequestURI) > 16384 {
+			http.Error(w, "Invalid callback request.", http.StatusBadRequest)
+			return
+		}
+		receiveHiRouteBrowserCallback(w, r, provider, state, authDir)
+	})
+}
+
+// The main-server callback paths share the same checked reception and never
+// claim login success just because a browser reached the endpoint.
+func HiRouteBrowserOAuthCallback(authDir, provider string) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		c.Header("Cache-Control", "no-store")
+		c.Header("Referrer-Policy", "no-referrer")
+		c.Header("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")
+		c.Header("X-Content-Type-Options", "nosniff")
+		receiveHiRouteBrowserCallback(c.Writer, c.Request, provider, "", authDir)
+	}
+}
+
+func receiveHiRouteBrowserCallback(w http.ResponseWriter, r *http.Request, provider, expectedState, authDir string) {
+	if len(r.RequestURI) > 16384 {
+		http.Error(w, "Invalid callback request.", http.StatusBadRequest)
+		return
+	}
+	query, err := url.ParseQuery(r.URL.RawQuery)
+	if err != nil || len(query["state"]) != 1 || query.Get("state") == "" || (expectedState != "" && query.Get("state") != expectedState) || len(query["code"]) > 1 || len(query["error"]) > 1 {
+		http.Error(w, "Invalid callback. Return to HiRoute to continue signing in.", http.StatusBadRequest)
+		return
+	}
+	code, oauthError := query.Get("code"), query.Get("error")
+	if (code == "") == (oauthError == "") || strings.ContainsAny(code+oauthError, "\r\n\x00") {
+		http.Error(w, "Invalid callback. Return to HiRoute to continue signing in.", http.StatusBadRequest)
+		return
+	}
+	if _, err := WriteOAuthCallbackFileForPendingSession(authDir, provider, query.Get("state"), code, oauthError); err != nil {
+		status := http.StatusInternalServerError
+		if errors.Is(err, errOAuthSessionNotPending) {
+			status = http.StatusConflict
+		}
+		http.Error(w, "Callback was not accepted. Return to HiRoute to check the sign-in status.", status)
+		return
+	}
+	w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+	if oauthError != "" {
+		_, _ = w.Write([]byte("Authorization was not completed. Return to HiRoute to try again.\n授权未完成，请返回 HiRoute 重试。"))
+		return
+	}
+	_, _ = w.Write([]byte("Authorization received. Return to HiRoute to check whether sign-in has completed.\n已收到授权，请返回 HiRoute 查看登录结果。"))
+}

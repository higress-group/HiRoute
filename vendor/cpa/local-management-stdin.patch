diff --git a/sdk/proxyutil/environment.go b/sdk/proxyutil/environment.go
new file mode 100644
index 0000000..46f700b
--- /dev/null
+++ b/sdk/proxyutil/environment.go
@@ -0,0 +1,52 @@
+package proxyutil
+
+import (
+	"errors"
+	"net/http"
+	"net/url"
+
+	"golang.org/x/net/http/httpproxy"
+)
+
+// EnvironmentProxyFunc captures the standard HTTP(S)_PROXY/NO_PROXY settings,
+// but rejects a malformed effective proxy instead of silently dialing directly.
+// Uppercase nonempty values win, host[:port] shorthand remains valid, and only
+// the request's scheme is validated. Invalid configuration fails even when a
+// NO_PROXY rule would otherwise bypass it; explicit direct mode does not call us.
+func EnvironmentProxyFunc() func(*http.Request) (*url.URL, error) {
+	cfg := httpproxy.FromEnvironment()
+	httpError := validateEnvironmentProxy(cfg.HTTPProxy)
+	httpsError := validateEnvironmentProxy(cfg.HTTPSProxy)
+	selectProxy := cfg.ProxyFunc()
+	return func(request *http.Request) (*url.URL, error) {
+		if request == nil || request.URL == nil {
+			return nil, errors.New("invalid environment proxy request")
+		}
+		switch request.URL.Scheme {
+		case "http":
+			if httpError != nil {
+				return nil, httpError
+			}
+		case "https":
+			if httpsError != nil {
+				return nil, httpsError
+			}
+		}
+		return selectProxy(request.URL)
+	}
+}
+
+func validateEnvironmentProxy(raw string) error {
+	if raw == "" {
+		return nil
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil || parsed.Scheme == "" || parsed.Host == "" {
+		// Match Go's documented environment-only host[:port] shorthand.
+		parsed, err = url.Parse("http://" + raw)
+	}
+	if err != nil || !ValidRequestProxy(parsed.String()) {
+		return errors.New("invalid environment proxy configuration")
+	}
+	return nil
+}

diff --git a/internal/modeldiscovery/diagnostics.go b/internal/modeldiscovery/diagnostics.go
new file mode 100644
index 0000000..c444f23
--- /dev/null
+++ b/internal/modeldiscovery/diagnostics.go
@@ -0,0 +1,285 @@
+// Package modeldiscovery retains bounded, secret-free observations for the
+// existing authenticated management response. It never logs raw errors or I/O.
+package modeldiscovery
+
+import (
+	"context"
+	"crypto/x509"
+	"errors"
+	"net"
+	"os"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+)
+
+const capacity = 128
+
+type Phase string
+type Outcome string
+type Reason string
+
+const (
+	Credentials              Phase   = "credentials"
+	ClientVersion            Phase   = "client_version"
+	Request                  Phase   = "request"
+	Response                 Phase   = "response"
+	Catalog                  Phase   = "catalog"
+	Registration             Phase   = "registration"
+	Entered                  Outcome = "entered"
+	Completed                Outcome = "completed"
+	Failed                   Outcome = "failed"
+	Discarded                Outcome = "discarded"
+	NoReason                 Reason  = ""
+	MissingAccessToken       Reason  = "missing_access_token"
+	ClientVersionUnavailable Reason  = "client_version_unavailable"
+	Cancelled                Reason  = "cancelled"
+	Timeout                  Reason  = "timeout"
+	DNSFailure               Reason  = "dns_failure"
+	ConnectFailure           Reason  = "connect_failure"
+	ProxyFailure             Reason  = "proxy_failure"
+	ProxyRejected            Reason  = "proxy_rejected"
+	TLSFailure               Reason  = "tls_failure"
+	TransportFailure         Reason  = "transport_failure"
+	HTTPRejected             Reason  = "http_rejected"
+	BodyReadFailure          Reason  = "body_read_failure"
+	ResponseTooLarge         Reason  = "response_too_large"
+	InvalidCatalog           Reason  = "invalid_catalog"
+	InvalidModelID           Reason  = "invalid_model_id"
+	DuplicateModelID         Reason  = "duplicate_model_id"
+	EmptyCatalog             Reason  = "empty_catalog"
+	EmptyAfterFiltering      Reason  = "empty_after_filtering"
+	AccountMissing           Reason  = "account_missing"
+	AccountDisabled          Reason  = "account_disabled"
+	AccountChanged           Reason  = "account_changed"
+)
+
+type PhaseTiming struct {
+	Phase      Phase   `json:"phase"`
+	Outcome    Outcome `json:"outcome"`
+	ElapsedMS  uint64  `json:"elapsed_ms"`
+	Reason     Reason  `json:"reason,omitempty"`
+	ModelCount *uint64 `json:"model_count,omitempty"`
+}
+
+type Attempt struct {
+	ID                       uint64        `json:"attempt_id"`
+	Phase                    Phase         `json:"phase"`
+	Outcome                  Outcome       `json:"outcome"`
+	Reason                   Reason        `json:"reason,omitempty"`
+	ElapsedMS                uint64        `json:"elapsed_ms"`
+	PhaseElapsedMS           uint64        `json:"phase_elapsed_ms"`
+	HTTPStatus               *int          `json:"http_status,omitempty"`
+	ProxyStatus              *int          `json:"proxy_status,omitempty"`
+	ModelCount               *uint64       `json:"model_count,omitempty"`
+	GenerationMatches        *bool         `json:"generation_matches,omitempty"`
+	RegistrationEpochMatches *bool         `json:"registration_epoch_matches,omitempty"`
+	Timings                  []PhaseTiming `json:"timings"`
+}
+
+type Snapshot struct {
+	Schema              string   `json:"schema"`
+	ProcessID           int      `json:"process_id"`
+	EvictedAccounts     uint64   `json:"evicted_accounts"`
+	FirstFailure        *Attempt `json:"first_failure"`
+	Latest              *Attempt `json:"latest"`
+	RegistrationPending bool     `json:"registration_pending"`
+	revision            uint64
+}
+
+type entry struct {
+	first   *Attempt
+	latest  Attempt
+	updated time.Time
+}
+
+var store = struct {
+	sync.Mutex
+	entries  map[string]*entry
+	evicted  uint64
+	active   map[string]uint64
+	revision uint64
+}{entries: make(map[string]*entry), active: make(map[string]uint64)}
+var nextID atomic.Uint64
+
+type contextKey struct{}
+
+// Trace belongs to one synchronous discovery/registration attempt, not a goroutine
+// shared by independent registrations. Only immutable copies enter the store.
+type Trace struct {
+	account      string
+	started      time.Time
+	phaseStarted time.Time
+	value        Attempt
+}
+
+func Begin(account string) *Trace {
+	return &Trace{account: account, started: time.Now(), value: Attempt{ID: nextID.Add(1), Timings: []PhaseTiming{}}}
+}
+
+func WithTrace(ctx context.Context, trace *Trace) context.Context {
+	return context.WithValue(ctx, contextKey{}, trace)
+}
+
+func FromContext(ctx context.Context) *Trace {
+	trace, _ := ctx.Value(contextKey{}).(*Trace)
+	return trace
+}
+
+func (t *Trace) Enter(phase Phase) {
+	t.phaseStarted = time.Now()
+	t.value.Phase, t.value.Outcome, t.value.Reason = phase, Entered, NoReason
+	t.value.ElapsedMS, t.value.PhaseElapsedMS = millis(time.Since(t.started)), 0
+	t.publish()
+}
+
+func (t *Trace) End(outcome Outcome, reason Reason) {
+	t.value.Outcome, t.value.Reason = outcome, reason
+	t.value.ElapsedMS, t.value.PhaseElapsedMS = millis(time.Since(t.started)), millis(time.Since(t.phaseStarted))
+	if len(t.value.Timings) < 6 {
+		t.value.Timings = append(t.value.Timings, PhaseTiming{t.value.Phase, outcome, t.value.PhaseElapsedMS, reason, t.value.ModelCount})
+	}
+	t.publish()
+}
+
+func (t *Trace) HTTP(status int)  { t.value.HTTPStatus = &status }
+func (t *Trace) Models(count int) { value := uint64(count); t.value.ModelCount = &value }
+
+func (t *Trace) RegistrationChecks(generation, epoch bool) {
+	t.value.GenerationMatches, t.value.RegistrationEpochMatches = &generation, &epoch
+}
+
+// Transport retains only closed categories. URLs, hostnames, proxy credentials
+// and arbitrary error strings are never copied into an observation.
+func (t *Trace) Transport(err error) {
+	var proxyError *proxyutil.ConnectStatusError
+	if errors.As(err, &proxyError) {
+		status := proxyError.StatusCode
+		t.value.ProxyStatus = &status
+		t.End(Failed, ProxyRejected)
+		return
+	}
+	reason := TransportFailure
+	var dns *net.DNSError
+	var network *net.OpError
+	var timeout net.Error
+	var unknownCA x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalidCertificate x509.CertificateInvalidError
+	switch {
+	case errors.Is(err, context.Canceled):
+		reason = Cancelled
+	case errors.Is(err, context.DeadlineExceeded):
+		reason = Timeout
+	case errors.As(err, &timeout) && timeout.Timeout():
+		reason = Timeout
+	case errors.As(err, &dns):
+		reason = DNSFailure
+	case errors.As(err, &unknownCA), errors.As(err, &hostname), errors.As(err, &invalidCertificate):
+		reason = TLSFailure
+	case errors.As(err, &network) && network.Op == "dial":
+		reason = ConnectFailure
+	}
+	// The pinned transports own these fixed wrappers. Inspecting them refines a
+	// category without retaining the nested message or guessing an upstream status.
+	if reason == TransportFailure || reason == ConnectFailure {
+		for cause := err; cause != nil; cause = errors.Unwrap(cause) {
+			message := cause.Error()
+			switch {
+			case strings.HasPrefix(message, "utls: TLS handshake:"), strings.HasPrefix(message, "HTTPS proxy TLS handshake failed:"):
+				reason = TLSFailure
+			case strings.HasPrefix(message, "dial HTTP proxy failed:"), strings.HasPrefix(message, "write CONNECT request failed:"), strings.HasPrefix(message, "read CONNECT response failed:"):
+				reason = ProxyFailure
+			}
+		}
+	}
+	t.End(Failed, reason)
+}
+
+func (t *Trace) publish() {
+	if t.account == "" || len(t.account) > 4096 {
+		return
+	}
+	store.Lock()
+	defer store.Unlock()
+	store.revision++
+	current := store.entries[t.account]
+	if current == nil {
+		if len(store.entries) == capacity {
+			var oldest string
+			var id uint64 = ^uint64(0)
+			for key, value := range store.entries {
+				if value.latest.ID < id {
+					oldest, id = key, value.latest.ID
+				}
+			}
+			delete(store.entries, oldest)
+			store.evicted++
+		}
+		current = &entry{}
+		store.entries[t.account] = current
+	}
+	if current.first == nil && (t.value.Outcome == Failed || t.value.Outcome == Discarded) {
+		copy := clone(t.value)
+		current.first = &copy
+	}
+	if t.value.ID >= current.latest.ID {
+		current.latest, current.updated = clone(t.value), time.Now()
+	}
+}
+
+func Read(account string) Snapshot {
+	store.Lock()
+	defer store.Unlock()
+	result := Snapshot{Schema: "hiroute.cpa-model-discovery/v1", ProcessID: os.Getpid(), EvictedAccounts: store.evicted,
+		RegistrationPending: store.active[account] != 0, revision: store.revision}
+	if current := store.entries[account]; current != nil {
+		latest := clone(current.latest)
+		if latest.Outcome == Entered {
+			delta := millis(time.Since(current.updated))
+			latest.ElapsedMS += delta
+			latest.PhaseElapsedMS += delta
+		}
+		result.Latest = &latest
+		if current.first != nil {
+			first := clone(*current.first)
+			result.FirstFailure = &first
+		}
+	}
+	return result
+}
+
+func clone(value Attempt) Attempt {
+	if value.GenerationMatches != nil {
+		copy := *value.GenerationMatches
+		value.GenerationMatches = &copy
+	}
+	if value.RegistrationEpochMatches != nil {
+		copy := *value.RegistrationEpochMatches
+		value.RegistrationEpochMatches = &copy
+	}
+	if value.HTTPStatus != nil {
+		copy := *value.HTTPStatus
+		value.HTTPStatus = &copy
+	}
+	if value.ProxyStatus != nil {
+		copy := *value.ProxyStatus
+		value.ProxyStatus = &copy
+	}
+	if value.ModelCount != nil {
+		copy := *value.ModelCount
+		value.ModelCount = &copy
+	}
+	value.Timings = append([]PhaseTiming{}, value.Timings...)
+	for index := range value.Timings {
+		if value.Timings[index].ModelCount != nil {
+			copy := *value.Timings[index].ModelCount
+			value.Timings[index].ModelCount = &copy
+		}
+	}
+	return value
+}
+func millis(value time.Duration) uint64 { return uint64(value.Milliseconds()) }

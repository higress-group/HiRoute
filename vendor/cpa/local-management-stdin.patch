+func TestHiRouteCallbackAdmissionIsAtomicAndFailedWritesCanRetry(t *testing.T) {
+	dir, state := t.TempDir(), "hiroute-concurrent-callback"
+	RegisterOAuthSession(state, "codex")
+	defer CancelOAuthSession(state)
+	badPath := filepath.Join(dir, "not-a-directory")
+	if err := os.WriteFile(badPath, []byte("fixture"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := WriteOAuthCallbackFileForPendingSession(badPath, "codex", state, "code", ""); err == nil {
+		t.Fatal("failed write was accepted")
+	}
+	var accepted atomic.Int32
+	var group sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			if _, err := WriteOAuthCallbackFileForPendingSession(dir, "codex", state, "code", ""); err == nil {
+				accepted.Add(1)
+			}
+		}()
+	}
+	group.Wait()
+	if accepted.Load() != 1 {
+		t.Fatalf("accepted %d callbacks", accepted.Load())
+	}
+	for _, stale := range []string{"unknown-state", "cancelled-state", "expired-state"} {
+		RegisterOAuthSession(stale, "codex")
+		if stale == "expired-state" {
+			oauthSessions.mu.Lock()
+			s := oauthSessions.sessions[stale]
+			s.ExpiresAt = time.Now().Add(-time.Second)
+			oauthSessions.sessions[stale] = s
+			oauthSessions.mu.Unlock()
+		} else {
+			CancelOAuthSession(stale)
+		}
+		if _, err := WriteOAuthCallbackFileForPendingSession(dir, "codex", stale, "late-code", ""); err == nil {
+			t.Fatal("stale callback accepted")
+		}
+	}
+}

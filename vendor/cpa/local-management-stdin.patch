diff --git a/sdk/cliproxy/executor/hiroute_inference.go b/sdk/cliproxy/executor/hiroute_inference.go
new file mode 100644
index 0000000..8f1d9de
--- /dev/null
+++ b/sdk/cliproxy/executor/hiroute_inference.go
@@ -0,0 +1,121 @@
+package executor
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+)
+
+// Fixed first/last observations, not a per-attempt ledger. Middle attempts keep
+// their count only. An ordinal never borrows status from another transport.
+type hiRouteInference struct {
+	ordinal uint32
+	status  int
+	phase   string
+	reason  string
+}
+
+func (a hiRouteInference) wire() string {
+	if a.ordinal == 0 {
+		return "-"
+	}
+	return fmt.Sprintf("%d,%d,%s,%s", a.ordinal, a.status, a.phase, a.reason)
+}
+
+func (t *HiRouteExecution) updateInference(ordinal uint32, apply func(*hiRouteInference)) {
+	if ordinal == 0 {
+		return
+	}
+	for _, a := range []*hiRouteInference{&t.firstInference, &t.lastInference} {
+		if a.ordinal == ordinal {
+			apply(a)
+		}
+	}
+}
+
+// These observations describe the wrapped RoundTrip, never request preparation.
+// A transport invocation is not proof of remote receipt or billable inference.
+func HiRouteInferenceResult(ctx context.Context, ordinal uint32, status int, err error) {
+	if trace := hiRouteExecutionFrom(ctx); trace != nil {
+		trace.mu.Lock()
+		defer trace.mu.Unlock()
+		trace.updateInference(ordinal, func(a *hiRouteInference) {
+			if status >= 100 && status <= 599 {
+				a.status = status
+				a.phase = "headers"
+			}
+			if err != nil {
+				a.phase = "transport"
+				a.reason = hiRouteErrorReason(err)
+			}
+		})
+	}
+}
+
+func hiRouteErrorReason(err error) string {
+	switch {
+	case errors.Is(err, context.Canceled):
+		return "cancelled"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "timeout"
+	case errors.Is(err, io.ErrUnexpectedEOF):
+		return "unexpected_eof"
+	case errors.Is(err, io.EOF):
+		return "eof"
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return "timeout"
+	}
+	var dns *net.DNSError
+	if errors.As(err, &dns) {
+		return "dns"
+	}
+	var verify *tls.CertificateVerificationError
+	var unknown x509.UnknownAuthorityError
+	var invalid x509.CertificateInvalidError
+	var hostname x509.HostnameError
+	if errors.As(err, &verify) || errors.As(err, &unknown) || errors.As(err, &invalid) || errors.As(err, &hostname) {
+		return "tls"
+	}
+	var op *net.OpError
+	if errors.As(err, &op) {
+		return "network"
+	}
+	return "other"
+}
+
+type hiRouteInferenceBody struct {
+	io.ReadCloser
+	trace   *HiRouteExecution
+	ordinal uint32
+}
+
+func HiRouteObserveInferenceBody(ctx context.Context, ordinal uint32, body io.ReadCloser) io.ReadCloser {
+	trace := hiRouteExecutionFrom(ctx)
+	if trace == nil || body == nil || ordinal == 0 {
+		return body
+	}
+	return &hiRouteInferenceBody{ReadCloser: body, trace: trace, ordinal: ordinal}
+}
+
+func (b *hiRouteInferenceBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	// Normal EOF is not proof of an application-level terminal event. The trace
+	// cannot diagnose missing completion or conversion from this transport alone.
+	if err != nil && err != io.EOF {
+		b.trace.mu.Lock()
+		b.trace.updateInference(b.ordinal, func(a *hiRouteInference) {
+			if a.reason == "none" {
+				a.phase = "body"
+				a.reason = hiRouteErrorReason(err)
+			}
+		})
+		b.trace.mu.Unlock()
+	}
+	return n, err
+}
diff --git a/sdk/cliproxy/executor/hiroute_inference_test.go b/sdk/cliproxy/executor/hiroute_inference_test.go
new file mode 100644
index 0000000..023c699
--- /dev/null
+++ b/sdk/cliproxy/executor/hiroute_inference_test.go
@@ -0,0 +1,48 @@
+package executor
+
+import (
+	"context"
+	"io"
+	"strings"
+	"testing"
+)
+
+type hiRouteFailingBody struct{ io.Reader }
+
+func (hiRouteFailingBody) Close() error             { return nil }
+func (hiRouteFailingBody) Read([]byte) (int, error) { return 0, io.ErrUnexpectedEOF }
+
+func TestHiRouteInferenceKeepsFirstAndLastAttemptIdentities(t *testing.T) {
+	ctx, trace := WithHiRouteExecution(context.Background())
+	first := HiRouteInferenceStarted(ctx)
+	HiRouteInferenceResult(ctx, first, 500, nil)
+	body := HiRouteObserveInferenceBody(ctx, first, hiRouteFailingBody{})
+	second := HiRouteInferenceStarted(ctx)
+	HiRouteInferenceResponse(ctx, 401)
+	HiRouteInferenceResult(ctx, second, 401, nil)
+	last := HiRouteInferenceStarted(ctx)
+	HiRouteInferenceResult(ctx, last, 200, nil)
+	// A late first-body error must not contaminate the latest successful response.
+	_, _ = body.Read(make([]byte, 1))
+	want := "v2;3;1;0;0;500;1,500,body,unexpected_eof;3,200,headers,none"
+	if got := trace.HeaderForStatus(500); got != want {
+		t.Fatalf("got=%q want=%q", got, want)
+	}
+}
+
+func TestHiRouteInferenceNormalEOFDoesNotAssertCompletion(t *testing.T) {
+	ctx, trace := WithHiRouteExecution(context.Background())
+	ordinal := HiRouteInferenceStarted(ctx)
+	HiRouteInferenceResult(ctx, ordinal, 200, nil)
+	body := HiRouteObserveInferenceBody(ctx, ordinal, io.NopCloser(strings.NewReader("")))
+	_, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A conversion or missing protocol terminal remains unobserved, even if CPA
+	// later returns 500. Do not relabel this as an actual upstream HTTP 500.
+	want := "v2;1;0;0;0;500;1,200,headers,none;1,200,headers,none"
+	if got := trace.HeaderForStatus(500); got != want {
+		t.Fatalf("got=%q want=%q", got, want)
+	}
+}

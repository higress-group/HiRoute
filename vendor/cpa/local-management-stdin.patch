+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// DiscoverModels uses the same account, proxy and TLS transport as Codex requests.
+// The remote list controls membership; bundled metadata only enriches matching IDs.
+func (e *CodexExecutor) DiscoverModels(ctx context.Context, auth *cliproxyauth.Auth, known []*registry.ModelInfo) ([]*registry.ModelInfo, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	token, _ := codexCreds(auth)
+	if strings.TrimSpace(token) == "" {
+		return nil, fmt.Errorf("codex model discovery: missing access token")
+	}
+	version, _ := auth.Metadata["hiroute_client_version"].(string)
+	version = strings.TrimSpace(version)
+	if version == "" || len(version) > 128 || strings.ContainsAny(version, "\r\n\x00") {
+		return nil, fmt.Errorf("codex model discovery: local client version unavailable")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://chatgpt.com/backend-api/codex/models?client_version="+url.QueryEscape(version), nil)
+	if err != nil {
+		return nil, err
+	}
+	applyCodexHeadersFromSources(req, auth, token, false, e.cfg, nil)
+	client := helps.NewUtlsHTTPClient(ctx, e.cfg, auth, 5*time.Second)
+	// Never forward subscription credentials to a redirect target.
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("codex model discovery: transport failed")
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("codex model discovery: HTTP %d", resp.StatusCode)
+	}
+	const limit = 16 << 20
+	body, err := io.ReadAll(io.LimitReader(resp.Body, limit+1))
+	if err != nil || len(body) > limit {
+		return nil, fmt.Errorf("codex model discovery: unreadable or oversized catalog")
+	}
+	var catalog struct {
+		Models []struct {
+			Slug             string   `json:"slug"`
+			DisplayName      string   `json:"display_name"`
+			Description      string   `json:"description"`
+			ContextWindow    int      `json:"context_window"`
+			MaxContextWindow int      `json:"max_context_window"`
+			InputModalities  []string `json:"input_modalities"`
+			Reasoning        []struct {
+				Effort string `json:"effort"`
+			} `json:"supported_reasoning_levels"`
+		} `json:"models"`
+	}
+	if json.Unmarshal(body, &catalog) != nil || catalog.Models == nil {
+		return nil, fmt.Errorf("codex model discovery: invalid catalog")
+	}
+	byID := make(map[string]*registry.ModelInfo, len(known))
+	for _, m := range known {
+		if m != nil {
+			byID[m.ID] = m
+		}
+	}
+	models := make([]*registry.ModelInfo, 0, len(catalog.Models))
+	seen := make(map[string]bool)
+	for _, remote := range catalog.Models {
+		id := strings.TrimSpace(remote.Slug)
+		if id == "" || seen[id] {
+			return nil, fmt.Errorf("codex model discovery: invalid or duplicate model ID")
+		}
+		seen[id] = true
+		m := registry.ModelInfo{ID: id, Object: "model", OwnedBy: "openai", Type: "codex"}
+		if base := byID[id]; base != nil {
+			m = *base
+		}
+		m.DisplayName, m.Description = remote.DisplayName, remote.Description
+		m.ContextLength, m.MaxContextLength = remote.ContextWindow, remote.MaxContextWindow
+		if m.ContextLength == 0 {
+			m.ContextLength = m.MaxContextLength
+		}
+		m.SupportedInputModalities = remote.InputModalities
+		m.Thinking = nil
+		if len(remote.Reasoning) > 0 {
+			m.Thinking = &registry.ThinkingSupport{}
+			for _, level := range remote.Reasoning {
+				if level.Effort != "" {
+					m.Thinking.Levels = append(m.Thinking.Levels, level.Effort)
+				}
+			}
+		}
+		models = append(models, &m)
+	}
+	return models, nil
+}

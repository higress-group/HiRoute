+}
diff --git a/internal/modeldiscovery/registration.go b/internal/modeldiscovery/registration.go
new file mode 100644
index 0000000..9b51136
--- /dev/null
+++ b/internal/modeldiscovery/registration.go
@@ -0,0 +1,39 @@
+package modeldiscovery
+
+import "sync"
+
+// Registering spans the whole registration, including the gap between a
+// discarded attempt and its bounded handoff. Entries live only while work runs;
+// evicting diagnostic history cannot erase an in-flight registration.
+func Registering(account string) func() {
+	if account == "" || len(account) > 4096 {
+		return func() {}
+	}
+	store.Lock()
+	store.active[account]++
+	store.revision++
+	store.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			store.Lock()
+			defer store.Unlock()
+			store.active[account]--
+			if store.active[account] == 0 {
+				delete(store.active, account)
+			}
+			store.revision++
+		})
+	}
+}
+
+// ReadCatalog brackets a local catalog read without holding the diagnostics
+// mutex across registry work. A transition during the read is pending for this
+// response, so mixed snapshots cannot turn an empty read into a terminal result.
+func ReadCatalog(account string, read func()) Snapshot {
+	before := Read(account)
+	read()
+	after := Read(account)
+	after.RegistrationPending = before.RegistrationPending || after.RegistrationPending || before.revision != after.revision
+	return after
+}
diff --git a/internal/modeldiscovery/registration_test.go b/internal/modeldiscovery/registration_test.go

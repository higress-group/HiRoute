+package helps
+
+import (
+	"context"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+func TestHiRouteExecutionCountsActualHTTPAndExcludesOAuth(t *testing.T) {
+	var sends atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := sends.Add(1)
+		if r.URL.Path == "/oauth/token" {
+			w.WriteHeader(200)
+			return
+		}
+		if n == 1 {
+			w.WriteHeader(401)
+			return
+		}
+		w.WriteHeader(200)
+	}))
+	defer server.Close()
+	ctx, trace := coreexecutor.WithHiRouteExecution(context.Background())
+	reporter := NewUsageReporter(ctx, "codex", "fixture-model", nil)
+	client := reporter.TrackHTTPClient(server.Client())
+	for _, path := range []string{"/responses", "/oauth/token", "/responses"} {
+		// Auth manager replaces its per-executor tracker, but retains the trace.
+		child := coreexecutor.WithUpstreamAttemptTracker(ctx)
+		req, err := http.NewRequestWithContext(child, http.MethodPost, server.URL+path, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		coreexecutor.MarkUpstreamAttempt(child) // Claude's outer send marker.
+		selected := client
+		if path == "/oauth/token" {
+			selected = server.Client()
+		}
+		resp, err := selected.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}
+	if sends.Load() != 3 || trace.Header() != "v1;2;1;0;0" {
+		t.Fatalf("actual HTTP=%d trace=%q", sends.Load(), trace.Header())
+	}
+}

+package modeldiscovery
+
+import (
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+)
+
+func TestHiRouteRegistrationHandoffRemainsPendingBetweenAttempts(t *testing.T) {
+	const account = "handoff-gap"
+	gap, resume, finished := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(finished)
+		done := Registering(account)
+		defer done()
+		first := Begin(account)
+		first.Enter(Registration)
+		first.End(Discarded, AccountChanged)
+		close(gap)
+		<-resume
+		second := Begin(account)
+		second.Enter(Registration)
+		second.Models(1)
+		second.End(Completed, NoReason)
+	}()
+	<-gap
+	snapshot := ReadCatalog(account, func() {})
+	close(resume)
+	<-finished
+	if !snapshot.RegistrationPending || snapshot.Latest == nil || snapshot.Latest.Outcome != Discarded {
+		t.Fatal("discarded first attempt hid the pending handoff")
+	}
+	settled := ReadCatalog(account, func() {})
+	if settled.RegistrationPending || settled.Latest == nil || settled.Latest.ModelCount == nil || *settled.Latest.ModelCount != 1 {
+		t.Fatal("completed registration did not become quiescent")
+	}
+}
+
+func TestHiRouteCatalogReadDetectsConcurrentRegistrationCompletion(t *testing.T) {
+	const account = "mixed-catalog-snapshot"
+	reg := registry.GetGlobalRegistry()
+	defer reg.UnregisterClient(account)
+	first := Begin(account)
+	first.Enter(Request)
+	first.End(Failed, Timeout)
+	read, resume := make(chan struct{}), make(chan struct{})
+	result := make(chan Snapshot, 1)
+	var models []*registry.ModelInfo
+	go func() {
+		result <- ReadCatalog(account, func() {
+			models = reg.GetModelsForClient(account)
+			close(read)
+			<-resume
+		})
+	}()
+	<-read
+	done := Registering(account)
+	second := Begin(account)
+	second.Enter(Registration)
+	reg.RegisterClient(account, "codex", []*registry.ModelInfo{{ID: "current-model", Object: "model", Type: "codex"}})
+	second.Models(1)
+	second.End(Completed, NoReason)
+	done()
+	close(resume)
+	snapshot := <-result
+	if len(models) != 0 || snapshot.Latest == nil || snapshot.Latest.ModelCount == nil || *snapshot.Latest.ModelCount != 1 || !snapshot.RegistrationPending {
+		t.Fatal("mixed empty/success response was presented as quiescent")
+	}
+	settled := ReadCatalog(account, func() { models = reg.GetModelsForClient(account) })
+	if len(models) != 1 || settled.RegistrationPending {
+		t.Fatal("next stable read did not recover")
+	}
+}
+
+func TestHiRouteRegistrationTrackingIsAccountScopedAndSurvivesHistoryEviction(t *testing.T) {
+	const account = "active-during-eviction"
+	first, second := Registering(account), Registering(account)
+	for index := 0; index < capacity+1; index++ {
+		trace := Begin(string(rune(index + 1000)))
+		trace.Enter(Request)
+	}
+	first()
+	first() // Registration task completion and batch cleanup may both finish it.
+	if !Read(account).RegistrationPending || Read("other-account").RegistrationPending {
+		t.Fatal("overlapping work or account scope lost")
+	}
+	second()
+	store.Lock()
+	_, retained := store.active[account]
+	store.Unlock()
+	if retained || Read(account).RegistrationPending {
+		t.Fatal("finished registration state leaked")
+	}
+}

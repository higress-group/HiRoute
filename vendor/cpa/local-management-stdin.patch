+)
+
+type discoveryRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f discoveryRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestCodexModelDiscoveryFailureBounds(t *testing.T) {
+	a := &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "secret", "hiroute_client_version": "0.999.0"}}
+	for _, tc := range []struct {
+		name     string
+		status   int
+		body     string
+		redirect bool
+	}{
+		{"redirect", 302, "", true},
+		{"oversized", 200, strings.Repeat("x", (16<<20)+1), false},
+		{"duplicate", 200, `{"models":[{"slug":"m"},{"slug":"m"}]}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryRoundTrip(func(r *http.Request) (*http.Response, error) {
+				calls++
+				h := make(http.Header)
+				if tc.redirect {
+					h.Set("Location", "https://example.com/stolen")
+				}
+				return &http.Response{StatusCode: tc.status, Header: h, Body: io.NopCloser(strings.NewReader(tc.body)), Request: r}, nil
+			}))
+			_, err := NewCodexExecutor(nil).DiscoverModels(ctx, a, nil)
+			if err == nil || calls != 1 || strings.Contains(err.Error(), "secret") {
+				t.Fatalf("unsafe failure handling: calls=%d err=%v", calls, err)
+			}
+		})
+	}
+}
+
+func TestCodexModelDiscoveryRequiresObservedVersion(t *testing.T) {
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryRoundTrip(func(r *http.Request) (*http.Response, error) {
+		t.Fatal("must not query with an invented version")
+		return nil, nil
+	}))
+	for _, refresh := range []any{nil, "", "  "} {
+		_, err := NewCodexExecutor(nil).DiscoverModels(ctx, &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "secret", "refresh_token": refresh}}, nil)
+		if err == nil || !strings.Contains(err.Error(), "local client version unavailable") {
+			t.Fatalf("missing version: %v", err)
+		}
+	}
+}
+
+func TestCodexModelDiscoveryManagedUsesExecutorVersion(t *testing.T) {
+	for _, observedVersion := range []any{nil, "0.999.0"} {
+		auth := &cliproxyauth.Auth{Provider: "codex", Metadata: map[string]any{
+			"access_token": "fixture-access", "refresh_token": "independent-refresh",
+			"account_id": "fixture-account", "hiroute_client_version": observedVersion,
+		}}
+		calls := 0
+		ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryRoundTrip(func(req *http.Request) (*http.Response, error) {
+			calls++
+			identity, _, _ := strings.Cut(req.Header.Get("User-Agent"), " ")
+			_, actualVersion, hasVersion := strings.Cut(identity, "/")
+			if !hasVersion || actualVersion == "" || req.URL.Query().Get("client_version") != actualVersion {
+				t.Fatal("managed discovery version differs from executor wire identity")
+			}
+			if req.URL.Query().Get("client_version") == "0.999.0" || req.Header.Get("Authorization") != "Bearer fixture-access" || req.Header.Get("ChatGPT-Account-ID") != "fixture-account" {
+				t.Fatal("managed discovery did not use its own credential and executor identity")
+			}
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"models":[{"slug":"remote-managed-model"}]}`)), Request: req}, nil
+		}))
+		models, err := NewCodexExecutor(nil).DiscoverModels(ctx, auth, nil)
+		if err != nil || calls != 1 || len(models) != 1 || models[0].ID != "remote-managed-model" {
+			t.Fatalf("independent login discovery failed: calls=%d models=%d err=%v", calls, len(models), err)
+		}
+	}
+}
diff --git a/internal/runtime/executor/helps/environment_proxy.go b/internal/runtime/executor/helps/environment_proxy.go
new file mode 100644
index 0000000..32f01f4
--- /dev/null
+++ b/internal/runtime/executor/helps/environment_proxy.go
@@ -0,0 +1,31 @@
+package helps
+
+import (
+	"errors"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+	"net/http"
+	"net/url"
+)
+
+// Preserve provider TLS fingerprints while applying the standard environment
+// proxy and NO_PROXY rules to the actual destination. Selection errors fail closed.
+type environmentProxyTransport struct {
+	direct http.RoundTripper
+	build  func(string) http.RoundTripper
+	proxy  func(*http.Request) (*url.URL, error)
+}
+
+func (t *environmentProxyTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	proxy, err := t.proxy(req)
+	if err != nil {
+		return nil, err
+	}
+	if proxy == nil {
+		return t.direct.RoundTrip(req)
+	}
+	// CPA's transport constructor otherwise falls back to direct on invalid input.
+	if !proxyutil.ValidRequestProxy(proxy.String()) {
+		return nil, errors.New("invalid environment proxy")
+	}
+	return t.build(proxy.String()).RoundTrip(req)
+}
diff --git a/internal/runtime/executor/helps/environment_proxy_test.go b/internal/runtime/executor/helps/environment_proxy_test.go
new file mode 100644
index 0000000..8b7ef41
--- /dev/null
+++ b/internal/runtime/executor/helps/environment_proxy_test.go
@@ -0,0 +1,147 @@
+package helps
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+type environmentTestRT func(*http.Request) (*http.Response, error)
+
+func (f environmentTestRT) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestEnvironmentProxySelection(t *testing.T) {
+	if os.Getenv("HIROUTE_PROXY_TEST_CHILD") == "1" {
+		c := NewUtlsHTTPClient(context.Background(), nil, nil, 0)
+		rt, ok := c.Transport.(*fallbackRoundTripper).chrome.(*environmentProxyTransport)
+		if !ok {
+			t.Fatal("protected transport ignores environment")
+		}
+		req, _ := http.NewRequest("GET", "https://chatgpt.com/backend-api/codex/models", nil)
+		p, err := rt.proxy(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := os.Getenv("HIROUTE_EXPECT_PROXY")
+		if want == "" {
+			if p != nil {
+				t.Fatal("NO_PROXY bypass lost")
+			}
+		} else if p == nil || p.String() != want {
+			t.Fatal("HTTPS proxy lost")
+		}
+		return
+	}
+	for _, bypass := range []bool{false, true} {
+		cmd := exec.Command(os.Args[0], "-test.run=^TestEnvironmentProxySelection$")
+		cmd.Env = []string{"HIROUTE_PROXY_TEST_CHILD=1", "HTTPS_PROXY=http://127.0.0.1:1187"}
+		if bypass {
+			cmd.Env = append(cmd.Env, "NO_PROXY=chatgpt.com")
+		} else {
+			cmd.Env = append(cmd.Env, "HIROUTE_EXPECT_PROXY=http://127.0.0.1:1187")
+		}
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("child: %v %s", err, out)
+		}
+	}
+}
+
+func TestEnvironmentProxyTransportNeverFallsBackOnError(t *testing.T) {
+	req, _ := http.NewRequest("GET", "https://chatgpt.com/", nil)
+	sentinel := errors.New("proxy failure")
+	directCalls := 0
+	rt := &environmentProxyTransport{
+		direct: environmentTestRT(func(*http.Request) (*http.Response, error) {
+			directCalls++
+			return &http.Response{StatusCode: 200}, nil
+		}),
+		proxy: func(*http.Request) (*url.URL, error) { return url.Parse("http://127.0.0.1:1187") },
+		build: func(s string) http.RoundTripper {
+			return environmentTestRT(func(*http.Request) (*http.Response, error) { return nil, sentinel })
+		},
+	}
+	if _, err := rt.RoundTrip(req); err != sentinel || directCalls != 0 {
+		t.Fatal("proxy failure fell back to direct")
+	}
+	rt.proxy = func(*http.Request) (*url.URL, error) { return nil, sentinel }
+	if _, err := rt.RoundTrip(req); err != sentinel || directCalls != 0 {
+		t.Fatal("selection failure fell back to direct")
+	}
+	rt.proxy = func(*http.Request) (*url.URL, error) { return nil, nil }
+	if _, err := rt.RoundTrip(req); err != nil || directCalls != 1 {
+		t.Fatal("direct bypass broken")
+	}
+}
+
+func TestInvalidEnvironmentProxyFailsBeforeTransportConstruction(t *testing.T) {
+	req, _ := http.NewRequest("GET", "https://chatgpt.com/", nil)
+	for _, raw := range []string{"ftp://127.0.0.1:1187", "http://127.0.0.1:0", "http://127.0.0.1:99999"} {
+		rt := &environmentProxyTransport{
+			proxy: func(*http.Request) (*url.URL, error) { return url.Parse(raw) },
+			build: func(string) http.RoundTripper { t.Fatal("invalid proxy reached constructor"); return nil },
+		}
+		if _, err := rt.RoundTrip(req); err == nil {
+			t.Fatal("invalid proxy accepted")
+		}
+	}
+}
+
+func TestHiRouteInferenceMalformedEnvironmentNeverDialsDirect(t *testing.T) {
+	if scenario := os.Getenv("HIROUTE_INFERENCE_BAD_PROXY_CASE"); scenario != "" {
+		key := "HTTPS_PROXY"
+		if scenario == "lower" {
+			key = "https_proxy"
+		}
+		t.Setenv(key, "http://%zz")
+		if scenario == "no-proxy" {
+			t.Setenv("NO_PROXY", "*")
+		}
+		if scenario == "upper-wins" {
+			t.Setenv("https_proxy", "http://127.0.0.1:1187")
+		}
+		client := NewUtlsHTTPClient(context.Background(), nil, nil, 0)
+		fallback := client.Transport.(*fallbackRoundTripper)
+		for _, protected := range []struct {
+			transport http.RoundTripper
+			target    string
+		}{
+			{fallback.chrome, "https://chatgpt.com/backend-api/codex/models"},
+			{fallback.anthropic, "https://api.anthropic.com/v1/messages"},
+		} {
+			route := protected.transport.(*environmentProxyTransport)
+			directCalls, proxyCalls := 0, 0
+			route.direct = environmentTestRT(func(*http.Request) (*http.Response, error) {
+				directCalls++
+				return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(""))}, nil
+			})
+			route.build = func(string) http.RoundTripper {
+				proxyCalls++
+				return route.direct
+			}
+			request, _ := http.NewRequest(http.MethodPost, protected.target, nil)
+			response, err := client.Do(request)
+			if response != nil {
+				_ = response.Body.Close()
+			}
+			if err == nil || directCalls != 0 || proxyCalls != 0 {
+				t.Fatal("malformed effective proxy reached an inference transport")
+			}
+		}
+		return
+	}
+	for _, scenario := range []string{"upper", "lower", "no-proxy", "upper-wins"} {
+		t.Run(scenario, func(t *testing.T) {
+			command := exec.Command(os.Args[0], "-test.run=^TestHiRouteInferenceMalformedEnvironmentNeverDialsDirect$")
+			command.Env = []string{"HIROUTE_INFERENCE_BAD_PROXY_CASE=" + scenario}
+			if output, err := command.CombinedOutput(); err != nil {
+				t.Fatalf("isolated inference proxy case failed: %v\n%s", err, output)
+			}
+		})
+	}
+}

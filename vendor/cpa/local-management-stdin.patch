+package executor
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/modeldiscovery"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type discoveryDiagnosticTransport struct {
+	status int
+	body   string
+}
+
+func (d discoveryDiagnosticTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	return &http.Response{StatusCode: d.status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(d.body)), Request: req}, nil
+}
+
+func TestHiRouteCodexDiscoveryFailurePhaseAndSafeResponseFacts(t *testing.T) {
+	for _, item := range []struct {
+		name   string
+		status int
+		body   string
+		phase  modeldiscovery.Phase
+		reason modeldiscovery.Reason
+	}{
+		{"unauthorized", 401, `{"error":"private-token"}`, modeldiscovery.Response, modeldiscovery.HTTPRejected},
+		{"forbidden", 403, `private-token`, modeldiscovery.Response, modeldiscovery.HTTPRejected},
+		{"invalid-json", 200, `private-token`, modeldiscovery.Catalog, modeldiscovery.InvalidCatalog},
+		{"duplicate", 200, `{"models":[{"slug":"m"},{"slug":"m"}]}`, modeldiscovery.Catalog, modeldiscovery.DuplicateModelID},
+		{"empty", 200, `{"models":[]}`, modeldiscovery.Catalog, modeldiscovery.EmptyCatalog},
+	} {
+		t.Run(item.name, func(t *testing.T) {
+			id := "diagnostic-" + item.name
+			a := &cliproxyauth.Auth{ID: id, Metadata: map[string]any{"access_token": "private-token", "hiroute_client_version": "0.999.0"}}
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(discoveryDiagnosticTransport{item.status, item.body}))
+			_, err := NewCodexExecutor(nil).DiscoverModels(ctx, a, nil)
+			value := modeldiscovery.Read(id).Latest
+			if value == nil || value.Phase != item.phase || value.Reason != item.reason || value.HTTPStatus == nil || *value.HTTPStatus != item.status {
+				t.Fatal("failure boundary or HTTP status lost")
+			}
+			if item.name == "empty" {
+				if err != nil || value.Outcome != modeldiscovery.Completed || value.ModelCount == nil || *value.ModelCount != 0 {
+					t.Fatal("valid empty catalog mislabeled as failed transport")
+				}
+			} else if err == nil {
+				t.Fatal("invalid discovery succeeded")
+			}
+		})
+	}
+	id := "missing-version-diagnostic"
+	_, err := NewCodexExecutor(nil).DiscoverModels(context.Background(), &cliproxyauth.Auth{ID: id, Metadata: map[string]any{"access_token": "private-token"}}, nil)
+	value := modeldiscovery.Read(id).Latest
+	if err == nil || value.Phase != modeldiscovery.ClientVersion || value.Reason != modeldiscovery.ClientVersionUnavailable || value.HTTPStatus != nil {
+		t.Fatal("local version failure confused with an upstream response")
+	}
+}
diff --git a/internal/runtime/executor/codex_models.go b/internal/runtime/executor/codex_models.go
new file mode 100644
index 0000000..f17845a
--- /dev/null
+++ b/internal/runtime/executor/codex_models.go
@@ -0,0 +1,173 @@
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/modeldiscovery"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// DiscoverModels uses the same account, proxy and TLS transport as Codex requests.
+// The remote list controls membership; bundled metadata only enriches matching IDs.
+func (e *CodexExecutor) DiscoverModels(ctx context.Context, auth *cliproxyauth.Auth, known []*registry.ModelInfo) ([]*registry.ModelInfo, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	trace := modeldiscovery.FromContext(ctx)
+	if trace == nil {
+		id := ""
+		if auth != nil {
+			id = auth.ID
+		}
+		trace = modeldiscovery.Begin(id)
+	}
+	trace.Enter(modeldiscovery.Credentials)
+	token, _ := codexCreds(auth)
+	if strings.TrimSpace(token) == "" {
+		trace.End(modeldiscovery.Failed, modeldiscovery.MissingAccessToken)
+		return nil, fmt.Errorf("codex model discovery: missing access token")
+	}
+	trace.End(modeldiscovery.Completed, modeldiscovery.NoReason)
+	trace.Enter(modeldiscovery.ClientVersion)
+	version, err := codexModelDiscoveryVersion(auth)
+	if err != nil {
+		trace.End(modeldiscovery.Failed, modeldiscovery.ClientVersionUnavailable)
+		return nil, err
+	}
+	trace.End(modeldiscovery.Completed, modeldiscovery.NoReason)
+	trace.Enter(modeldiscovery.Request)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "https://chatgpt.com/backend-api/codex/models?client_version="+url.QueryEscape(version), nil)
+	if err != nil {
+		trace.Transport(err)
+		return nil, err
+	}
+	applyCodexHeadersFromSources(req, auth, token, false, e.cfg, nil)
+	client := helps.NewUtlsHTTPClient(ctx, e.cfg, auth, 5*time.Second)
+	// Never forward subscription credentials to a redirect target.
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	resp, err := client.Do(req)
+	if err != nil {
+		trace.Transport(err)
+		return nil, fmt.Errorf("codex model discovery: transport failed")
+	}
+	defer resp.Body.Close()
+	trace.HTTP(resp.StatusCode)
+	trace.End(modeldiscovery.Completed, modeldiscovery.NoReason)
+	trace.Enter(modeldiscovery.Response)
+	if resp.StatusCode != http.StatusOK {
+		trace.End(modeldiscovery.Failed, modeldiscovery.HTTPRejected)
+		return nil, fmt.Errorf("codex model discovery: HTTP %d", resp.StatusCode)
+	}
+	const limit = 16 << 20
+	body, err := io.ReadAll(io.LimitReader(resp.Body, limit+1))
+	if err != nil || len(body) > limit {
+		reason := modeldiscovery.BodyReadFailure
+		if len(body) > limit {
+			reason = modeldiscovery.ResponseTooLarge
+		}
+		if ctx.Err() == context.DeadlineExceeded {
+			reason = modeldiscovery.Timeout
+		}
+		if ctx.Err() == context.Canceled {
+			reason = modeldiscovery.Cancelled
+		}
+		trace.End(modeldiscovery.Failed, reason)
+		return nil, fmt.Errorf("codex model discovery: unreadable or oversized catalog")
+	}
+	trace.End(modeldiscovery.Completed, modeldiscovery.NoReason)
+	trace.Enter(modeldiscovery.Catalog)
+	var catalog struct {
+		Models []struct {
+			Slug             string   `json:"slug"`
+			DisplayName      string   `json:"display_name"`
+			Description      string   `json:"description"`
+			ContextWindow    int      `json:"context_window"`
+			MaxContextWindow int      `json:"max_context_window"`
+			InputModalities  []string `json:"input_modalities"`
+			Reasoning        []struct {
+				Effort string `json:"effort"`
+			} `json:"supported_reasoning_levels"`
+		} `json:"models"`
+	}
+	if json.Unmarshal(body, &catalog) != nil || catalog.Models == nil {
+		trace.End(modeldiscovery.Failed, modeldiscovery.InvalidCatalog)
+		return nil, fmt.Errorf("codex model discovery: invalid catalog")
+	}
+	byID := make(map[string]*registry.ModelInfo, len(known))
+	for _, m := range known {
+		if m != nil {
+			byID[m.ID] = m
+		}
+	}
+	models := make([]*registry.ModelInfo, 0, len(catalog.Models))
+	seen := make(map[string]bool)
+	for _, remote := range catalog.Models {
+		id := strings.TrimSpace(remote.Slug)
+		if id == "" || seen[id] {
+			reason := modeldiscovery.InvalidModelID
+			if seen[id] {
+				reason = modeldiscovery.DuplicateModelID
+			}
+			trace.End(modeldiscovery.Failed, reason)
+			return nil, fmt.Errorf("codex model discovery: invalid or duplicate model ID")
+		}
+		seen[id] = true
+		m := registry.ModelInfo{ID: id, Object: "model", OwnedBy: "openai", Type: "codex"}
+		if base := byID[id]; base != nil {
+			m = *base
+		}
+		m.DisplayName, m.Description = remote.DisplayName, remote.Description
+		m.ContextLength, m.MaxContextLength = remote.ContextWindow, remote.MaxContextWindow
+		if m.ContextLength == 0 {
+			m.ContextLength = m.MaxContextLength
+		}
+		m.SupportedInputModalities = remote.InputModalities
+		m.Thinking = nil
+		if len(remote.Reasoning) > 0 {
+			m.Thinking = &registry.ThinkingSupport{}
+			for _, level := range remote.Reasoning {
+				if level.Effort != "" {
+					m.Thinking.Levels = append(m.Thinking.Levels, level.Effort)
+				}
+			}
+		}
+		models = append(models, &m)
+	}
+	trace.Models(len(models))
+	reason := modeldiscovery.NoReason
+	if len(models) == 0 {
+		reason = modeldiscovery.EmptyCatalog
+	}
+	trace.End(modeldiscovery.Completed, reason)
+	return models, nil
+}
+
+func codexModelDiscoveryVersion(auth *cliproxyauth.Auth) (string, error) {
+	version, _ := auth.Metadata["hiroute_client_version"].(string)
+	refreshToken, _ := auth.Metadata["refresh_token"].(string)
+	if strings.TrimSpace(refreshToken) != "" {
+		// Independently authorized credentials belong to CPA. Advertise the same
+		// upstream client version its executor actually uses, including at the
+		// first OAuth registration before HiRoute has patched account controls.
+		// Access-only native leases must still provide their observed version.
+		clientIdentity, _, _ := strings.Cut(codexUserAgent, " ")
+		var ok bool
+		version, ok = strings.CutPrefix(clientIdentity, codexOriginator+"/")
+		if !ok {
+			return "", fmt.Errorf("codex model discovery: executor client version unavailable")
+		}
+	}
+	version = strings.TrimSpace(version)
+	if version == "" || len(version) > 128 || strings.ContainsAny(version, "\r\n\x00") {
+		return "", fmt.Errorf("codex model discovery: local client version unavailable")
+	}
+	return version, nil
+}

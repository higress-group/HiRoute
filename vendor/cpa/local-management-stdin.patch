+func TestHiRouteLoopbackListenersReleaseTogether(t *testing.T) {
+	reservation, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := reservation.Addr().(*net.TCPAddr).Port
+	_ = reservation.Close()
+	listeners, err := listenHiRouteCallbackLoopback(port)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, ln := range listeners {
+		if !ln.Addr().(*net.TCPAddr).IP.IsLoopback() {
+			t.Fatal("non-loopback callback listener")
+		}
+		_ = ln.Close()
+	}
+	forwarder, err := startHiRouteCallbackReceiver(port, "codex", "hiroute-loopback", t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	stopCallbackForwarderInstance(port, forwarder)
+	reopened, err := listenHiRouteCallbackLoopback(port)
+	if err != nil {
+		t.Fatalf("callback listener leaked: %v", err)
+	}
+	for _, ln := range reopened {
+		_ = ln.Close()
+	}
+	// An occupied IPv6 endpoint must release the already-opened IPv4 endpoint.
+	ipv6, err := net.Listen("tcp6", net.JoinHostPort("::1", strconv.Itoa(port)))
+	if err == nil {
+		defer ipv6.Close()
+		if opened, err := listenHiRouteCallbackLoopback(port); err == nil {
+			for _, ln := range opened {
+				_ = ln.Close()
+			}
+			t.Fatal("occupied IPv6 listener was ignored")
+		}
+		ipv4, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+		if err != nil {
+			t.Fatal("partial IPv4 listener leaked")
+		}
+		_ = ipv4.Close()
+	}
+}
+
+func TestHiRouteOccupiedCallbackPortKeepsManualSession(t *testing.T) {
+	for _, provider := range []string{"codex", "anthropic"} {
+		port := codexCallbackPort
+		if provider == "anthropic" {
+			port = anthropicCallbackPort
+		}
+		occupied, err := net.Listen("tcp4", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+		if err == nil {
+			defer occupied.Close()
+		}
+		h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: t.TempDir(), Port: 47111}, nil)
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest("GET", "/auth-url?is_webui=true", nil)
+		if provider == "codex" {
+			h.RequestCodexToken(c)
+		} else {
+			h.RequestAnthropicToken(c)
+		}
+		var login map[string]string
+		if err := json.Unmarshal(w.Body.Bytes(), &login); err != nil {
+			t.Fatal(err)
+		}
+		if w.Code != 200 || login["hiroute_callback_mode"] != "manual" || login["url"] == "" || !IsOAuthSessionPending(login["state"], provider) {
+			t.Fatalf("occupied callback port lost the manual session: status %d", w.Code)
+		}
+		CancelOAuthSession(login["state"])
+	}
+}

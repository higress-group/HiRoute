index 0000000..74d027d
--- /dev/null
+++ b/internal/api/handlers/management/local_machine_password_test.go
@@ -0,0 +1,38 @@
+package management
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"golang.org/x/crypto/bcrypt"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestLocalMachinePasswordPreservesRemotePolicy(t *testing.T) {
+	t.Setenv("MANAGEMENT_PASSWORD", "")
+	machine := strings.Repeat("m", 40)
+	cfg := &config.Config{}
+	hash, errHash := bcrypt.GenerateFromPassword([]byte("different-config-secret"), bcrypt.MinCost)
+	if errHash != nil {
+		t.Fatal(errHash)
+	}
+	cfg.RemoteManagement.SecretKey = string(hash)
+	cfg.RemoteManagement.AllowRemote = false
+	handler := NewHandlerWithoutConfigFilePath(cfg, nil)
+	handler.SetLocalPassword(machine)
+	if ok, _, _ := handler.AuthenticateManagementKey("127.0.0.1", true, machine); !ok {
+		t.Fatal("local machine credential rejected")
+	}
+	if ok, code, _ := handler.AuthenticateManagementKey("198.51.100.1", false, machine); ok || code != http.StatusForbidden {
+		t.Fatal("remote policy overridden")
+	}
+	for _, invalid := range []string{"", "wrong", strings.Repeat("m", 39) + "n"} {
+		if ok, _, _ := handler.AuthenticateManagementKey("127.0.0.1", true, invalid); ok {
+			t.Fatal("invalid machine credential accepted")
+		}
+	}
+	handler.SetLocalPassword(strings.Repeat("n", 40))
+	if ok, _, _ := handler.AuthenticateManagementKey("127.0.0.2", true, machine); ok {
+		t.Fatal("old instance credential accepted")
+	}
+}
diff --git a/internal/auth/claude/hiroute_environment_proxy_test.go b/internal/auth/claude/hiroute_environment_proxy_test.go
new file mode 100644
index 0000000..3869b7e
--- /dev/null
+++ b/internal/auth/claude/hiroute_environment_proxy_test.go
@@ -0,0 +1,195 @@
+package claude
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+type hirouteOAuthDirectDialer struct{ calls atomic.Int32 }
+
+func (d *hirouteOAuthDirectDialer) Dial(network, address string) (net.Conn, error) {
+	return d.DialContext(context.Background(), network, address)
+}
+
+func (d *hirouteOAuthDirectDialer) DialContext(context.Context, string, string) (net.Conn, error) {
+	d.calls.Add(1)
+	return nil, errors.New("synthetic direct dial stopped before network")
+}
+
+// Each case needs a clean process because net/http snapshots environment proxy
+// settings once. Actual local CONNECT requests establish the selected route;
+// no provider requests, credentials, DNS resolution or token exchange are used.
+func TestHiRouteClaudeOAuthEnvironmentRouting(t *testing.T) {
+	if scenario := os.Getenv("HIROUTE_CLAUDE_OAUTH_PROXY_CASE"); scenario != "" {
+		testHiRouteClaudeOAuthEnvironmentRouting(t, scenario)
+		return
+	}
+	for _, scenario := range []string{
+		"upper", "lower", "upper-precedence", "no-proxy", "lower-no-proxy",
+		"per-target", "direct", "none", "explicit", "invalid-environment",
+		"invalid-explicit", "proxy-connect-failure", "selection-failure",
+		"all-proxy-ignored", "http-only-does-not-proxy-https", "http-inherit",
+		"malformed-https-upper", "malformed-https-lower", "malformed-http-upper",
+		"malformed-http-lower", "malformed-with-no-proxy", "malformed-upper-wins",
+		"valid-upper-ignores-malformed-lower", "valid-https-ignores-malformed-http",
+		"valid-http-ignores-malformed-https", "https-host-port-shorthand",
+	} {
+		t.Run(scenario, func(t *testing.T) {
+			command := exec.Command(os.Args[0], "-test.run=^TestHiRouteClaudeOAuthEnvironmentRouting$")
+			command.Env = []string{"HIROUTE_CLAUDE_OAUTH_PROXY_CASE=" + scenario}
+			if output, err := command.CombinedOutput(); err != nil {
+				t.Fatalf("isolated proxy case failed: %v\n%s", err, output)
+			}
+		})
+	}
+}
+
+func testHiRouteClaudeOAuthEnvironmentRouting(t *testing.T, scenario string) {
+	t.Helper()
+	var inheritedCalls, explicitCalls atomic.Int32
+	makeProxy := func(calls *atomic.Int32) *httptest.Server {
+		return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+			calls.Add(1)
+			if request.Method != http.MethodConnect || request.Host != "platform.claude.invalid:443" {
+				t.Errorf("proxy did not receive the exact OAuth target CONNECT")
+			}
+			// Deliberately fail the proxy hop. The caller must not retry directly.
+			w.WriteHeader(http.StatusBadGateway)
+		}))
+	}
+	inherited := makeProxy(&inheritedCalls)
+	defer inherited.Close()
+	explicit := makeProxy(&explicitCalls)
+	defer explicit.Close()
+	cfg := &config.SDKConfig{}
+	target := "https://platform.claude.invalid:443/v1/oauth/token"
+	wantInherited, wantExplicit, wantDirect := int32(1), int32(0), int32(0)
+	switch scenario {
+	case "upper":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+	case "lower":
+		t.Setenv("https_proxy", inherited.URL)
+	case "upper-precedence":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		t.Setenv("https_proxy", explicit.URL)
+	case "malformed-https-upper", "malformed-https-lower", "malformed-http-upper", "malformed-http-lower", "malformed-with-no-proxy", "malformed-upper-wins":
+		key := "HTTPS_PROXY"
+		if strings.HasPrefix(scenario, "malformed-http-") {
+			key = "HTTP_PROXY"
+			target = "http://platform.claude.invalid:443/v1/oauth/token"
+		}
+		if strings.HasSuffix(scenario, "-lower") {
+			key = strings.ToLower(key)
+		}
+		t.Setenv(key, "http://%zz")
+		if scenario == "malformed-with-no-proxy" {
+			t.Setenv("NO_PROXY", "*")
+		}
+		if scenario == "malformed-upper-wins" {
+			t.Setenv("https_proxy", inherited.URL)
+		}
+		wantInherited = 0
+	case "valid-upper-ignores-malformed-lower":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		t.Setenv("https_proxy", "http://%zz")
+	case "valid-https-ignores-malformed-http":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		t.Setenv("HTTP_PROXY", "http://%zz")
+	case "valid-http-ignores-malformed-https":
+		t.Setenv("HTTP_PROXY", inherited.URL)
+		t.Setenv("HTTPS_PROXY", "http://%zz")
+		target = "http://platform.claude.invalid:443/v1/oauth/token"
+	case "https-host-port-shorthand":
+		t.Setenv("HTTPS_PROXY", strings.TrimPrefix(inherited.URL, "http://"))
+	case "no-proxy", "lower-no-proxy", "per-target":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		key := "NO_PROXY"
+		if scenario == "lower-no-proxy" {
+			key = "no_proxy"
+		}
+		if scenario == "per-target" {
+			t.Setenv(key, "api.anthropic.invalid")
+		} else {
+			t.Setenv(key, "platform.claude.invalid")
+			wantInherited, wantDirect = 0, 1
+		}
+	case "direct", "none":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		cfg.ProxyURL = scenario
+		wantInherited, wantDirect = 0, 1
+	case "explicit":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		t.Setenv("NO_PROXY", "*") // Explicit settings take precedence over environment bypass.
+		cfg.ProxyURL = explicit.URL
+		wantInherited, wantExplicit = 0, 1
+	case "invalid-environment":
+		t.Setenv("HTTPS_PROXY", "ftp://127.0.0.1:1187")
+		wantInherited = 0
+	case "invalid-explicit":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		cfg.ProxyURL = "ftp://127.0.0.1:1187"
+		wantInherited = 0
+	case "proxy-connect-failure":
+		t.Setenv("HTTPS_PROXY", inherited.URL)
+		inherited.Close()
+		wantInherited = 0
+	case "selection-failure":
+		t.Setenv("HTTP_PROXY", inherited.URL)
+		t.Setenv("REQUEST_METHOD", "POST") // Go refuses the unsafe CGI HTTP_PROXY route.
+		target = "http://platform.claude.invalid:443/v1/oauth/token"
+		wantInherited = 0
+	case "all-proxy-ignored":
+		t.Setenv("ALL_PROXY", inherited.URL)
+		t.Setenv("all_proxy", inherited.URL)
+		wantInherited, wantDirect = 0, 1
+	case "http-only-does-not-proxy-https":
+		t.Setenv("HTTP_PROXY", inherited.URL)
+		wantInherited, wantDirect = 0, 1
+	case "http-inherit":
+		t.Setenv("HTTP_PROXY", inherited.URL)
+		target = "http://platform.claude.invalid:443/v1/oauth/token"
+	default:
+		t.Fatal("unknown proxy case")
+	}
+	client := NewAnthropicHttpClient(cfg)
+	client.Timeout = time.Second
+	transport := client.Transport.(*utlsRoundTripper)
+	defer transport.CloseIdleConnections()
+	direct := &hirouteOAuthDirectDialer{}
+	if scenario != "explicit" {
+		transport.dialer = direct
+	}
+	makeRequest := func(target string) {
+		request, err := http.NewRequestWithContext(t.Context(), http.MethodPost, target, nil)
+		if err != nil {
+			t.Fatal("create synthetic request failed")
+		}
+		response, err := client.Do(request)
+		if response != nil {
+			_ = response.Body.Close()
+		}
+		if err == nil {
+			t.Fatal("synthetic network boundary unexpectedly succeeded")
+		}
+	}
+	makeRequest(target)
+	if scenario == "per-target" {
+		makeRequest("https://api.anthropic.invalid/api/oauth/profile")
+		wantDirect = 1
+	}
+	if inheritedCalls.Load() != wantInherited || explicitCalls.Load() != wantExplicit || direct.calls.Load() != wantDirect {
+		t.Fatalf("route counts: inherited=%d explicit=%d direct=%d; want %d/%d/%d",
+			inheritedCalls.Load(), explicitCalls.Load(), direct.calls.Load(), wantInherited, wantExplicit, wantDirect)
+	}
+}

+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+)
+
+func TestHiRouteDiscoveryFirstFailureSurvivesRecoveryAndOutOfOrderCompletion(t *testing.T) {
+	id := "private-account-must-not-leak"
+	first := Begin(id)
+	first.Enter(ClientVersion)
+	first.End(Failed, ClientVersionUnavailable)
+	second := Begin(id)
+	second.Enter(Catalog)
+	second.Models(9)
+	second.End(Completed, NoReason)
+	first.Enter(Registration)
+	first.End(Discarded, AccountChanged)
+	snapshot := Read(id)
+	if snapshot.FirstFailure == nil || snapshot.FirstFailure.Reason != ClientVersionUnavailable || snapshot.Latest.ID != second.value.ID {
+		t.Fatal("first failure or latest attempt lost")
+	}
+	if *snapshot.Latest.ModelCount != 9 {
+		t.Fatal("model count lost")
+	}
+	*snapshot.Latest.ModelCount = 123
+	if *Read(id).Latest.ModelCount != 9 {
+		t.Fatal("snapshot mutates retained observation")
+	}
+	encoded, _ := json.Marshal(snapshot)
+	if strings.Contains(string(encoded), id) || strings.Contains(string(encoded), "access_token") {
+		t.Fatal("private identity leaked")
+	}
+}
+
+func TestHiRouteDiscoveryTransportCategoriesNeverRetainRawErrors(t *testing.T) {
+	for index, item := range []struct {
+		err    error
+		reason Reason
+		status int
+	}{
+		{context.DeadlineExceeded, Timeout, 0},
+		{context.Canceled, Cancelled, 0},
+		{&net.DNSError{Name: "private-host", Err: "private-token"}, DNSFailure, 0},
+		{&net.OpError{Op: "dial", Err: fmt.Errorf("private-token")}, ConnectFailure, 0},
+		{fmt.Errorf("utls: TLS handshake: private-token"), TLSFailure, 0},
+		{fmt.Errorf("read CONNECT response failed: private-token"), ProxyFailure, 0},
+		{fmt.Errorf("wrapped: %w", &proxyutil.ConnectStatusError{StatusCode: 503}), ProxyRejected, 503},
+		{fmt.Errorf("private-token"), TransportFailure, 0},
+	} {
+		id := fmt.Sprintf("transport-%d", index)
+		trace := Begin(id)
+		trace.Enter(Request)
+		trace.Transport(item.err)
+		value := Read(id).Latest
+		if value.Reason != item.reason {
+			t.Fatalf("case %d reason=%s", index, value.Reason)
+		}
+		if item.status != 0 && (value.ProxyStatus == nil || *value.ProxyStatus != item.status || value.HTTPStatus != nil) {
+			t.Fatal("proxy status was mislabeled as upstream status")
+		}
+		data, _ := json.Marshal(value)
+		if strings.Contains(string(data), "private-token") || strings.Contains(string(data), "private-host") {
+			t.Fatal("raw transport data leaked")
+		}
+	}
+}
+
+func TestHiRouteDiscoveryStorageAndPhaseHistoryAreBounded(t *testing.T) {
+	for index := 0; index < capacity+5; index++ {
+		trace := Begin(fmt.Sprintf("bounded-%d", index))
+		for phase := 0; phase < 10; phase++ {
+			trace.Enter(Request)
+			trace.End(Completed, NoReason)

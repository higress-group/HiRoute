+				}
+				if mode == "invalid_after_refresh" {
+					executor.refreshTokens[primary.ID] = "still-invalid-token"
+					executor.tokenInvalid["still-invalid-token"] = struct{}{}
+				}
+				ctx, trace := coreexecutor.WithHiRouteExecution(context.Background())
+				opts := coreexecutor.Options{Metadata: map[string]any{coreexecutor.PinnedAuthMetadataKey: primary.ID}}
+				var err error
+				if stream {

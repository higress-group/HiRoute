diff --git a/cmd/server/local_management_password.go b/cmd/server/local_management_password.go
new file mode 100644
index 0000000..67333ea
--- /dev/null
+++ b/cmd/server/local_management_password.go
@@ -0,0 +1,24 @@
+package main
+
+import (
+	"errors"
+	"io"
+)
+
+// The managed parent owns this pipe and closes it after one bounded random credential.
+// Keep credentials out of argv, environment variables and diagnostic messages.
+func readLocalManagementPassword(input io.Reader) (string, error) {
+	content, errRead := io.ReadAll(io.LimitReader(input, 129))
+	if errRead != nil || len(content) < 32 || len(content) > 128 {
+		return "", errors.New("invalid local management credential")
+	}
+	for _, c := range content {
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') || c == '-' || c == '_') {
+			return "", errors.New("invalid local management credential")
+		}
+	}
+	password := string(content)
+	clear(content)
+	return password, nil
+}
diff --git a/cmd/server/local_management_password_test.go b/cmd/server/local_management_password_test.go
new file mode 100644
index 0000000..abb036f
--- /dev/null
+++ b/cmd/server/local_management_password_test.go
@@ -0,0 +1,19 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestLocalManagementPasswordPipeBounds(t *testing.T) {
+	for _, invalid := range []string{"", strings.Repeat("x", 31), strings.Repeat("x", 129), strings.Repeat("x", 32) + "\n", strings.Repeat("x", 32) + "\x00"} {
+		if value, errRead := readLocalManagementPassword(strings.NewReader(invalid)); errRead == nil || value != "" {
+			t.Fatal("invalid credential was accepted")
+		}
+	}
+	for _, valid := range []string{strings.Repeat("x", 32), strings.Repeat("x", 128), strings.Repeat("a-B_", 10)} {
+		if value, errRead := readLocalManagementPassword(strings.NewReader(valid)); errRead != nil || value != valid {
+			t.Fatal("valid credential was rejected")
+		}
+	}
+}

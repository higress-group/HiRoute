+package helps
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func TestHiRouteInferenceDistinguishesTransportAndUpstreamStatus(t *testing.T) {
+	for _, scenario := range []string{"http500", "body", "connection", "cancelled", "cancel_body"} {
+		t.Run(scenario, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if scenario == "cancel_body" {
+					w.WriteHeader(200)
+					w.(http.Flusher).Flush()
+					<-r.Context().Done()
+					return
+				}
+				if scenario == "body" {
+					w.Header().Set("Content-Length", "100")
+					_, _ = w.Write([]byte("x"))
+					return
+				}
+				w.WriteHeader(500)
+				_, _ = w.Write([]byte("private-provider-error-must-not-enter-trace"))
+			}))
+			defer server.Close()
+			if scenario == "connection" {
+				server.Close()
+			}
+			ctx, trace := coreexecutor.WithHiRouteExecution(context.Background())
+			ctx, cancel := context.WithCancel(ctx)
+			defer cancel()
+			if scenario == "cancelled" {
+				cancel()
+			}
+			client := NewUsageReporter(ctx, "codex", "fixture", nil).TrackHTTPClient(server.Client())
+			req, err := http.NewRequestWithContext(ctx, http.MethodPost, server.URL, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			resp, sendErr := client.Do(req)
+			if scenario == "cancel_body" {
+				cancel()
+			}
+			var readErr error
+			if resp != nil {
+				_, readErr = io.Copy(io.Discard, resp.Body)
+				_ = resp.Body.Close()
+			}
+			want := map[string]string{
+				"http500":     "v2;1;0;0;0;0;1,500,headers,none;1,500,headers,none",
+				"body":        "v2;1;0;0;0;0;1,200,body,unexpected_eof;1,200,body,unexpected_eof",
+				"connection":  "v2;1;0;0;0;0;1,0,transport,network;1,0,transport,network",
+				"cancel_body": "v2;1;0;0;0;0;1,200,body,cancelled;1,200,body,cancelled",
+				"cancelled":   "v2;0;0;0;0;0;-;-",
+			}[scenario]
+			if trace.Header() != want {
+				t.Fatalf("trace=%q want=%q", trace.Header(), want)
+			}
+			if scenario == "body" && readErr != io.ErrUnexpectedEOF {
+				t.Fatalf("body error=%v", readErr)
+			}
+			if (scenario == "connection" || scenario == "cancelled") && sendErr == nil {
+				t.Fatal("expected transport refusal")
+			}
+		})
+	}
+}

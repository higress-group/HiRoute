diff --git a/sdk/cliproxy/service_codex_discovery_test.go b/sdk/cliproxy/service_codex_discovery_test.go
new file mode 100644
index 0000000..8909d5d
--- /dev/null
+++ b/sdk/cliproxy/service_codex_discovery_test.go
@@ -0,0 +1,114 @@
+package cliproxy
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/modeldiscovery"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+type discoveryTransport func(*http.Request) (*http.Response, error)
+
+func (f discoveryTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestCodexDiscoveryRegistration(t *testing.T) {
+	s := &Service{cfg: &config.Config{}}
+	s.cfg.ForceModelPrefix = true
+	a := &coreauth.Auth{ID: "discovery-account", Provider: "codex", Prefix: "subscription", Metadata: map[string]any{"access_token": "test-token", "account_id": "test-account", "hiroute_client_version": "0.999.0"}, Attributes: map[string]string{"excluded_models": "excluded"}}
+	defer GlobalModelRegistry().UnregisterClient(a.ID)
+	status, body := 200, `{"models":[{"slug":"future-model-not-in-bundle","display_name":"Future","context_window":123456,"input_modalities":["text","image"],"supported_reasoning_levels":[{"effort":"max"}]},{"slug":"excluded"}]}`
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+		if r.URL.String() != "https://chatgpt.com/backend-api/codex/models?client_version=0.999.0" || r.Header.Get("Authorization") != "Bearer test-token" || r.Header.Get("ChatGPT-Account-ID") != "test-account" {
+			t.Fatal("wrong discovery request")
+		}
+		if _, ok := r.Context().Deadline(); !ok {
+			t.Fatal("missing deadline")
+		}
+		return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	}))
+	s.registerModelsForAuth(ctx, a)
+	check := func() {
+		t.Helper()
+		models := GlobalModelRegistry().GetModelsForClient(a.ID)
+		if len(models) != 1 || models[0].ID != "subscription/future-model-not-in-bundle" || models[0].ContextLength != 123456 || models[0].Thinking.Levels[0] != "max" {
+			t.Fatalf("unexpected registered models: %+v", models)
+		}
+	}
+	check()
+	for _, failure := range []struct {
+		status int
+		body   string
+	}{{401, `secret upstream error`}, {200, `{broken`}, {200, `{}`}, {200, `{"models":[{"slug":""}]}`}} {
+		status, body = failure.status, failure.body
+		s.registerModelsForAuth(ctx, a)
+		check()
+	}
+	status, body = 200, `{"models":[]}`
+	s.registerModelsForAuth(ctx, a)
+	if len(GlobalModelRegistry().GetModelsForClient(a.ID)) != 0 {
+		t.Fatal("empty authoritative list did not remove models")
+	}
+	snapshot := modeldiscovery.Read(a.ID)
+	if snapshot.FirstFailure == nil || snapshot.FirstFailure.Reason != modeldiscovery.HTTPRejected || snapshot.Latest == nil || snapshot.Latest.Phase != modeldiscovery.Registration || snapshot.Latest.Reason != modeldiscovery.EmptyAfterFiltering {
+		t.Fatalf("lost first failure or empty registration facts: %+v", snapshot)
+	}
+	if snapshot.Latest.Timings[4].Reason != modeldiscovery.EmptyCatalog {
+		t.Fatal("upstream empty catalog was confused with filtering")
+	}
+	status, body = 200, `{"models":[{"slug":"other-account-model"}]}`
+	a.ID, a.Prefix = "other-account", "other"
+	defer GlobalModelRegistry().UnregisterClient(a.ID)
+	s.registerModelsForAuth(ctx, a)
+	if len(GlobalModelRegistry().GetModelsForClient("discovery-account")) != 0 {
+		t.Fatal("cross-account catalog leakage")
+	}
+}
+
+func TestHiRouteDiscoveryRegistrationDiscard(t *testing.T) {
+	for _, reason := range []modeldiscovery.Reason{modeldiscovery.AccountMissing, modeldiscovery.AccountDisabled, modeldiscovery.AccountChanged, modeldiscovery.Cancelled} {
+		t.Run(string(reason), func(t *testing.T) {
+			manager := coreauth.NewManager(nil, nil, nil)
+			a := &coreauth.Auth{ID: "discard-" + string(reason), Provider: "codex", Metadata: map[string]any{"access_token": "private-test-token", "hiroute_client_version": "0.999.0"}}
+			registered, err := manager.Register(context.Background(), a)
+			if err != nil {
+				t.Fatal(err)
+			}
+			a = registered.Clone()
+			s := &Service{cfg: &config.Config{}, coreManager: manager}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			ctx = context.WithValue(ctx, "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+				switch reason {
+				case modeldiscovery.AccountMissing:
+					manager.Remove(context.Background(), a.ID)
+				case modeldiscovery.AccountDisabled, modeldiscovery.AccountChanged:
+					current, _ := manager.GetByID(a.ID)
+					current.Disabled = reason == modeldiscovery.AccountDisabled
+					current.RegistrationEpoch++
+					if _, err := manager.Update(context.Background(), current); err != nil {
+						t.Fatal(err)
+					}
+				case modeldiscovery.Cancelled:
+					cancel()
+				}
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"models":[{"slug":"safe-model"}]}`)), Request: r}, nil
+			}))
+			s.registerModelsForAuth(ctx, a)
+			snapshot := modeldiscovery.Read(a.ID)
+			if snapshot.Latest == nil || snapshot.Latest.Phase != modeldiscovery.Registration || snapshot.Latest.Outcome != modeldiscovery.Discarded || snapshot.Latest.Reason != reason {
+				t.Fatalf("wrong discard: %+v", snapshot.Latest)
+			}
+			if reason == modeldiscovery.AccountChanged && (snapshot.Latest.RegistrationEpochMatches == nil || *snapshot.Latest.RegistrationEpochMatches) {
+				t.Fatal("missing exact registration epoch mismatch")
+			}
+			if len(GlobalModelRegistry().GetModelsForClient(a.ID)) != 0 {
+				t.Fatal("discarded catalog registered")
+			}
+		})
+	}
+}
diff --git a/sdk/cliproxy/service_codex_registration.go b/sdk/cliproxy/service_codex_registration.go
new file mode 100644
index 0000000..518a73f
--- /dev/null
+++ b/sdk/cliproxy/service_codex_registration.go
@@ -0,0 +1,48 @@
+package cliproxy
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/modeldiscovery"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func (s *Service) registerModelsForAuthWithCache(ctx context.Context, a *coreauth.Auth, cache *openAICompatibilityRegistrationCache) {
+	if a != nil {
+		done := modeldiscovery.Registering(a.ID)
+		defer done()
+	}
+	if !codexDiscoveryAccount(a) {
+		s.registerModelsForAuthAttempt(ctx, a, cache)
+		return
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	// A newer generation may supersede a lookup while it is in flight. Discard
+	// its result, then discover once for that latest generation in the SAME
+	// five-second budget. Transport failures do not request a handoff.
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	if s != nil && s.coreManager != nil {
+		if latest, ok := s.coreManager.GetByID(a.ID); ok && latest != nil && latest.RegistrationEpoch == a.RegistrationEpoch && codexDiscoveryAccount(latest) {
+			a = latest
+		}
+	}
+	for attempt := 0; attempt < 2 && ctx.Err() == nil; attempt++ {
+		a = s.registerModelsForAuthAttempt(ctx, a, cache)
+		if a == nil {
+			return
+		}
+	}
+}
+
+func codexDiscoveryAccount(a *coreauth.Auth) bool {
+	if a == nil || !strings.EqualFold(strings.TrimSpace(a.Provider), "codex") || a.AuthKind() == "apikey" {
+		return false
+	}
+	token, _ := a.Metadata["access_token"].(string)
+	return strings.TrimSpace(token) != ""
+}
diff --git a/sdk/cliproxy/service_codex_registration_test.go b/sdk/cliproxy/service_codex_registration_test.go
new file mode 100644
index 0000000..63e93fc
--- /dev/null
+++ b/sdk/cliproxy/service_codex_registration_test.go
@@ -0,0 +1,208 @@
+package cliproxy
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/modeldiscovery"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/watcher"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+func TestHiRouteCodexRegistrationUsesLatestGeneration(t *testing.T) {
+	manager := coreauth.NewManager(nil, nil, nil)
+	original, err := manager.Register(context.Background(), &coreauth.Auth{ID: "generation-handoff", Provider: "codex", Prefix: "old", Metadata: map[string]any{"access_token": "old-access", "hiroute_client_version": "0.999.0"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer GlobalModelRegistry().UnregisterClient(original.ID)
+	service := &Service{cfg: &config.Config{}, coreManager: manager}
+	service.cfg.ForceModelPrefix = true
+	calls := 0
+	var firstDeadline time.Time
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		if !modeldiscovery.Read(original.ID).RegistrationPending {
+			t.Fatal("registration scope ended before its lookup/handoff")
+		}
+		deadline, ok := r.Context().Deadline()
+		if !ok {
+			t.Fatal("missing discovery bound")
+		}
+		body := `{"models":[{"slug":"old-only"}]}`
+		switch calls {
+		case 1:
+			firstDeadline = deadline
+			if r.Header.Get("Authorization") != "Bearer old-access" {
+				t.Fatal("wrong original credential")
+			}
+			next, _ := manager.GetByID(original.ID)
+			next.Prefix = "new"
+			next.Metadata["access_token"] = "new-access"
+			if _, err := manager.Update(context.Background(), next); err != nil {
+				t.Fatal(err)
+			}
+			time.Sleep(15 * time.Millisecond)
+		case 2:
+			if !deadline.Equal(firstDeadline) {
+				t.Fatal("handoff reset the discovery deadline")
+			}
+			if r.Header.Get("Authorization") != "Bearer new-access" {
+				t.Fatal("latest credential not used")
+			}
+			body = `{"models":[{"slug":"new-only"}]}`
+		default:
+			t.Fatal("unbounded generation handoff")
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	}))
+	service.completeModelRegistrationForAuth(ctx, original)
+	models := GlobalModelRegistry().GetModelsForClient(original.ID)
+	if calls != 2 || len(models) != 1 || models[0].ID != "new/new-only" {
+		t.Fatalf("latest authorization lost: calls=%d models=%+v", calls, models)
+	}
+	snapshot := modeldiscovery.Read(original.ID)
+	if snapshot.RegistrationPending {
+		t.Fatal("registration scope leaked after completion")
+	}
+	if snapshot.FirstFailure == nil || snapshot.FirstFailure.Reason != modeldiscovery.AccountChanged || snapshot.Latest == nil || snapshot.Latest.Phase != modeldiscovery.Registration || snapshot.Latest.Outcome != modeldiscovery.Completed {
+		t.Fatal("handoff lost failure/recovery evidence")
+	}
+}
+
+func TestHiRouteCodexRegistrationHandoffIsBoundedAndDoesNotRetryTransport(t *testing.T) {
+	for _, mutate := range []bool{false, true} {
+		name := "transport"
+		if mutate {
+			name = "continuous-generation-change"
+		}
+		t.Run(name, func(t *testing.T) {
+			manager := coreauth.NewManager(nil, nil, nil)
+			original, err := manager.Register(context.Background(), &coreauth.Auth{ID: "bounded-" + name, Provider: "codex", Metadata: map[string]any{"access_token": "test-access", "hiroute_client_version": "0.999.0"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			service := &Service{cfg: &config.Config{}, coreManager: manager}
+			calls := 0
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if !mutate {
+					return nil, errors.New("synthetic transport failure")
+				}
+				if calls > 2 {
+					t.Fatal("unbounded registration handoff")
+				}
+				next, _ := manager.GetByID(original.ID)
+				if _, err := manager.Update(context.Background(), next); err != nil {
+					t.Fatal(err)
+				}
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"models":[{"slug":"stale"}]}`)), Request: r}, nil
+			}))
+			service.completeModelRegistrationForAuth(ctx, original)
+			expected := 1
+			if mutate {
+				expected = 2
+			}
+			if calls != expected || len(GlobalModelRegistry().GetModelsForClient(original.ID)) != 0 {
+				t.Fatalf("wrong bounded outcome: calls=%d", calls)
+			}
+		})
+	}
+}
+
+func TestHiRouteCodexRegistrationDoesNotFollowRevokedOrReplacedAccount(t *testing.T) {
+	for _, action := range []string{"removed", "disabled", "no-access", "replaced"} {
+		t.Run(action, func(t *testing.T) {
+			manager := coreauth.NewManager(nil, nil, nil)
+			original, err := manager.Register(context.Background(), &coreauth.Auth{ID: "revoke-" + action, Provider: "codex", Metadata: map[string]any{"access_token": "test-access", "hiroute_client_version": "0.999.0"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer GlobalModelRegistry().UnregisterClient(original.ID)
+			service := &Service{cfg: &config.Config{}, coreManager: manager}
+			calls := 0
+			ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				current, _ := manager.GetByID(original.ID)
+				switch action {
+				case "removed":
+					manager.Remove(context.Background(), original.ID)
+				case "replaced":
+					manager.Remove(context.Background(), original.ID)
+					if _, err := manager.Register(context.Background(), current); err != nil {
+						t.Fatal(err)
+					}
+				default:
+					if action == "disabled" {
+						current.Disabled = true
+					} else {
+						delete(current.Metadata, "access_token")
+					}
+					if _, err := manager.Update(context.Background(), current); err != nil {
+						t.Fatal(err)
+					}
+				}
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"models":[{"slug":"stale"}]}`)), Request: r}, nil
+			}))
+			service.completeModelRegistrationForAuth(ctx, original)
+			if calls != 1 || len(GlobalModelRegistry().GetModelsForClient(original.ID)) != 0 {
+				t.Fatal("followed revoked/replaced authorization or introduced static fallback")
+			}
+		})
+	}
+}
+
+func TestHiRouteCodexRegistrationPendingIncludesQueuedWork(t *testing.T) {
+	manager := coreauth.NewManager(nil, nil, nil)
+	original, err := manager.Register(context.Background(), &coreauth.Auth{ID: "queued-registration", Provider: "codex", Prefix: "subscription", Metadata: map[string]any{"access_token": "synthetic-access", "hiroute_client_version": "0.999.0"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer GlobalModelRegistry().UnregisterClient(original.ID)
+	prior := modeldiscovery.Begin(original.ID)
+	prior.Enter(modeldiscovery.Request)
+	prior.End(modeldiscovery.Failed, modeldiscovery.Timeout)
+	next, _ := manager.GetByID(original.ID)
+	next, err = manager.Update(context.Background(), next)
+	if err != nil {
+		t.Fatal(err)
+	}
+	service := &Service{cfg: &config.Config{}, coreManager: manager}
+	service.cfg.ForceModelPrefix = true
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"models":[{"slug":"current-model"}]}`)), Request: r}, nil
+	}))
+	service.authUpdateMu.Lock()
+	started, finished := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(finished)
+		close(started)
+		service.handleAuthUpdate(ctx, watcher.AuthUpdate{Action: watcher.AuthUpdateActionModify, ID: next.ID, Auth: next})
+	}()
+	<-started
+	deadline := time.Now().Add(time.Second)
+	for !modeldiscovery.Read(original.ID).RegistrationPending && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	var models []*ModelInfo
+	blocked := modeldiscovery.ReadCatalog(original.ID, func() { models = GlobalModelRegistry().GetModelsForClient(original.ID) })
+	service.authUpdateMu.Unlock()
+	select {
+	case <-finished:
+	case <-time.After(2 * time.Second):
+		t.Fatal("queued registration did not finish")
+	}
+	if len(models) != 0 || !blocked.RegistrationPending || blocked.Latest == nil || blocked.Latest.Outcome != modeldiscovery.Failed {
+		t.Fatal("accepted update waiting for the lock looked terminal")
+	}
+	recovered := GlobalModelRegistry().GetModelsForClient(original.ID)
+	if len(recovered) != 1 || recovered[0].ID != "subscription/current-model" || modeldiscovery.Read(original.ID).RegistrationPending {
+		t.Fatal("queued registration did not recover and clear pending state")
+	}
+}

+					err = errStream
+					if result != nil {
+						for range result.Chunks {
+						}
+					}
+				} else {
+					_, err = m.Execute(ctx, []string{"codex"}, coreexecutor.Request{Model: model}, opts)
+				}
+				if (err == nil) != (mode == "managed") {
+					t.Fatalf("stream=%t mode=%s err=%v", stream, mode, err)
+				}
+				calls := executor.ExecuteCalls()
+				if stream {
+					calls = executor.StreamCalls()
+				}
+				wantCalls, wantRefresh, wantTrace := 2, 1, "v2;0;0;1;1;0;-;-"
+				if mode == "borrowed" {
+					wantCalls, wantRefresh, wantTrace = 1, 0, "v2;0;0;0;0;0;-;-"
+				}
+				if len(calls) != wantCalls || executor.RefreshCalls() != wantRefresh || trace.Header() != wantTrace {
+					t.Fatalf("stream=%t calls=%v refresh=%d trace=%q", stream, calls, executor.RefreshCalls(), trace.Header())
+				}
+				for _, id := range calls {
+					if id != primary.ID {

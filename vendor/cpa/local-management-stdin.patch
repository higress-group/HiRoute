+	"github.com/router-for-me/CLIProxyAPI/v8/internal/modeldiscovery"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestHiRouteDiscoveryExistingManagementResponseResolvesFileName(t *testing.T) {
+	manager := coreauth.NewManager(nil, nil, nil)
+	a := &coreauth.Auth{ID: "private/internal/account", FileName: "private-file.json", Provider: "codex"}
+	if _, err := manager.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	trace := modeldiscovery.Begin(a.ID)
+	trace.Enter(modeldiscovery.ClientVersion)
+	trace.End(modeldiscovery.Failed, modeldiscovery.ClientVersionUnavailable)
+	done := modeldiscovery.Registering(a.ID)
+	defer done()
+	handler := NewHandlerWithoutConfigFilePath(&config.Config{}, manager)
+	recorder := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(recorder)
+	ctx.Request = httptest.NewRequest("GET", "/v0/management/auth-files/models?name=private-file.json", nil)
+	handler.GetAuthFileModels(ctx)
+	var response struct {
+		Models    []any                   `json:"models"`
+		Discovery modeldiscovery.Snapshot `json:"hiroute_model_discovery"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	if recorder.Code != 200 || response.Models == nil || !response.Discovery.RegistrationPending || response.Discovery.FirstFailure == nil || response.Discovery.FirstFailure.Reason != modeldiscovery.ClientVersionUnavailable {
+		t.Fatalf("missing observation: %+v", response)
+	}
+	for _, private := range []string{a.ID, a.FileName, "access_token"} {
+		if strings.Contains(recorder.Body.String(), private) {
+			t.Fatal("private diagnostic material")
+		}
+	}
+}

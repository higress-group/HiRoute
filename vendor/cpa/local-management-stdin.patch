+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+func TestHiRouteBrowserCallbackValidationAndOneUse(t *testing.T) {
+	for _, provider := range []string{"codex", "anthropic"} {
+		t.Run(provider, func(t *testing.T) {
+			dir, state := t.TempDir(), "hiroute-validation-"+provider
+			RegisterOAuthSession(state, provider)
+			defer CancelOAuthSession(state)
+			path := "/auth/callback"
+			if provider == "anthropic" {
+				path = "/callback"
+			}
+			handler := hiRouteCallbackHandler(1455, provider, state, dir)
+			valid := path + "?state=" + state + "&code=private-test-code"
+			for _, input := range []struct{ method, path, host string }{
+				{"GET", path + "?state=foreign&code=private-test-code", "localhost:1455"},
+				{"GET", valid + "&state=" + state, "localhost:1455"},
+				{"GET", valid + "&code=second", "localhost:1455"},
+				{"GET", valid + "&error=denied", "localhost:1455"},
+				{"GET", path + "?state=" + state, "localhost:1455"},
+				{"GET", valid + "&bad=%ZZ", "localhost:1455"},
+				{"GET", valid, "foreign.test:1455"},
+				{"POST", valid, "localhost:1455"},
+				{"GET", "/foreign?state=" + state + "&code=test", "localhost:1455"},
+			} {
+				r := httptest.NewRequest(input.method, "http://localhost:1455"+input.path, nil)
+				r.Host = input.host
+				w := httptest.NewRecorder()
+				handler.ServeHTTP(w, r)
+				if w.Code != http.StatusBadRequest {
+					t.Fatalf("invalid callback accepted: %d", w.Code)
+				}
+				if strings.Contains(w.Body.String(), "private-test-code") || w.Header().Get("Location") != "" {
+					t.Fatal("callback escaped through response")
+				}
+			}
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, httptest.NewRequest("GET", "http://localhost:1455"+valid, nil))
+			if w.Code != 200 || !strings.Contains(w.Body.String(), "Authorization received") || strings.Contains(w.Body.String(), "successful") {
+				t.Fatal("browser reception claimed login success")
+			}
+			if w.Header().Get("Referrer-Policy") != "no-referrer" || w.Header().Get("Cache-Control") != "no-store" {
+				t.Fatal("callback page did not protect the query")
+			}
+			file := filepath.Join(dir, ".oauth-"+provider+"-"+state+".oauth")
+			if err := os.Remove(file); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := WriteOAuthCallbackFileForPendingSession(dir, provider, state, "replacement", ""); err == nil {
+				t.Fatal("manual input overwrote a consumed browser callback")
+			}
+			w = httptest.NewRecorder()
+			handler.ServeHTTP(w, httptest.NewRequest("GET", "http://localhost:1455"+valid, nil))
+			if w.Code != http.StatusConflict {
+				t.Fatal("repeated browser callback accepted")
+			}
+		})
+	}
+}

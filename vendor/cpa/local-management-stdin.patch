+func TestHiRouteExecutionRecoveryUsesPinnedAuthAndCannotLoop(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		for _, mode := range []string{"managed", "borrowed", "invalid_after_refresh"} {
+			t.Run(mode, func(t *testing.T) {
+				m, executor, primary, _, model := newUnauthorizedRefreshFixture(t, false)
+				m.SetRetryConfig(0, 0, 1)
+				if mode == "borrowed" {
+					delete(primary.Metadata, "refresh_token")
+					if _, err := m.Update(context.Background(), primary); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if mode == "invalid_after_refresh" {
+					executor.refreshTokens[primary.ID] = "still-invalid-token"
+					executor.tokenInvalid["still-invalid-token"] = struct{}{}
+				}
+				ctx, trace := coreexecutor.WithHiRouteExecution(context.Background())
+				opts := coreexecutor.Options{Metadata: map[string]any{coreexecutor.PinnedAuthMetadataKey: primary.ID}}
+				var err error
+				if stream {
+					result, errStream := m.ExecuteStream(ctx, []string{"codex"}, coreexecutor.Request{Model: model}, opts)
+					err = errStream
+					if result != nil {
+						for range result.Chunks {
+						}
+					}
+				} else {
+					_, err = m.Execute(ctx, []string{"codex"}, coreexecutor.Request{Model: model}, opts)
+				}
+				if (err == nil) != (mode == "managed") {
+					t.Fatalf("stream=%t mode=%s err=%v", stream, mode, err)
+				}
+				calls := executor.ExecuteCalls()
+				if stream {
+					calls = executor.StreamCalls()
+				}
+				wantCalls, wantRefresh, wantTrace := 2, 1, "v1;0;0;1;1"
+				if mode == "borrowed" {
+					wantCalls, wantRefresh, wantTrace = 1, 0, "v1;0;0;0;0"
+				}
+				if len(calls) != wantCalls || executor.RefreshCalls() != wantRefresh || trace.Header() != wantTrace {
+					t.Fatalf("stream=%t calls=%v refresh=%d trace=%q", stream, calls, executor.RefreshCalls(), trace.Header())
+				}
+				for _, id := range calls {
+					if id != primary.ID {
+						t.Fatalf("cross-account execution %q", id)
+					}
+				}
+				// This fixture has no HTTP transport. Do not invent wire counts.
+			})
+		}
+	}
+}
+
+func TestHiRouteCanceledRefreshWaiterDoesNotRefresh(t *testing.T) {
+	m, executor, primary, _, _ := newUnauthorizedRefreshFixture(t, false)
+	lock := &authRefreshLock{}
+	lock.mu.Lock()
+	m.refreshLocks.Store(primary.ID, lock)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { _, err := m.refreshAuthForRequest(ctx, primary.ID, "stale-access-token"); done <- err }()
+	cancel()
+	lock.mu.Unlock()
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("refresh error=%v", err)
+	}
+	if got := executor.RefreshCalls(); got != 0 {
+		t.Fatalf("canceled refresh calls=%d", got)
+	}
+}
+
+type hiRouteCommittedStreamExecutor struct{ *unauthorizedRefreshExecutor }
+
+func (e *hiRouteCommittedStreamExecutor) ExecuteStream(_ context.Context, auth *Auth, _ coreexecutor.Request, _ coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	e.mu.Lock()
+	e.streamCalls = append(e.streamCalls, auth.ID)
+	e.mu.Unlock()
+	chunks := make(chan coreexecutor.StreamChunk, 2)
+	chunks <- coreexecutor.StreamChunk{Payload: []byte("data: accepted\n\n")}
+	chunks <- coreexecutor.StreamChunk{Err: &Error{HTTPStatus: http.StatusUnauthorized, Message: "fixture stream failure"}}
+	close(chunks)
+	return &coreexecutor.StreamResult{Headers: http.Header{}, Chunks: chunks}, nil
+}
+
+func TestHiRouteStreamAfterPayloadCannotRefreshOrReplay(t *testing.T) {
+	m, executor, primary, _, model := newUnauthorizedRefreshFixture(t, false)
+	m.SetRetryConfig(0, 0, 1)
+	m.RegisterExecutor(&hiRouteCommittedStreamExecutor{executor})
+	ctx, trace := coreexecutor.WithHiRouteExecution(context.Background())
+	result, err := m.ExecuteStream(ctx, []string{"codex"}, coreexecutor.Request{Model: model},
+		coreexecutor.Options{Metadata: map[string]any{coreexecutor.PinnedAuthMetadataKey: primary.ID}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	payloads, failures := 0, 0
+	for chunk := range result.Chunks {
+		if len(chunk.Payload) != 0 {
+			payloads++
+		}
+		if chunk.Err != nil {
+			failures++
+		}
+	}
+	if payloads != 1 || failures != 1 || len(executor.StreamCalls()) != 1 || executor.RefreshCalls() != 0 || trace.Header() != "v1;0;0;0;0" {
+		t.Fatalf("payloads=%d failures=%d calls=%v refresh=%d trace=%s", payloads, failures, executor.StreamCalls(), executor.RefreshCalls(), trace.Header())
+	}
+}
diff --git a/sdk/cliproxy/executor/hiroute_execution.go b/sdk/cliproxy/executor/hiroute_execution.go
new file mode 100644
index 0000000..f896ccb
--- /dev/null
+++ b/sdk/cliproxy/executor/hiroute_execution.go
@@ -0,0 +1,104 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"sync"
+)
+
+// HiRouteExecutionHeader is a package-private bridge contract. It contains only
+// bounded counts, never account identifiers, credentials, usage or provider text.
+const HiRouteExecutionHeader = "X-Hiroute-Cpa-Execution"
+
+type hiRouteExecutionKey struct{}
+
+type HiRouteExecution struct {
+	mu                    sync.Mutex
+	inferenceAttempts     uint32
+	unauthorizedResponses uint32
+	authRecoveryAttempts  uint32
+	authRecoverySuccesses uint32
+	overflow              bool
+}
+
+// WithHiRouteExecution owns one downstream HTTP call across auth-manager child
+// contexts. OAuth refresh and account discovery do not use the inference hook.
+func WithHiRouteExecution(ctx context.Context) (context.Context, *HiRouteExecution) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if value, ok := ctx.Value(hiRouteExecutionKey{}).(*HiRouteExecution); ok && value != nil {
+		return ctx, value
+	}
+	trace := &HiRouteExecution{}
+	return trace.Context(ctx), trace
+}
+
+// Context keeps a request's existing trace without replacing the new caller's
+// deadline or cancellation parent when a handler creates another child context.
+func (t *HiRouteExecution) Context(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, hiRouteExecutionKey{}, t)
+}
+
+func hiRouteExecutionFrom(ctx context.Context) *HiRouteExecution {
+	if ctx == nil {
+		return nil
+	}
+	trace, _ := ctx.Value(hiRouteExecutionKey{}).(*HiRouteExecution)
+	return trace
+}
+
+func (t *HiRouteExecution) increment(value *uint32) {
+	// The wire contract never allocates per attempt. Exceeding this observation
+	// bound is explicit unknown, not a fabricated/clamped attempt count.
+	if *value >= 32 {
+		t.overflow = true
+		return
+	}
+	*value++
+}
+
+// HiRouteInferenceStarted is called at the actual HTTP RoundTrip boundary,
+// rather than MarkUpstreamAttempt, which can run more than once per wire send.
+func HiRouteInferenceStarted(ctx context.Context) {
+	if trace := hiRouteExecutionFrom(ctx); trace != nil {
+		trace.mu.Lock()
+		defer trace.mu.Unlock()
+		trace.increment(&trace.inferenceAttempts)
+	}
+}
+
+func HiRouteInferenceResponse(ctx context.Context, status int) {
+	if status != 401 {
+		return
+	}
+	if trace := hiRouteExecutionFrom(ctx); trace != nil {
+		trace.mu.Lock()
+		defer trace.mu.Unlock()
+		trace.increment(&trace.unauthorizedResponses)
+	}
+}
+
+func HiRouteAuthRecovery(ctx context.Context, success bool) {
+	if trace := hiRouteExecutionFrom(ctx); trace != nil {
+		trace.mu.Lock()
+		defer trace.mu.Unlock()
+		if success {
+			trace.increment(&trace.authRecoverySuccesses)
+		} else {
+			trace.increment(&trace.authRecoveryAttempts)
+		}
+	}
+}
+
+func (t *HiRouteExecution) Header() string {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.overflow {
+		return "v1;unknown"
+	}
+	return fmt.Sprintf("v1;%d;%d;%d;%d", t.inferenceAttempts, t.unauthorizedResponses, t.authRecoveryAttempts, t.authRecoverySuccesses)
+}

+func TestHiRouteExecutionRecoveryUsesPinnedAuthAndCannotLoop(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		for _, mode := range []string{"managed", "borrowed", "invalid_after_refresh"} {
+			t.Run(mode, func(t *testing.T) {
+				m, executor, primary, _, model := newUnauthorizedRefreshFixture(t, false)
+				m.SetRetryConfig(0, 0, 1)
+				if mode == "borrowed" {

+package cliproxy
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+type discoveryTransport func(*http.Request) (*http.Response, error)
+
+func (f discoveryTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestCodexDiscoveryRegistration(t *testing.T) {
+	s := &Service{cfg: &config.Config{}}
+	s.cfg.ForceModelPrefix = true
+	a := &coreauth.Auth{ID: "discovery-account", Provider: "codex", Prefix: "subscription", Metadata: map[string]any{"access_token": "test-token", "account_id": "test-account", "hiroute_client_version": "0.999.0"}, Attributes: map[string]string{"excluded_models": "excluded"}}
+	defer GlobalModelRegistry().UnregisterClient(a.ID)
+	status, body := 200, `{"models":[{"slug":"future-model-not-in-bundle","display_name":"Future","context_window":123456,"input_modalities":["text","image"],"supported_reasoning_levels":[{"effort":"max"}]},{"slug":"excluded"}]}`
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", discoveryTransport(func(r *http.Request) (*http.Response, error) {
+		if r.URL.String() != "https://chatgpt.com/backend-api/codex/models?client_version=0.999.0" || r.Header.Get("Authorization") != "Bearer test-token" || r.Header.Get("ChatGPT-Account-ID") != "test-account" {
+			t.Fatal("wrong discovery request")
+		}
+		if _, ok := r.Context().Deadline(); !ok {
+			t.Fatal("missing deadline")
+		}
+		return &http.Response{StatusCode: status, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	}))
+	s.registerModelsForAuth(ctx, a)
+	check := func() {
+		t.Helper()
+		models := GlobalModelRegistry().GetModelsForClient(a.ID)
+		if len(models) != 1 || models[0].ID != "subscription/future-model-not-in-bundle" || models[0].ContextLength != 123456 || models[0].Thinking.Levels[0] != "max" {
+			t.Fatalf("unexpected registered models: %+v", models)
+		}
+	}
+	check()
+	for _, failure := range []struct {
+		status int
+		body   string
+	}{{401, `secret upstream error`}, {200, `{broken`}, {200, `{}`}, {200, `{"models":[{"slug":""}]}`}} {
+		status, body = failure.status, failure.body
+		s.registerModelsForAuth(ctx, a)
+		check()
+	}
+	status, body = 200, `{"models":[]}`
+	s.registerModelsForAuth(ctx, a)
+	if len(GlobalModelRegistry().GetModelsForClient(a.ID)) != 0 {
+		t.Fatal("empty authoritative list did not remove models")
+	}
+	status, body = 200, `{"models":[{"slug":"other-account-model"}]}`
+	a.ID, a.Prefix = "other-account", "other"
+	defer GlobalModelRegistry().UnregisterClient(a.ID)
+	s.registerModelsForAuth(ctx, a)
+	if len(GlobalModelRegistry().GetModelsForClient("discovery-account")) != 0 {
+		t.Fatal("cross-account catalog leakage")
+	}
+}

+func TestHiRouteCodexBrowserCompletionAndPortRelease(t *testing.T) {
+	service := &hiRouteCountedCodexService{}
+	original := newCodexOAuthService
+	newCodexOAuthService = func(*config.Config) codexOAuthService { return service }
+	defer func() { newCodexOAuthService = original }()
+	dir := t.TempDir()
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: dir, Port: 47111}, nil)
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest("GET", "/auth-url?is_webui=true", nil)
+	h.RequestCodexToken(c)
+	var login map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &login); err != nil {
+		t.Fatal(err)
+	}
+	defer CancelOAuthSession(login["state"])
+	if w.Code != 200 || login["hiroute_callback_mode"] != "automatic" {
+		t.Fatal("browser callback listener did not start")
+	}
+	client := &http.Client{Transport: &http.Transport{Proxy: nil}, Timeout: 3 * time.Second}
+	defer client.CloseIdleConnections()
+	response, err := client.Get("http://localhost:1455/auth/callback?state=" + login["state"] + "&code=hiroute-test-code")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := io.ReadAll(response.Body)
+	_ = response.Body.Close()
+	if response.StatusCode != 200 || strings.Contains(string(body), "successful") || strings.Contains(string(body), "hiroute-test-code") {
+		t.Fatal("incorrect browser callback response")
+	}
+	waitForOAuthSessionDone(t, login["state"])
+	if service.exchanges.Load() != 1 {
+		t.Fatal("authorization code exchange was replayed")
+	}
+	files, _ := filepath.Glob(filepath.Join(dir, "*.json"))
+	if len(files) != 1 {
+		t.Fatal("browser callback did not persist exactly one credential")
+	}
+	if _, err := WriteOAuthCallbackFileForPendingSession(dir, "codex", login["state"], "replacement", ""); err == nil {
+		t.Fatal("completed login accepted manual input")
+	}
+	listeners, err := listenHiRouteCallbackLoopback(codexCallbackPort)
+	if err != nil {
+		t.Fatal("completed login retained its callback port")
+	}
+	for _, ln := range listeners {
+		_ = ln.Close()
+	}
+}

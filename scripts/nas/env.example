# HiRoute version (must match the ARCHIVE file below).
HIROUTE_VERSION=0.6.4

# Verified standalone archive for this version and architecture, placed in this
# folder. update.sh refreshes these four values automatically; replace the
# x86_64 archive name and digests when you run on an ARM64 host.
ARCHIVE=hiroute-0.6.4-faf7a98a4443-x86_64-unknown-linux-gnu.tar.gz
ARCHIVE_SHA256=07c0c14d5b26f6688569bee378077d15950ce79429d0377d1cf2166d152ed084
CPA_SHA256=c86a44fa7ce60d7eeda9c666f36f052b03ee3e50e3474d8263eb03e22bc95a98

# Web console exposure.
#   network  - listen on 0.0.0.0 and print a host-address login URL (needs ADVERTISE_ADDRESS)
#   loopback - 127.0.0.1 only; reach it with an SSH tunnel
#   off      - no web console; use the CLI only
CONSOLE_MODE=network
CONSOLE_PORT=5838

# Host LAN address used in the one-time console login URL (required for network
# mode). Use an address the client browser can reach.
ADVERTISE_ADDRESS=192.0.2.10

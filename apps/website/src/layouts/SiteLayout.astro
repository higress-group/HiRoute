---
import '../styles/site.css';
import { localePath } from '../lib/locale.mjs';
import { GITHUB_URL as githubUrl, jsonLd } from '../lib/seo.mjs';
const {
  language = 'zh', title, description, path = '/zh/', alternatePath = '/en/',
  fullWidth = false, indexable = true, ogType = 'website', publishedTime, modifiedTime,
  structuredData = [],
} = Astro.props;
const english = language === 'en';
const canonical = new URL(path, Astro.site);
const zhPath = english ? alternatePath : path;
const enPath = english ? path : alternatePath;
// One zh/en pair per page. English serves readers whose language matches neither;
// Chinese stays a language-only tag so every Chinese locale reaches the Chinese page.
const zhUrl = new URL(zhPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
const home = localePath(language);
const nav = (english ? [
  ['Product', '#product'], ['Docs', 'docs/'], ['Articles', 'news/'], ['Download', 'download/'],
] : [
  ['产品', '#product'], ['文档', 'docs/'], ['文章', 'news/'], ['下载', 'download/'],
]).map(([label, target]) => [label, home + target]);
---
<!doctype html>
<html lang={english ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8">
    <script is:inline src="/scripts/language.js"></script>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'}>
    <meta name="theme-color" content="#F7F8FA">
    {indexable && <>
      <link rel="canonical" href={canonical}>
      <link rel="alternate" hreflang="zh" href={zhUrl}>
      <link rel="alternate" hreflang="en" href={enUrl}>
      <link rel="alternate" hreflang="x-default" href={enUrl}>
    </>}
    <link rel="icon" type="image/png" sizes="1024x1024" href="/brand/app-icon.png">
    <link rel="apple-touch-icon" href="/brand/app-icon.png">
    <meta property="og:type" content={ogType}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="HiRoute">
    <meta property="og:locale" content={english ? 'en_US' : 'zh_CN'}>
    <meta property="og:locale:alternate" content={english ? 'zh_CN' : 'en_US'}>
    {publishedTime && <meta property="article:published_time" content={publishedTime}>}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
    <meta property="og:image" content={new URL(`/brand/social-card-${english ? 'en' : 'zh'}.png`, Astro.site)}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="640">
    <meta property="og:image:alt" content={english ? 'HiRoute: pay for your strongest model only where the work needs it' : 'HiRoute：只在需要的地方，为最强的模型付费'}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={new URL(`/brand/social-card-${english ? 'en' : 'zh'}.png`, Astro.site)}>
    <meta name="twitter:description" content={description}>
    {structuredData.map(data => <script is:inline type="application/ld+json" set:html={jsonLd(data)} />)}
  </head>
  <body>
    <header class="header wrap site-header">
      <a class="wordmark" href={home} aria-label="HiRoute home">
        <img class="brand-symbol" src="/brand/mark-switch.svg" alt="">
        <img class="brand-lettering" src="/brand/wordmark.svg" alt="HiRoute">
      </a>
      <nav class="nav" aria-label={english ? 'Primary navigation' : '主要导航'}>
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="nav-github" href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <div class="language-switch" aria-label={english ? 'Language' : '语言'}>
          <a data-language lang="zh-CN" hreflang="zh-CN" href={zhPath} aria-current={!english ? 'page' : undefined}>中文</a>
          <a data-language lang="en" hreflang="en" href={enPath} aria-current={english ? 'page' : undefined}>EN</a>
        </div>
      </nav>
    </header>
    <main class:list={{ 'site-main': !fullWidth }}><slot /></main>
    <footer class="footer wrap">
      <a class="wordmark" href={home}>
        <img class="brand-symbol" src="/brand/mark-switch.svg" alt="">
        <img class="brand-lettering" src="/brand/wordmark.svg" alt="HiRoute">
      </a>
      <p>{english ? 'Intelligent routing for long-horizon agents.' : '面向长程 Agent 的智能路由引擎。'}</p>
      <div class="footer-links">
        <a href={`${home}news/`}>{english ? 'Articles' : '文章'}</a>
        <a href={`${home}docs/`}>{english ? 'Docs' : '文档'}</a>
        <a href={`${home}changelog/`}>{english ? 'Changelog' : '更新日志'}</a>
        <a href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>

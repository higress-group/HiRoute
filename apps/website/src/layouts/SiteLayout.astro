---
import '../styles/site.css';
const {
  language = 'zh', title, description, path = '/', alternatePath = '/en/',
  fullWidth = false,
} = Astro.props;
const english = language === 'en';
const githubUrl = 'https://github.com/higress-group/HiRoute';
const canonical = new URL(path, Astro.site);
const alternate = new URL(alternatePath, Astro.site);
const zhPath = english ? alternatePath : path;
const enPath = english ? path : alternatePath;
const nav = english ? [
  ['Product', '/en/#product'], ['How it works', '/en/#boundaries'],
  ['Docs', '/en/docs/'], ['Decision extensions', '/en/docs/decision-extensions/'], ['Download', '/en/download/'],
] : [
  ['产品', '/#product'], ['如何工作', '/#boundaries'],
  ['文档', '/docs/'], ['决策扩展', '/docs/decision-extensions/'], ['下载', '/download/'],
];
---
<!doctype html>
<html lang={english ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8">
    <script is:inline src="/scripts/language.js"></script>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta name="theme-color" content="#F7F8FA">
    <link rel="canonical" href={canonical}>
    <link rel="alternate" hreflang="zh-CN" href={english ? alternate : canonical}>
    <link rel="alternate" hreflang="en" href={english ? canonical : alternate}>
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)}>
    <link rel="icon" type="image/png" sizes="1024x1024" href="/brand/app-icon.png">
    <link rel="apple-touch-icon" href="/brand/app-icon.png">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="HiRoute">
    <meta property="og:image" content={new URL('/brand/app-icon.png', Astro.site)}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1024">
    <meta property="og:image:height" content="1024">
    <meta property="og:image:alt" content="HiRoute logo">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:image" content={new URL('/brand/app-icon.png', Astro.site)}>
    <meta name="twitter:description" content={description}>
  </head>
  <body>
    <header class="header wrap site-header">
      <a class="wordmark" href={english ? '/en/' : '/'} aria-label="HiRoute home">
        <img class="brand-symbol" src="/brand/mark-switch.svg" alt="">
        <img class="brand-lettering" src="/brand/wordmark.svg" alt="HiRoute">
      </a>
      <nav class="nav" aria-label={english ? 'Primary navigation' : '主要导航'}>
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="nav-github" href={githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <div class="language-switch" aria-label={english ? 'Language' : '语言'}>
          <a data-language lang="zh-CN" hreflang="zh-CN" href={zhPath} aria-current={!english ? 'page' : undefined}>中文</a>
          <a data-language lang="en" hreflang="en" href={enPath} aria-current={english ? 'page' : undefined}>EN</a>
        </div>
      </nav>
    </header>
    <main class:list={{ 'site-main': !fullWidth }}><slot /></main>
    <footer class="footer wrap">
      <a class="wordmark" href={english ? '/en/' : '/'}>
        <img class="brand-symbol" src="/brand/mark-switch.svg" alt="">
        <img class="brand-lettering" src="/brand/wordmark.svg" alt="HiRoute">
      </a>
      <p>{english ? 'Intelligent routing for long-horizon agents.' : '面向长程 Agent 的智能路由引擎。'}</p>
      <div class="footer-links">
        <a href={english ? '/en/docs/' : '/docs/'}>{english ? 'Docs' : '文档'}</a>
        <a href={english ? '/en/changelog/' : '/changelog/'}>{english ? 'Changelog' : '更新日志'}</a>
        <a href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>

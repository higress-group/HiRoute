---
import SiteLayout from '../layouts/SiteLayout.astro';
import DocsNav from './DocsNav.astro';
import { guidePages, guideRoute, renderUserGuide } from '../lib/user-guides.mjs';
import { localePath } from '../lib/locale.mjs';
import { breadcrumbs } from '../lib/seo.mjs';
const { language = 'zh', guide } = Astro.props;
const en = language === 'en';
const page = guidePages[guide];
const title = page.title[language].includes('HiRoute') ? page.title[language] : `${page.title[language]} · HiRoute`;
const path = guideRoute(guide, language);
const alternatePath = guideRoute(guide, en ? 'zh' : 'en');
const html = await renderUserGuide(guide, language);
const trail = [['HiRoute', localePath(language)], [en ? 'Docs' : '文档', guideRoute('quickstart', language)]];
if (guide !== 'quickstart') trail.push([page[language], path]);
---
<SiteLayout language={language} title={title} description={page.description[language]}
  path={path} alternatePath={alternatePath} structuredData={[breadcrumbs(trail)]}>
  <div class="docs-shell wrap">
    <DocsNav language={language} active={guide} />
    <article class="docs-content" set:html={html} />
  </div>
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import { artifactUrl, formatBytes, latestRelease } from '../lib/releases.mjs';
const { language = 'zh' } = Astro.props;
const en = language === 'en';
const t = (zh, english) => en ? english : zh;
const path = en ? '/en/' : '/';
const alternatePath = en ? '/' : '/en/';
const release = latestRelease('stable');
const preferredArtifact = release?.artifacts.find(item => item.kind === 'desktop' && item.architecture === 'arm64')
  ?? release?.artifacts.find(item => item.kind === 'desktop');
const linuxArtifact = release?.artifacts.find(item => item.kind === 'standalone');
const releaseKinds = [preferredArtifact && t('macOS 桌面应用', 'macOS Desktop'), linuxArtifact && t('Linux 无界面版', 'Linux headless')].filter(Boolean).join(' / ');
---
<SiteLayout language={language}
  title={t('HiRoute · 长程 Agent 智能路由引擎', 'HiRoute · Intelligent routing for long-horizon agents')}
  description="Intelligent routing for long-horizon agents. Match models to each stage with Jev, balancing quality and cost."
  path={path} alternatePath={alternatePath} fullWidth>
  <section class="hero wrap">
    <div>
      <div class="eyebrow section-label">{t('面向长程 Agent 的智能路由', 'Intelligent routing for long-horizon agents.')}</div>
      <h1>{en ? <><span>Intelligent routing</span><span>for long-horizon agents.</span></> : <><span>为长程 Agent 而生的</span><span>智能路由引擎。</span></>}</h1>
      <p class="intro">{t('一段长任务，不必始终依赖同一个模型。按任务选择 Agent，再根据执行表现与后续工作的需要，决定继续使用还是切换模型。', 'A long task need not rely on one model from start to finish. Match the agent to the task, then choose the right model for each stage—guided by past performance and the work ahead.')}</p>
      <a class="jev-callout" href="#how"><strong>Jev</strong><span>{t('官方决策扩展 · 一次调用，选择与评分', 'Official extension · One call to choose and assess')}</span><span aria-hidden="true">↗</span></a>
      <div class="actions"><a class="button" href={en ? '/en/download/' : '/download/'}>{t('下载 HiRoute', 'Download HiRoute')} <span>↗</span></a><a class="button outline" href="#boundaries">{t('了解路由机制', 'Explore routing')} <span>↓</span></a></div>
      <p class="small-note">{t('开发、研究、分析与自动化。保留惯用工作流，按需投入算力。', 'Code, research, analysis, and automation. Keep your workflow and spend compute where it counts.')}</p>
    </div>
    <div class="journey-art" aria-label={t('一个长任务中的模型路由示意', 'Model routing across one long task')}>
      <div class="journey-heading"><img src="/brand/mark-switch.svg" alt=""><span>{t('一个任务，多次恰当选择', 'One task. The right model at each stage.')}</span></div>
      <div class="journey-goal"><span>{t('任务目标', 'THE GOAL')}</span><strong>{t('从想法，到可验证的结果。', 'From an idea to a verified result.')}</strong></div>
      <div class="journey-stage economy"><span class="journey-dot"></span><div><small>{t('阶段 01 · 明确、局部的工作', 'STAGE 01 · BOUNDED WORK')}</small><h3>{t('经济模型，持续推进', 'Economy model, steady progress')}</h3><p>{t('理解问题 → 调用工具 → 验证结果', 'Understand → Use tools → Verify')}</p><div class="prefix-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="journey-cache">{t('阶段内持续复用前缀', 'Reuse the prefix throughout the stage')}</span></div></div>
      <a class="journey-pivot" href="#how"><span>↻</span><div><strong>{t('上下文压缩 · 重新判断', 'Context compaction · Reassess')}</strong><small>{t('回看执行表现，判断后续工作', 'Assess past performance and the work ahead')}</small></div><b>↗</b></a>
      <div class="journey-stage primary"><span class="journey-dot"></span><div><small>{t('阶段 02 · 更深入的推理', 'STAGE 02 · DEEPER REASONING')}</small><h3>{t('主力模型，接续完成', 'Primary model, take it further')}</h3><p>{t('分析难点 → 完成实现 → 检查交付', 'Reason → Implement → Check the result')}</p><div class="prefix-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div><span class="journey-cache">{t('重建新前缀，随后持续复用', 'Build a new prefix, then keep reusing it')}</span></div></div>
      <p class="journey-footnote">{t('机制示例 · 重新判断也可以继续原模型', 'Illustration · Reassessment can also keep the same model')}</p>
    </div>
  </section>
  <div class="trust-line wrap"><span><b>{t('更省', 'Efficient')}</b> · {t('按需投入算力', 'Compute where it counts')}</span><span><b>{t('更稳', 'Reliable')}</b> · {t('有边界地接力', 'Bounded failover')}</span><span><b>{t('更懂', 'Adaptive')}</b> · {t('用执行事实改进选择', 'Decisions grounded in execution')}</span></div>

  <section class="section wrap lifecycle-section" id="boundaries">
    <div class="section-title"><div><div class="eyebrow section-label">{t('长任务不只做一次模型选择', 'A long task is not one model choice')}</div><h2>{t('阶段内保持稳定，', 'Stay stable within a stage.')}<br>{t('在自然边界重新选择。', 'Choose again at natural boundaries.')}</h2></div><p>{t('不必等用户再次提问。长会话压缩并重建上下文时，也能成为重新选模的自然机会；普通工具续轮保持当前模型。', 'A new user prompt is not the only boundary. When a long session compacts and rebuilds its context, HiRoute gets another natural chance to choose; ordinary tool continuations stay on the current model.')}</p></div>
    <div class="timeline-legend"><span class="legend-economy">{t('经济模型', 'Economy model')}</span><span class="legend-primary">{t('主力模型', 'Primary model')}</span><span>{t('选择决策节点查看接续方式 · 机制示例', 'Select a decision point to inspect the handoff · Illustration')}</span></div>
    <div class="timeline-grid">
      <div class="turn-caption turn-one">{t('用户提出目标 → Agent 自主推进', 'User sets the goal → Agent works autonomously')}<span>{t('同一个用户任务可以跨多个路由执行轮次', 'One user task can span multiple routing turns')}</span></div>
      <div class="turn-caption turn-two">{t('用户补充反馈 → 继续推进', 'User feedback → Continue')}<span>{t('新输入带来新的决策机会', 'New input creates another decision point')}</span></div>
      <article class="execution-window first-window"><span class="eyebrow">{t('执行轮次 01', 'ROUTING TURN 01')}</span><h3>{t('经济模型 A', 'Economy model A')}</h3><p>{t('处理明确、局部的工作', 'Handles bounded, local work')}</p><div class="tool-steps"><span>{t('回答', 'Answer')}</span><i>→</i><span>{t('工具', 'Tools')}</span><i>→</i><span>{t('继续', 'Continue')}</span></div><div class="cache-ribbon cache-a"><b>{t('A 的前缀持续追加', 'A’s prefix keeps growing')}</b><span>{t('连续工具往返，保持模型稳定', 'Tool round-trips keep the model stable')}</span></div></article>
      <button class="decision-boundary compact-boundary" type="button" data-boundary="compaction" aria-pressed="true" aria-controls="boundary-detail"><span class="boundary-symbol" aria-hidden="true">↻</span><strong>{t('上下文压缩', 'Context compaction')}</strong><span class="boundary-status">{t('重新决策', 'DECIDE AGAIN')}</span><small>{t('回看执行表现', 'Assess prior work')}<br>{t('判断后续工作', 'Judge what comes next')}</small></button>
      <article class="execution-window second-window"><span class="eyebrow">{t('执行轮次 02', 'ROUTING TURN 02')}</span><h3>{t('转交主力模型 B', 'Hand off to primary B')}</h3><p>{t('示例：后续工作需要更强推理', 'Example: the next stage needs deeper reasoning')}</p><div class="tool-steps"><span>{t('回答', 'Answer')}</span><i>→</i><span>{t('工具', 'Tools')}</span><i>→</i><span>{t('继续', 'Continue')}</span></div><div class="cache-ribbon cache-b"><b>{t('在 B 上建立新前缀', 'Build a new prefix on B')}</b><span>{t('利用压缩后的重建时机，再持续复用', 'Switch after compaction, then reuse consistently')}</span></div></article>
      <button class="decision-boundary human-boundary" type="button" data-boundary="human" aria-pressed="false" aria-controls="boundary-detail"><span class="boundary-symbol" aria-hidden="true">＋</span><strong>{t('用户补充反馈', 'User feedback')}</strong><span class="boundary-status">{t('重新决策', 'DECIDE AGAIN')}</span><small>{t('新问题或新要求', 'New question or requirement')}<br>{t('也可以继续原模型', 'The same model may continue')}</small></button>
      <article class="execution-window third-window"><span class="eyebrow">{t('执行轮次 03', 'ROUTING TURN 03')}</span><h3>{t('继续使用模型 B', 'Continue with model B')}</h3><p>{t('示例：表现胜任，接着完成', 'Example: performance is competent')}</p><div class="tool-steps"><span>{t('回答', 'Answer')}</span><i>→</i><span>{t('工具', 'Tools')}</span><i>→</i><span>{t('继续', 'Continue')}</span></div><div class="cache-ribbon cache-b"><b>{t('B 的前缀继续追加', 'B’s prefix keeps growing')}</b><span>{t('重新判断不代表必须切换', 'Reassessment does not force a switch')}</span></div></article>
    </div>
    <div class="boundary-detail" id="boundary-detail" aria-live="polite"><div><span class="detail-kicker" id="boundary-kicker">{t('自主执行中的决策机会', 'A decision point during autonomous work')}</span><h3 id="boundary-title">{t('上下文压缩后，可以重新选择。', 'After context compaction, choose again.')}</h3><p id="boundary-copy">{t('长会话压缩并重建上下文时，可复用前缀本来就会变化。HiRoute 利用这个时机评估上一阶段和后续工作；客户端无需额外识别或上报压缩事件。', 'Compaction rebuilds a long session around a new prefix. HiRoute uses that moment to assess the prior stage and the work ahead; the client does not need to detect or report compaction separately.')}</p></div><div class="boundary-outcome"><span>{t('这一节点的示例', 'At this point')}</span><p><b>{t('评估上一阶段', 'Assess the prior stage')}</b><span id="boundary-assessment">{t('回看模型 A 已完成的执行', 'Assess the work already performed by model A')}</span></p><p><b>{t('选择下一分支', 'Choose the next branch')}</b><span id="boundary-choice">{t('选择主力分支，让模型 B 接续', 'Choose the primary branch; model B takes over')}</span></p></div></div>
  </section>



  <section class="night" id="how"><div class="section wrap jev-section">
    <div class="jev-heading"><div><span class="jev-extension-label">{t('HiRoute 官方决策扩展', 'Official HiRoute decision extension')}</span><h2>{t('Jev，一次判断。', 'Jev. One decision.')}<br><em>{t('回看表现，也看向下一步。', 'Look back. Choose what comes next.')}</em></h2></div><div><p class="explain">{t('结合当前任务与执行历史，在一次上游请求中选择下一分支，并可评价此前模型的胜任度。', 'Combine the current task with execution history. One upstream request chooses the next branch and can assess the previous model’s competence.')}</p><a class="text-link" href={en ? '/en/docs/jev-decider/' : '/docs/jev-decider/'}>{t('部署官方 Jev 扩展', 'Deploy the Jev extension')} ↗</a></div></div>
    <p class="diagram-mobile-hint">{t('左右滑动查看完整机制图', 'Swipe to explore the full diagram')}</p><figure class="jev-diagram" tabindex="0" aria-label={t('Jev 决策机制图，可横向滚动', 'Jev decision diagram, horizontally scrollable')}><img src={`/decision-assets/jev-decision-${en ? 'en' : 'zh-CN'}.svg`} alt={t('HiRoute 提供当前输入、执行历史与允许分支；Jev 单次调用返回下一分支与可选胜任度；HiRoute 执行并记录。', 'HiRoute supplies current input, history and allowed branches. A single Jev call returns a branch and optional competence assessment. HiRoute executes and records.')} loading="lazy"></figure>
    <div class="jev-modes"><article><span>{t('复杂度 · 寻找降本机会', 'COMPLEXITY · FIND ROOM TO SAVE')}</span><h3>{t('接下来的任务，经济模型能做吗？', 'Can an economy model handle what comes next?')}</h3><p>{t('Jev 给出任务简单的概率。达到设定门槛，才考虑使用经济分支；复杂任务继续交给主力分支。', 'Jev estimates the probability that the task is simple. Only consider economy when it meets your threshold; complex work stays on primary.')}</p></article><article><span>{t('胜任度 · 守住执行质量', 'COMPETENCE · PROTECT QUALITY')}</span><h3>{t('此前的表现，是否值得继续降本？', 'Does prior performance support saving?')}</h3><p>{t('本次对上一阶段的评分低于门槛时，阻止降本。高分不能抵消任务复杂度；无合法评分时，仅依据复杂度判断。', 'A low assessment of the previous stage blocks cost-cutting. A high score cannot override task complexity; without a valid score, complexity alone decides.')}</p></article></div>
    <div class="jev-bottom"><p>{t('胜任度只负责阻止冒险降本，复杂度负责提供降本机会。', 'Competence blocks risky cost-cutting; complexity creates opportunities to save.')}</p><small>{t('以上为官方扩展的 Rules 策略 · 阈值可配置 · Jev 为可选扩展', 'Rules policy in the official extension · Configurable thresholds · Jev is optional')}</small></div>
  </div></section>

  <section class="section wrap" id="performance">
    <div class="section-title"><div><div class="eyebrow section-label">{t('为下一次决策保留证据', 'Evidence for the next decision')}</div><h2>{t('不只知道选了谁，', 'See more than who was chosen.')}<br>{t('也看得见做得怎样。', 'See how the work went.')}</h2></div><p>{t('查看当前计划所选模型一段时间内的阶段胜任度，无需输入内部模型 ID。', 'Review stage competence over time for models selected by the current plan—without typing internal model IDs.')}</p></div>
    <figure class="product-shot"><img src={`/decision-assets/quality-${en ? 'en' : 'zh-CN'}.png`} alt={t('HiRoute 运行表现界面，包含阶段评分、未评分和部分历史', 'HiRoute runtime performance with stage scores, unrated work, and partial history')} loading="lazy"></figure>
    <p class="caption">{t('真实产品组件 · 演示数据，非模型评测。保留未评分、部分历史和评分尚未覆盖最新轮次等实际状态。', 'Real product components · Illustrative data, not a model benchmark. Unrated, partial, and not-yet-covered turns remain explicit.')}</p>
    <div class="proof-bottom"><article><h3>{t('分数始终带着范围', 'A score keeps its scope')}</h3><p>{t('评分属于具体计划、版本、模型和执行阶段；旧评分不会假装覆盖新增轮次。', 'A score belongs to a plan, revision, model, and execution stage; new turns are not silently covered by an older assessment.')}</p></article><article><h3>{t('证据可以帮助细分计划', 'Evidence can refine work plans')}</h3><p>{t('主 Agent 可查询高低分任务，结合证据判断是否需要建立更聚焦的工作场景。', 'A main agent can query high- and low-scoring tasks, inspect evidence, and propose a narrower work plan.')}</p></article></div>

  </section>

  <section class="section wrap" id="product"><div class="section-title"><div><div class="eyebrow section-label">{t('先选择任务路径，再配置算力', 'Route the task. Then the compute.')}</div><h2>{t('按任务选择 Agent，', 'Choose the agent for the task.')}<br>{t('按需要配置模型与算力。', 'Then configure models and compute.')}</h2></div><p>{t('面向开发、研究、复杂分析与通用自动化，不把产品定义绑定在某个 Agent 上。', 'Designed for coding, research, deep analysis, and general automation—not around one hard-coded agent.')}</p></div><div class="features">
    <article class="feature"><span class="num">01—</span><h3>{t('按用途选择执行 Agent', 'Choose an agent by purpose')}</h3><p>{t('主 Agent 发现开放的工作计划，按目标委派任务并取得结果。任务委派与模型路由可独立启用。', 'A main agent discovers allowed work plans, delegates a goal, and retrieves the result. Delegation and model routing remain independent.')}</p></article>
    <article class="feature"><span class="num">02—</span><h3>{t('按需要配置模型与算力', 'Configure models and compute')}</h3><p>{t('组合模型来源、思考档位和候选顺序；可以智能省钱、固定模型或免费优先。', 'Compose model sources, reasoning profiles, and ordered candidates; use smart saving, fixed, or free-first routing.')}</p></article>
    <article class="feature"><span class="num">03—</span><h3>{t('让接力有边界', 'Keep failover bounded')}</h3><p>{t('候选满足工具、图像和上下文要求；候选耗尽时明确停止，开始交付后不透明换模。', 'Candidates satisfy tool, image, and context requirements; exhaustion stops explicitly and delivery is not silently switched.')}</p></article>
  </div></section>

  <section class="section wrap ecosystem-section" id="ecosystem">
    <div class="section-title"><div><div class="eyebrow section-label">{t('Agent 生态', 'Agent ecosystem')}</div><h2>{t('不绑定一种 Agent，', 'Not tied to one agent.')}<br>{t('也不局限于编程。', 'Not limited to coding.')}</h2></div><p>{t('集成状态按真实支持范围开放；当前可用与规划方向明确分开。', 'Integration status follows real support; available and planned paths stay visibly separate.')}</p></div>
    <div class="ecosystem-groups"><article><h3>{t('当前适配', 'Available now')}</h3><div class="agent-names"><span>Codex</span><span>Claude Code</span></div></article><article class="ecosystem-planned"><h3>{t('后续方向', 'Planned')}</h3><div class="agent-names"><span>Qoder</span><span>Pi</span><span>DeepSeek Harness</span><span>OpenCode</span><span>Hermes Agent</span><span>OpenClaw</span></div><p>{t('具体顺序按真实适配和验证推进。', 'Order depends on real integration and validation.')}</p></article></div>
  </section>

  <section class="section wrap extension-section" id="extensions">
    <div><div class="eyebrow section-label">{t('一套接口，接入你的策略', 'Your policy, one interface')}</div><h2>{t('把你的判断方式，', 'Your decision policy.')}<br>{t('接入 HiRoute。', 'One HiRoute interface.')}</h2><p>{t('用 Jev、LLM 或自己的策略实现决策服务。通用协议支持允许分支选择与可选胜任度评分。', 'Build a decision service with Jev, an LLM, or your own policy. The general API supports allowed-branch choice and optional competence scoring.')}</p><a class="text-link" href={en ? '/en/docs/decision-api/' : '/docs/decision-api/'}>{t('决策 API 文档', 'Decision API documentation')} →</a><br><a class="text-link" href="/api/decision.openapi.json" download>{t('下载 OpenAPI', 'Download OpenAPI')} ↓</a></div>
    <div class="code-box"><div class="code-heading">{t('决策 API / 单次请求', 'DECISION API / SINGLE REQUEST')}</div><pre><code><span class="accent">POST</span> /v1/decisions

&#123;
  "branch_id": "smart_saving_simple",
  "assessment": &#123; "score": 0.82, "partial": false &#125;
&#125;</code></pre><span class="muted">{t('assessment 可选，并需要可评分历史目标', 'Assessment is optional and requires a history target')}</span></div>
  </section>

  <section class="section wrap" id="start">
    <div class="download-row"><div><div class="eyebrow section-label">{t('从 HiRoute 开始', 'Start with HiRoute')}</div><h2>{t('保留工作流，', 'Keep your workflow.')}<br>{t('重新安排算力。', 'Rearrange the compute.')}</h2><p>{release ? t(`稳定版本 ${release.version} 现已提供 ${releaseKinds}。`, `Stable ${release.version} is available for ${releaseKinds}.`) : t('公开版本正在准备中。macOS 使用桌面应用，Linux 可通过一条命令安装完整的无界面管理端。', 'The first public release is being prepared. Use Desktop on macOS or install the complete headless management surface on Linux with one command.')}</p><div class="actions"><a class="button" href={en ? '/en/download/' : '/download/'}>{t('选择安装方式', 'Choose an install path')} ↗</a><a class="button outline" href={en ? '/en/docs/' : '/docs/'}>{t('阅读快速开始', 'Read the Quickstart')} ↗</a></div></div>
      <div class="download-state">{release && linuxArtifact ? <><b>{t('Linux 无界面版', 'Linux headless')} · {release.version}</b><p>{linuxArtifact.architecture} · {formatBytes(linuxArtifact.size, language)}</p><code>curl -fsSL https://hiroute.ai/install.sh | sh</code><a class="text-link" href={en ? '/en/docs/install-linux/' : '/docs/install-linux/'}>{t('查看安装与启动步骤', 'Installation and startup')} →</a><span class="tag">SHA256 {linuxArtifact.sha256.slice(0, 12)}…</span></> : release && preferredArtifact ? <><b>HiRoute {release.version}</b><p>macOS {preferredArtifact.architecture} · {formatBytes(preferredArtifact.size, language)}</p><a class="button download-button" href={artifactUrl(release, preferredArtifact)}>{t('下载桌面应用', 'Download Desktop')}</a><span class="tag">{preferredArtifact.distribution === 'self-signed' ? t('自签名', 'SELF-SIGNED') : 'DEVELOPER ID'} · SHA256 {preferredArtifact.sha256.slice(0, 12)}…</span></> : <><b>{t('桌面应用 + 无界面版', 'Desktop + headless')}</b><p>{t('发布前先完成完整性检查、安装走查和发布审核。', 'Integrity checks, installation review, and release approval come first.')}</p><span class="tag">{t('准备中', 'IN PREPARATION')}</span></>}</div>
    </div>
  </section>

  <section class="section wrap faq-section" id="faq"><div class="eyebrow section-label">{t('常见问题', 'Questions')}</div><h2>{t('常见问题', 'Frequently asked questions')}</h2>
    <details><summary>{t('模型切换会破坏 KV cache 吗？', 'Does model switching destroy the KV cache?')}</summary><p>{t('不同模型不能共享 KV cache。HiRoute 尽量把换模放在上下文压缩后的自然重建时机；普通工具续轮保持模型稳定。实际命中仍取决于模型服务、配置和缓存生命周期。', 'Different models do not share KV cache. HiRoute aligns model changes with natural rebuilds after context compaction when possible, while ordinary tool continuations stay on the same model. Actual hits still depend on provider, configuration, and cache lifetime.')}</p></details>
    <details id="history-faq"><summary>{t('上下文压缩后，决策服务还能看到历史吗？', 'Can the decision service still see history after compaction?')}</summary><p>{t('可以看到 HiRoute 独立维护的简化 Agent 轮次历史：用户问题、接受的回答、工具名称与粗粒度状态、执行分支。它不是完整对话转录，淘汰或重启后可标记为部分历史。', 'It receives HiRoute’s independent simplified Agent-turn history: user input, accepted output, tool names and coarse outcomes, and executed branches. It is not a full transcript and can be marked partial after eviction or restart.')}</p></details>
    <details><summary>{t('一定要部署 Jev 吗？', 'Must I deploy Jev?')}</summary><p>{t('不需要。内置规则可以开始路由；Jev 是官方可选扩展，也可以按同一 Decision API 实现自己的服务。', 'No. Built-in rules are enough to start; Jev is an optional official extension, and you can implement your own service against the same Decision API.')}</p></details>
    <details><summary>{t('胜任度评分是不是成功率？', 'Is competence a success rate?')}</summary><p>{t('不是。它表达模型对具体执行阶段的胜任程度，必须结合计划、版本、评分覆盖范围和部分证据状态理解。', 'No. It represents competence for a specific execution stage and must be interpreted with plan, revision, assessment coverage, and partial-evidence state.')}</p></details>
  </section>

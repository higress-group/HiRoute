---
import { posts, newsRoute } from '../lib/news.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import { artifactUrl, formatBytes, latestRelease } from '../lib/releases.mjs';
const { language = 'zh' } = Astro.props;
const en = language === 'en';
const t = (zh, english) => en ? english : zh;
const path = en ? '/en/' : '/';
const alternatePath = en ? '/' : '/en/';
const featuredPost = posts[0];
const release = latestRelease('stable');
const preferredArtifact = release?.artifacts.find(item => item.kind === 'desktop' && item.platform === 'macOS' && item.architecture === 'arm64')
  ?? release?.artifacts.find(item => item.kind === 'desktop' && item.platform === 'macOS');
const windowsArtifact = release?.artifacts.find(item => item.kind === 'desktop' && item.platform === 'Windows');
const linuxArtifact = release?.artifacts.find(item => item.kind === 'standalone' && item.platform === 'Linux');
const releaseKinds = [preferredArtifact && t('macOS 桌面应用', 'macOS Desktop'), windowsArtifact && t('Windows 桌面应用', 'Windows Desktop'), linuxArtifact && t('Linux 无界面版', 'Linux headless')].filter(Boolean).join(' / ');
---
<SiteLayout language={language}
  title={t('HiRoute · 只在需要的地方，为最强的模型付费', 'HiRoute · Pay for your strongest model only where the work needs it')}
  description={t('在熟悉的 Agent 中组合订阅、API 和本地模型。常规工作交给经济模型，复杂任务交给主力；经济模型没做好，主力随时接手。', 'Combine subscriptions, APIs and local models in the Agent you already use. Routine work goes to economical models, complex work to your primary model, which steps in when an economical model falls short.')}
  path={path} alternatePath={alternatePath} fullWidth>
  <section class="hero wrap">
    <div>
      {featuredPost ? <a class="hero-article" href={newsRoute(featuredPost.slug, language)} title={featuredPost.title[language]}>
        <span class="hero-article-label">{t('最新文章', 'Latest article')}</span>
        <span class="hero-article-copy">{featuredPost.shortTitle?.[language] ?? featuredPost.title[language]}</span>
        <span class="hero-article-arrow" aria-hidden="true">→</span>
      </a> : <div class="eyebrow section-label">{t('面向长程 Agent 的智能路由', 'Intelligent routing for long-horizon agents')}</div>}
      <h1>{en ? <><span>Pay for your strongest model</span><span class="hero-accent">only where the work needs it.</span></> : <><span>只在需要的地方，</span><span class="hero-accent">为最强的模型付费。</span></>}</h1>
      <p class="intro">{t('常规工作交给经济模型，复杂任务交给主力；经济模型没做好，主力随时接手。继续用你熟悉的 Agent，组合订阅、API 和本地模型。', 'Routine work goes to economical models and complex work to your primary model, which steps in when an economical model falls short. Keep your Agent and combine subscriptions, APIs and local models.')}</p>
      <div class="actions"><a class="button" href={en ? '/en/download/' : '/download/'}>{t('下载 HiRoute', 'Download HiRoute')} <span>↗</span></a><a class="button outline" href="#tour">{t('观看 3 分钟介绍', 'Watch the 3-minute tour')} <span>▶</span></a></div>
      <p class="small-note">{t('支持 Codex、Claude Code、Qoder、Pi、OpenCode、Hermes 和 DeepSeek Harness · macOS 与 Linux', 'Works with Codex, Claude Code, Qoder, Pi, OpenCode, Hermes and DeepSeek Harness · macOS and Linux')}</p>
    </div>
    <div class="journey-art" aria-label={t('一个长任务中的模型分工示意', 'How models share one long task')}>
      <div class="journey-goal"><span>{t('一个长任务 · 每个阶段选对模型', 'ONE LONG TASK · THE RIGHT MODEL FOR EACH STAGE')}</span><strong>{t('大部分工作很常规，少数决策才需要最强的模型。', 'Most of the work is routine. Only a few decisions need your strongest model.')}</strong></div>
      <div class="journey-stage economy"><span class="journey-dot"></span><div><small>{t('常规工作', 'ROUTINE WORK')}</small><h3>{t('经济模型，持续推进', 'Economical model keeps going')}</h3><p>{t('读代码 → 整理资料 → 按已知方法修改', 'Read code → Collect facts → Apply known fixes')}</p><div class="prefix-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="journey-cache">{t('按经济模型的价格', 'At economical prices')}</span></div></div>
      <a class="journey-pivot" href="#how"><span>↻</span><div><strong>{t('新消息 · 重新判断', 'New message · Decide again')}</strong><small>{t('这一步有多难？上一步做得怎样？', 'How hard is this step? How did the last one go?')}</small></div><b>↗</b></a>
      <div class="journey-stage primary"><span class="journey-dot"></span><div><small>{t('难点与补救', 'HARD PARTS AND RECOVERY')}</small><h3>{t('主力模型，只在这里出手', 'Primary model, only where needed')}</h3><p>{t('关键决策 → 低分后接手 → 检查交付', 'Key decisions → Step in after a low score → Check the result')}</p><div class="prefix-bars" aria-hidden="true"><i></i><i></i><i></i></div><span class="journey-cache">{t('只为这部分付主力的价格', 'Primary prices only for this part')}</span></div></div>
      <p class="journey-footnote">{t('机制示意', 'Illustration')}</p>
    </div>
  </section>
  <div class="trust-line stat-line wrap">
    <a href="#savings"><b>~90%</b><span>{t('真实任务中的成本降幅，验收标准不变', 'lower cost on a real task at the same acceptance standard')}</span></a>
    <a href="#trial"><b>{t('低分保护', 'Low-score protection')}</b><span>{t('经济模型没做好，主力接手下一轮', 'primary takes the next turn when an economical model falls short')}</span></a>
    <a href="#ecosystem"><b>{t('7 种 Agent', '7 Agents')}</b><span>{t('照常使用 Codex、Claude Code 等', 'keep using Codex, Claude Code and more')}</span></a>
  </div>

  <section class="section wrap tour-section" id="tour">
    <div class="section-title"><div><div class="eyebrow section-label">{t('产品介绍', 'Product tour')}</div><h2>{t('在真实任务中试用新模型', 'Try a new model on a real task')}</h2></div><p>{t('一段录制的编程会话：新模型处理常规轮次，低分后主力接手，信任程度依据你自己的记录调整。', 'A recorded coding session: a new model handles routine turns, your primary model steps in after a low score, and trust adjusts from your own records.')}</p></div>
    <figure class="product-shot tour-video"><video controls playsinline preload="none" poster={`/media/hiroute-promo-${en ? 'en' : 'zh'}-poster.jpg`} aria-label={t('HiRoute 三分钟产品介绍视频', 'HiRoute three-minute product tour video')}><source src={`/media/hiroute-promo-${en ? 'en' : 'zh'}.mp4`} type="video/mp4"></video></figure>
    <p class="caption">{t('真实会话录屏，信任度部分为示意画面 · 费用为 API 等价估算。', 'Recorded real session; trust-level scenes are illustrations · Costs are API-equivalent estimates.')}</p>
  </section>

  <section class="section wrap savings-section" id="savings">
    <div class="section-title"><div><div class="eyebrow section-label">{t('真实场景的成本节省', 'Real-world cost savings')}</div><h2>{t('相同验收标准，', 'Same acceptance standard.')}<br>{t('成本降低约 90%。', 'About 90% lower cost.')}</h2></div><p>{t('在一次真实的技术调研与架构评审任务中，Qwen 3.8 Flash 负责调研，GPT-6 Astra 负责关键决策。达到同样的验收标准，成本比全部使用 Astra 降低约 90%。', 'In a real research and architecture-review task, Qwen 3.8 Flash did the research and GPT-6 Astra made the critical decision. At the same acceptance standard, the task cost about 90% less than running everything on Astra.')}</p></div>
    <figure class="product-shot chart-shot"><img src={`/news-assets/research-cost-${en ? 'en' : 'zh'}.svg`} alt={t('相同验收标准下的整单成本：HiRoute 混合约为全 Astra 的十二分之一', 'Cost of the same task at the same acceptance standard: HiRoute mixed costs about one twelfth of all Astra')} loading="lazy"></figure>
    <div class="proof-bottom">
      <article><h3>{t('切换模型，省下的钱不会丢', 'Switching models keeps the savings')}</h3><p>{t('HiRoute 只在明确的边界切换模型：用户发送新消息，或上下文压缩、重建时。同一轮内的工具调用始终使用同一个模型，切换后只有第一次请求丢失缓存。', 'HiRoute changes models only at clear boundaries: a new user message, or context compaction and rebuild. Tool calls within a turn stay on one model, so a switch misses the cache only once.')}</p><a class="text-link" href={en ? '/en/news/routing-cache-cost/' : '/news/routing-cache-cost/'}>{t('缓存与整单成本分析', 'Cache and whole-task cost analysis')} →</a></article>
      <article><h3>{t('关键决策交给更强的模型', 'Critical decisions stay with the stronger model')}</h3><p>{t('只用 Qwen 时，三次关键决策只有一次没有重大错误；混合模式把关键判断留给 Astra，三次都通过评审。费用为 API 等价估算。', 'Qwen alone avoided major errors in only one of three critical decisions; the mixed setup kept those judgments on Astra and passed all three reviews. Costs are API-equivalent estimates.')}</p><a class="text-link" href={en ? '/en/news/astra-qwen-smart-routing/' : '/news/astra-qwen-smart-routing/'}>{t('完整案例', 'Full case study')} →</a></article>
    </div>
  </section>

  <section class="section wrap trial-section" id="trial">
    <div class="section-title"><div><div class="eyebrow section-label">{t('新模型逐步试，主力随时接手', 'Try new models with a primary model ready')}</div><h2>{t('新模型不必一次全面接管，', 'No need to hand over everything.')}<br>{t('按任务难度逐步放量。', 'Roll out by task difficulty.')}</h2></div><p>{t('从首页的「新模型」开始，选好要试用的模型和熟悉的主力。发布前会列出全部改动。', 'Start from New models on Home and pair the model to try with a familiar primary model. Every change is listed before you publish.')}</p></div>
    <figure class="product-shot dark-shot"><img src={`/decision-assets/readme-trial-${en ? 'en' : 'zh-CN'}.png`} alt={t('信任度滑块从谨慎到托付，可点击试用、熟悉、信任、放手、托付档位；当前选中「信任」，简单概率阈值 0.65', 'Trust slider from Cautious to Entrusted with Trial, Familiar, Trusted, Hands-off and Entrusted presets; Trusted is selected at a simple-probability threshold of 0.65')} width="1872" height="434" loading="lazy"></figure>
    <div class="features">
      <article class="feature"><span class="num">01—</span><h3>{t('信任度就是难度门槛', 'Trust sets a difficulty bar')}</h3><p>{t('System One 判断每一轮有多简单，够简单的交给新模型，更难的仍由主力处理。', 'System One estimates how simple each turn is. Turns that clear the bar go to the new model; harder work stays with your primary model.')}</p></article>
      <article class="feature"><span class="num">02—</span><h3>{t('逐步放开', 'Open up gradually')}</h3><p>{t('新模型表现稳定后，从试用调到熟悉、信任或放手，它就会承担更多工作。', 'Move from Trial to Familiar, Trusted or Hands-off as the new model proves itself, and it takes on more of your work.')}</p></article>
      <article class="feature"><span class="num">03—</span><h3>{t('主力继续兜底', 'Primary still backs it up')}</h3><p>{t('新模型的阶段评分低于胜任下限、且问题仍然相关时，低分保护让主力接手下一轮。', 'If a new-model stage scores below the competence floor and the problem still matters, low-score protection hands the next turn to your primary model.')}</p></article>
    </div>
  </section>

  <section class="section wrap" id="performance">
    <div class="section-title"><div><div class="eyebrow section-label">{t('用自己任务的证据调整', 'Adjust with evidence from your own tasks')}</div><h2>{t('用了哪个模型、为什么、', 'Which model ran, why,')}<br>{t('做得怎样，一目了然。', 'and how well it went.')}</h2></div><p>{t('会话时间线展示每次实际用了哪个模型、为什么切换。模型表现报告汇总阶段评分、常规模型承担比例和费用估算；证据足够时建议上调或下调，由你决定是否发布。', 'The session timeline shows which model ran and why. Model performance reports bring together stage scores, the regular share and cost estimates; with enough evidence they suggest a step up or down, and you decide whether to publish.')}</p></div>
    <div class="evidence-grid">
      <figure class="product-shot dark-shot"><img src={`/decision-assets/readme-session-${en ? 'en' : 'zh-CN'}.png`} alt={t('真实会话时间线：Flash 阶段评分偏低后，主力在低分保护下接手下一轮，之后回到 Flash', 'Real session timeline: after a low Flash score, the primary model takes the next turn under low-score protection, then work returns to Flash')} loading="lazy"><figcaption>{t('真实会话：低分后主力接手，问题解决后回到经济模型。', 'A real session: primary steps in after a low score, then work returns to the economical model.')}</figcaption></figure>
      <figure class="product-shot dark-shot"><img src={`/decision-assets/readme-report-${en ? 'en' : 'zh-CN'}.png`} alt={t('模型表现报告：建议上调到「信任」，75% 的阶段交给常规模型，胜任率 90%，并给出费用估算', 'Model performance report: a step-up suggestion to Trusted, 75% of stages on Regular at 90% competence, with a cost estimate')} loading="lazy"><figcaption>{t('模型表现报告：常规模型稳定达标后，建议上调信任度。', 'Model performance report: a step-up suggestion once the regular model clears the bar.')}</figcaption></figure>
    </div>
  </section>

  <section class="night" id="how"><div class="section wrap jev-section">
    <div class="jev-heading"><div><span class="jev-extension-label">{t('System One · 决策模型', 'System One · Decision models')}</span><h2>{t('每一轮只问三件事，', 'Three questions each turn.')}<br><em>{t('HiRoute 据此选模型。', 'HiRoute picks the model.')}</em></h2></div><div><p class="explain">{t('在「模型 → 决策模型」中连接百炼、OpenAI、OpenRouter Jev、TypeSafe 或兼容接入点即可使用，无需自行部署 Jev。阈值、选组与执行始终由 HiRoute 负责。', 'Connect Bailian, OpenAI, OpenRouter Jev, TypeSafe or a compatible endpoint in Models → Decision models; no self-hosted Jev needed. HiRoute keeps thresholds, group selection and execution.')}</p><a class="text-link" href={en ? '/en/docs/decision-extensions/' : '/docs/decision-extensions/'}>{t('决策模型与路由机制', 'Decision models and routing mechanism')} ↗</a></div></div>
    <div class="question-grid">
      <article><span>01</span><h3>{t('当前工作有多难？', 'How demanding is the current work?')}</h3><p>{t('够简单就交给经济模型，复杂的交给主力。', 'Simple enough goes to the economical model; complex work goes to primary.')}</p></article>
      <article><span>02</span><h3>{t('上一阶段做得怎样？', 'How well did the previous stage go?')}</h3><p>{t('对刚完成的阶段打分，低于胜任下限就留意。', 'The finished stage gets a score; below the competence floor, it is flagged.')}</p></article>
      <article><span>03</span><h3>{t('之前的问题还影响现在吗？', 'Does its problem still affect the task?')}</h3><p>{t('仍然相关才让主力接手；已解决或换了任务，就重新按难度选。', 'Primary steps in only if it still matters; once resolved or the task changes, difficulty decides again.')}</p></article>
    </div>
  </div></section>

  <section class="section wrap ecosystem-section" id="ecosystem">
    <div class="section-title"><div><div class="eyebrow section-label">{t('Agent 生态', 'Agent ecosystem')}</div><h2>{t('不换 Agent，', 'Keep your Agent.')}<br>{t('也不局限于编程。', 'Not limited to coding.')}</h2></div><p>{t('HiRoute 在本地运行，把受支持的订阅、API 接入和本地模型集中管理。开发、研究、分析与自动化都可以按需分配模型。', 'HiRoute runs locally and brings supported subscriptions, API connections and local models into one place, for coding, research, analysis and automation.')}</p></div>
    <div class="ecosystem-groups"><article><h3>{t('当前适配', 'Available now')}</h3><div class="agent-names"><span>Codex</span><span>Claude Code</span><span>Qoder</span><span>Pi</span><span>OpenCode</span><span>Hermes</span><span>DeepSeek Harness</span></div></article><article class="ecosystem-planned"><h3>{t('更多玩法', 'Go further')}</h3><p>{t('固定模型、自定义分支与免费优先等路由模式；主 Agent 还可以把独立任务委派给合适的执行 Agent。', 'Fixed model, custom branches and free-first routing; a main Agent can also delegate independent tasks to a suitable execution Agent.')}</p><a class="text-link" href={en ? '/en/docs/model-routing/' : '/docs/model-routing/'}>{t('模型路由', 'Model routing')} →</a> <a class="text-link" href={en ? '/en/docs/task-routing/' : '/docs/task-routing/'}>{t('任务路由', 'Task routing')} →</a></article></div>
  </section>

  <section class="section wrap extension-section" id="extensions">
    <div><div class="eyebrow section-label">{t('自定义扩展 · 按需接入', 'Custom extensions · When you need them')}</div><h2>{t('把你的判断方式，', 'Your decision policy.')}<br>{t('接入 HiRoute。', 'One HiRoute interface.')}</h2><p>{t('需要自有模型或处理逻辑时，再部署自定义扩展。HiRoute 传入已发布的任务类别、可用模型组与安全历史；扩展直接返回类别和常规或主力组，可选上一阶段评分仅用于观察。HiRoute 保持模型选择与执行边界。', 'Deploy a custom extension for your own decision policy. HiRoute supplies published categories, available groups and safe history. The extension returns a category and regular or primary group; optional prior-stage scores are observation only. HiRoute retains model selection and execution.')}</p><a class="text-link" href={en ? '/en/docs/decision-api/' : '/docs/decision-api/'}>{t('自定义扩展 API', 'Custom extension API')} →</a><br><a class="text-link" href="/api/decision.openapi.json" download>{t('下载 OpenAPI', 'Download OpenAPI')} ↓</a></div>
    <div class="code-box"><div class="code-heading">{t('自定义扩展 API / 首次响应示例', 'CUSTOM EXTENSION API / FIRST RESPONSE')}</div><pre><code><span class="accent">POST</span> /v1/decisions

&#123;
  "group": "regular"
&#125;</code></pre><span class="muted">{t('按难度分流的首次决策 · 无历史评分目标，不返回 assessment', 'First difficulty-routing decision · No history target, so no assessment')}</span></div>
  </section>

  <section class="section wrap" id="start">
    <div class="download-row"><div><div class="eyebrow section-label">{t('从 HiRoute 开始', 'Start with HiRoute')}</div><h2>{t('保留工作流，', 'Keep your workflow.')}<br>{t('重新安排算力。', 'Rearrange the compute.')}</h2><p>{release ? t(`稳定版本 ${release.version} 现已提供 ${releaseKinds}。`, `Stable ${release.version} is available for ${releaseKinds}.`) : t('公开版本正在准备中。macOS 使用桌面应用，Linux 可通过一条命令安装完整的无界面管理端。', 'The first public release is being prepared. Use Desktop on macOS or install the complete headless management surface on Linux with one command.')}</p><div class="actions"><a class="button" href={en ? '/en/download/' : '/download/'}>{t('选择安装方式', 'Choose an install path')} ↗</a><a class="button outline" href={en ? '/en/docs/' : '/docs/'}>{t('阅读快速开始', 'Read the Quickstart')} ↗</a></div></div>
      <div class="download-state">{release && linuxArtifact ? <><b>{t('Linux 无界面版', 'Linux headless')} · {release.version}</b><p>{linuxArtifact.architecture} · {formatBytes(linuxArtifact.size, language)}</p><code>curl -fsSL https://hiroute.ai/install.sh | sh</code><a class="text-link" href={en ? '/en/docs/install-linux/' : '/docs/install-linux/'}>{t('查看安装与启动步骤', 'Installation and startup')} →</a><span class="tag">SHA256 {linuxArtifact.sha256.slice(0, 12)}…</span></> : release && preferredArtifact ? <><b>HiRoute {release.version}</b><p>macOS {preferredArtifact.architecture} · {formatBytes(preferredArtifact.size, language)}</p><a class="button download-button" href={artifactUrl(release, preferredArtifact)}>{t('下载桌面应用', 'Download Desktop')}</a><span class="tag">{preferredArtifact.distribution === 'self-signed' ? t('自签名', 'SELF-SIGNED') : 'DEVELOPER ID'} · SHA256 {preferredArtifact.sha256.slice(0, 12)}…</span></> : <><b>{t('桌面应用 + 无界面版', 'Desktop + headless')}</b><p>{t('发布前先完成完整性检查、安装走查和发布审核。', 'Integrity checks, installation review, and release approval come first.')}</p><span class="tag">{t('准备中', 'IN PREPARATION')}</span></>}</div>
    </div>
  </section>

  <section class="section wrap faq-section" id="faq"><div class="eyebrow section-label">{t('常见问题', 'Questions')}</div><h2>{t('常见问题', 'Frequently asked questions')}</h2>
    <details><summary>{t('切换模型会影响 KV Cache 吗？', 'How does model switching affect KV Cache?')}</summary><p>{t('会。HiRoute 在同一轮正常的连续工具调用中沿用路由决策，并优先保持所选组内的当前模型，让增长中的前缀持续复用缓存。新用户消息会重新判断任务；若发生切换，首次请求可能损失旧缓存，后续连续调用则可以复用新缓存。', 'Yes. During normal consecutive tool calls in the same turn, HiRoute reuses the routing decision and prefers the current model within the selected group, preserving reuse of the growing prefix. A new user message triggers reassessment; a switch may lose the old cache on the first request, while later calls can reuse the new cache.')}</p><p>{t('上下文压缩或重建后，部分缓存本来就需要重建，这时重新选模的额外损失可能更小。HiRoute 通过保持连续执行减少不必要的缓存开销，最终比较包含缓存重建、路由判断和重试的整单成本。具体影响与 Astra × Qwen 实验测算见下文。', 'After compaction or a history rebuild, some cache entries already need rebuilding, so reassessment at that boundary may incur a smaller additional loss. HiRoute preserves continuous execution to reduce unnecessary cache overhead. Whole-task costs include rebuilding, routing decisions, and retries; the article below explains the effects and Astra × Qwen calculations.')}</p><p><a class="text-link" href={en ? '/en/news/routing-cache-cost/' : '/news/routing-cache-cost/'}>{t('阅读缓存影响与成本分析：Astra × Qwen 3.8 Flash', 'Read the cache and cost analysis: Astra × Qwen 3.8 Flash')} →</a></p></details>
    <details><summary>{t('上下文压缩一定会重新选模吗？', 'Does context compaction always trigger a new model choice?')}</summary><p>{t('要看是否仍能识别为同轮续接、此前冻结决策是否可复用。能够继承时保持本轮决策；历史重建使续接关系或决策无法复用时才再次判断。重新判断也可以选择原模型，客户端无需单独上报压缩事件。', 'It depends on whether HiRoute can still recognize the same-turn continuation and reuse the frozen decision. A reusable continuation inherits that decision. If a history rebuild breaks continuity or the decision cannot be reused, HiRoute judges again. The new choice can keep the same model; clients need no separate compaction event.')}</p></details>
    <details id="history-faq"><summary>{t('决策模型能看到哪些执行历史？', 'What execution history can a decision model see?')}</summary><p>{t('HiRoute 提供简化的 Agent 轮次历史：用户问题、接受的回答、工具名称与粗粒度状态。内部任务类别、模型组与执行身份由 HiRoute 绑定，不要求模型猜测。历史被裁剪、淘汰或重启后可能不完整；评分目标阶段的证据完整性单独判断，缺失或部分评分不会视为零分。', 'HiRoute supplies simplified Agent-turn history: user input, accepted output, tool names, and coarse outcomes. HiRoute binds internal task categories, groups, and execution identities itself. Trimming, eviction, or restart may leave history incomplete; completeness of the assessed stage is tracked separately. Missing or partial assessments are not zero scores.')}</p></details>
    <details><summary>{t('一定要部署 Jev 吗？', 'Must I deploy Jev?')}</summary><p>{t('不需要。在模型 → 决策模型中连接百炼、OpenRouter Jev、TypeSafe 或兼容接入点，就能使用内置判断。按难度分流也支持启发式规则；需要自有处理逻辑时才选择自定义扩展。', 'No. Connect Bailian, OpenRouter Jev, TypeSafe, or a compatible endpoint in Models → Decision models to use built-in judgment. Difficulty routing also supports heuristic rules. Choose a custom extension when you need your own processing logic.')}</p></details>
    <details><summary>{t('胜任度评分是不是成功率？', 'Is competence a success rate?')}</summary><p>{t('不是。它表达模型对具体执行阶段的胜任程度，必须结合计划、版本、评分覆盖范围和部分证据状态理解。', 'No. It represents competence for a specific execution stage and must be interpreted with plan, revision, assessment coverage, and partial-evidence state.')}</p></details>
  </section>

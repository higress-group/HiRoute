---
import SiteLayout from '../layouts/SiteLayout.astro';
import { artifactUrl, formatBytes, latestRelease } from '../lib/releases.mjs';
const { language = 'zh' } = Astro.props;
const en = language === 'en';
const t = (zh, english) => en ? english : zh;
const path = en ? '/en/' : '/';
const alternatePath = en ? '/' : '/en/';
const release = latestRelease('stable');
const preferredArtifact = release?.artifacts.find(item => item.kind === 'desktop' && item.architecture === 'arm64')
  ?? release?.artifacts.find(item => item.kind === 'desktop');
const linuxArtifact = release?.artifacts.find(item => item.kind === 'standalone');
const releaseKinds = [preferredArtifact && t('macOS 桌面应用', 'macOS Desktop'), linuxArtifact && t('Linux 无界面版', 'Linux headless')].filter(Boolean).join(' / ');
---
<SiteLayout language={language}
  title={t('HiRoute · 长程 Agent 智能路由引擎', 'HiRoute · Intelligent routing for long-horizon agents')}
  description={t('按任务选择 Agent，按阶段选择模型。通过官方 Jev 决策扩展，结合执行表现和任务复杂度，做出缓存友好的路由决策。', 'Match agents to tasks and models to stages. Use the official Jev extension to make cache-friendly decisions from task complexity and observed performance.')}
  path={path} alternatePath={alternatePath} fullWidth>
  <section class="hero wrap">
    <div>
      <div class="eyebrow section-label">{t('面向长程 Agent 的智能路由', 'Intelligent routing for long-horizon agents.')}</div>
      <h1>{en ? <><span>Intelligent routing</span><span>for long-horizon agents.</span></> : <><span>为长程 Agent 而生的</span><span>智能路由引擎。</span></>}</h1>
      <p class="intro">{t('一段长任务，不必始终依赖同一个模型。按任务选择 Agent，再根据执行表现与后续工作的需要，决定继续使用还是切换模型。', 'A long task need not rely on one model from start to finish. Match the agent to the task, then choose the right model for each stage—guided by past performance and the work ahead.')}</p>
      <a class="jev-callout" href="#how"><strong>Jev</strong><span>{t('官方决策扩展 · 一次调用，选择与评分', 'Official extension · One call to choose and assess')}</span><span aria-hidden="true">↗</span></a>
      <div class="actions"><a class="button" href="#boundaries">{t('看懂长程路由', 'Explore the mechanism')} <span>↓</span></a><a class="button outline" href={en ? '/en/download/' : '/download/'}>{t('下载 HiRoute', 'Download HiRoute')} <span>↗</span></a></div>
      <p class="small-note">{t('开发、研究、分析与自动化。保留惯用工作流，按需投入算力。', 'Code, research, analysis, and automation. Keep your workflow and spend compute where it counts.')}</p>
    </div>
    <div class="engine-map">
      <div class="route-top"><span>{t('一个任务，多次决策', 'ONE TASK. MANY DECISIONS.')}</span><span>{t('机制示意', 'MECHANISM')}</span></div>
      <div class="engine-goal"><span>{t('一个长程目标', 'One long-horizon goal')}</span><strong>{t('理解 → 规划 → 执行 → 验证', 'Understand → Plan → Execute → Verify')}</strong></div>
      <div class="engine-link" aria-hidden="true">↓</div>
      <div class="engine-agent"><span>{t('主 Agent / 执行 Agent', 'Main agent / Execution agent')}</span><small>{t('按用途选择工作计划，保留惯用工作流', 'Choose a work plan by purpose; keep the familiar workflow')}</small></div>
      <div class="engine-link" aria-hidden="true">↓</div>
      <div class="engine-center"><img src="/brand/app-icon.svg" alt=""><div><strong>HiRoute</strong><span>{t('模型路由 · 预设思考档位 · 有界接力', 'Model routing · Reasoning profiles · Bounded failover')}</span></div></div>
      <div class="engine-sources"><span>{t('订阅', 'Subscriptions')}</span><span>API</span><span>{t('免费模型', 'Free models')}</span><span>{t('本地模型', 'Local models')}</span></div>
      <div class="engine-feedback">↶ {t('执行事实，成为下一次判断的依据', 'Execution facts inform the next decision')}</div>
    </div>
  </section>
  <div class="trust-line wrap"><span><b>{t('更省', 'Efficient')}</b> · {t('按需投入算力', 'Compute where it counts')}</span><span><b>{t('更稳', 'Reliable')}</b> · {t('有边界地接力', 'Bounded failover')}</span><span><b>{t('更懂', 'Adaptive')}</b> · {t('用执行事实改进选择', 'Decisions grounded in execution')}</span></div>

  <section class="section wrap lifecycle-section" id="boundaries">
    <div class="section-title"><div><div class="eyebrow section-label">{t('01 / 长任务不只做一次模型选择', '01 / A long task is not one model choice')}</div><h2>{t('阶段内保持稳定，', 'Stay stable within a stage.')}<br>{t('在自然边界重新选择。', 'Choose again at natural boundaries.')}</h2></div><p>{t('不必等用户再次提问。Agent 自主执行时，ContextHold 允许切换的上下文重建也能成为决策机会；持续追加的工具续轮保持稳定。', 'A new user prompt is not the only boundary. A ContextHold boundary can also trigger a decision, while ordinary tool continuations stay stable.')}</p></div>
    <div class="timeline-legend"><span class="legend-economy">{t('经济模型', 'Economy model')}</span><span class="legend-primary">{t('主力模型', 'Primary model')}</span><span>{t('选择决策节点查看接续方式 · 机制示例', 'Select a decision point to inspect the handoff · Illustration')}</span></div>
    <div class="timeline-grid">
      <div class="turn-caption turn-one">{t('用户提出目标 → Agent 自主推进', 'User sets the goal → Agent works autonomously')}<span>{t('同一个用户任务可以跨多个路由执行轮次', 'One user task can span multiple routing turns')}</span></div>
      <div class="turn-caption turn-two">{t('用户补充反馈 → 继续推进', 'User feedback → Continue')}<span>{t('新输入带来新的决策机会', 'New input creates another decision point')}</span></div>
      <article class="execution-window first-window"><span class="eyebrow">{t('执行轮次 01', 'ROUTING TURN 01')}</span><h3>{t('经济模型 A', 'Economy model A')}</h3><p>{t('处理明确、局部的工作', 'Handles bounded, local work')}</p><div class="tool-steps"><span>{t('回答', 'Answer')}</span><i>→</i><span>{t('工具', 'Tools')}</span><i>→</i><span>{t('继续', 'Continue')}</span></div><div class="cache-ribbon cache-a"><b>{t('A 的前缀持续追加', 'A’s prefix keeps growing')}</b><span>{t('连续工具往返，保持模型稳定', 'Tool round-trips keep the model stable')}</span></div></article>
      <button class="decision-boundary compact-boundary" type="button" data-boundary="compaction" aria-pressed="true" aria-controls="boundary-detail"><span class="boundary-symbol" aria-hidden="true">↻</span><strong>{t('上下文重建', 'Context rebuilt')}</strong><span class="boundary-status">{t('重新决策', 'DECIDE AGAIN')}</span><small>{t('回看执行表现', 'Assess prior work')}<br>{t('判断后续工作', 'Judge what comes next')}</small></button>
      <article class="execution-window second-window"><span class="eyebrow">{t('执行轮次 02', 'ROUTING TURN 02')}</span><h3>{t('转交主力模型 B', 'Hand off to primary B')}</h3><p>{t('示例：后续工作需要更强推理', 'Example: the next stage needs deeper reasoning')}</p><div class="tool-steps"><span>{t('回答', 'Answer')}</span><i>→</i><span>{t('工具', 'Tools')}</span><i>→</i><span>{t('继续', 'Continue')}</span></div><div class="cache-ribbon cache-b"><b>{t('在 B 上建立新前缀', 'Build a new prefix on B')}</b><span>{t('利用重建时机，再持续复用', 'Switch at rebuild, then reuse consistently')}</span></div></article>
      <button class="decision-boundary human-boundary" type="button" data-boundary="human" aria-pressed="false" aria-controls="boundary-detail"><span class="boundary-symbol" aria-hidden="true">＋</span><strong>{t('用户补充反馈', 'User feedback')}</strong><span class="boundary-status">{t('重新决策', 'DECIDE AGAIN')}</span><small>{t('新问题或新要求', 'New question or requirement')}<br>{t('也可以继续原模型', 'The same model may continue')}</small></button>
      <article class="execution-window third-window"><span class="eyebrow">{t('执行轮次 03', 'ROUTING TURN 03')}</span><h3>{t('继续使用模型 B', 'Continue with model B')}</h3><p>{t('示例：表现胜任，接着完成', 'Example: performance is competent')}</p><div class="tool-steps"><span>{t('回答', 'Answer')}</span><i>→</i><span>{t('工具', 'Tools')}</span><i>→</i><span>{t('继续', 'Continue')}</span></div><div class="cache-ribbon cache-b"><b>{t('B 的前缀继续追加', 'B’s prefix keeps growing')}</b><span>{t('重新判断不代表必须切换', 'Reassessment does not force a switch')}</span></div></article>
    </div>
    <div class="boundary-detail" id="boundary-detail" aria-live="polite"><div><span class="detail-kicker" id="boundary-kicker">{t('自主执行中的决策机会', 'A decision point during autonomous work')}</span><h3 id="boundary-title">{t('重建上下文时，可以重新选择。', 'A rebuilt context is a chance to choose again.')}</h3><p id="boundary-copy">{t('ContextHold 判断当前边界允许切换时，HiRoute 重新评估下一段工作；不要求客户端额外报告“发生了压缩”。', 'When ContextHold permits a switch, HiRoute reassesses the work ahead; the client need not send a separate compaction signal.')}</p></div><div class="boundary-outcome"><span>{t('这一节点的示例', 'At this point')}</span><p><b>{t('评估上一阶段', 'Assess the prior stage')}</b><span id="boundary-assessment">{t('回看模型 A 已完成的执行', 'Assess the work already performed by model A')}</span></p><p><b>{t('选择下一分支', 'Choose the next branch')}</b><span id="boundary-choice">{t('选择主力分支，让模型 B 接续', 'Choose the primary branch; model B takes over')}</span></p></div></div>
  </section>

  <section class="section wrap" id="product"><div class="section-title"><div><div class="eyebrow section-label">{t('02 / 先选择任务路径，再配置算力', '02 / Route the task. Then the compute.')}</div><h2>{t('按任务选择 Agent，', 'Choose the agent for the task.')}<br>{t('按需要配置模型与算力。', 'Then configure models and compute.')}</h2></div><p>{t('面向开发、研究、复杂分析与通用自动化，不把产品定义绑定在某个 Agent 上。', 'Designed for coding, research, deep analysis, and general automation—not around one hard-coded agent.')}</p></div><div class="features">
    <article class="feature"><span class="num">01—</span><h3>{t('按用途选择执行 Agent', 'Choose an agent by purpose')}</h3><p>{t('主 Agent 发现开放的工作计划，按目标委派任务并取得结果。任务委派与模型路由可独立启用。', 'A main agent discovers allowed work plans, delegates a goal, and retrieves the result. Delegation and model routing remain independent.')}</p></article>
    <article class="feature"><span class="num">02—</span><h3>{t('按需要配置模型与算力', 'Configure models and compute')}</h3><p>{t('组合模型来源、思考档位和候选顺序；可以智能省钱、固定模型或免费优先。', 'Compose model sources, reasoning profiles, and ordered candidates; use smart saving, fixed, or free-first routing.')}</p></article>
    <article class="feature"><span class="num">03—</span><h3>{t('让接力有边界', 'Keep failover bounded')}</h3><p>{t('候选满足工具、图像和上下文要求；候选耗尽时明确停止，开始交付后不透明换模。', 'Candidates satisfy tool, image, and context requirements; exhaustion stops explicitly and delivery is not silently switched.')}</p></article>
  </div></section>

  <section class="night" id="how"><div class="section wrap mechanism"><div><div class="eyebrow section-label">{t('03 / 由 TypeSafe Jev 提供决策能力', '03 / Powered by TypeSafe Jev')}</div><span class="jev-extension-label">{t('HiRoute 官方决策扩展', 'Official HiRoute decision extension')}</span><h2>{t('用 Jev 选择模型，', 'Let Jev choose the model.')}<br><em>{t('也评价之前的表现。', 'And assess the work so far.')}</em></h2><p class="explain">{t('同一次上游调用选择下一分支，并可对上一阶段给出胜任度评分。不是每个工具步骤都调用一次。', 'One upstream call chooses the next branch and can assess the previous stage. It is not called for every tool step.')}</p><p class="policy-principle">{t('胜任度只负责阻止冒险降本，', 'Competence blocks risky cost-cutting.')}<br>{t('复杂度负责提供降本机会。', 'Complexity creates opportunities to save.')}</p><p class="explain">{t('规则模式（rules）按简单概率与胜任度门槛执行；自动模式（auto）综合任务需要和历史表现直接选择。两种模式二选一。', 'Rules applies a simple-task probability and competence floor; auto chooses from task needs and prior performance. Choose one mode.')}</p><a class="button accent" href={en ? '/en/docs/jev-decider/' : '/docs/jev-decider/'}>{t('部署官方 Jev 扩展', 'Deploy the official Jev extension')} ↗</a><p class="jev-optional">{t('Jev 是可选扩展；也可使用内置规则或自建决策服务。', 'Jev is optional; built-in rules and custom decision services remain available.')}</p></div><div class="stage-track">
    <article class="stage"><span>01</span><div><span class="primitive-label">Score / {t('回看', 'LOOK BACK')}</span><h3>{t('之前的模型，是否胜任？', 'Was the previous model up to the job?')}</h3><p>{t('结合接受的回答、工具状态和用户反馈评价已经发生的执行。', 'Assess completed work from accepted output, tool outcomes, and user feedback.')}</p></div></article>
    <article class="stage"><span>02</span><div><span class="primitive-label">Choice / {t('选择', 'LOOK AHEAD')}</span><h3>{t('接下来的工作，该用哪个分支？', 'Which branch should handle the next stage?')}</h3><p>{t('auto 直接选允许分支；rules 使用简单/复杂概率并以胜任度限制冒险降本。', 'Auto chooses directly; rules uses simple/complex probability with competence as a guardrail.')}</p></div></article>
    <article class="stage"><span>03</span><div><span class="primitive-label">HiRoute / {t('执行与记录', 'EXECUTE AND RETAIN')}</span><h3>{t('让选择生效，让评价有归属', 'Apply the choice and attribute the score')}</h3><p>{t('HiRoute 执行分支，把评分记到此前实际执行的模型阶段。', 'HiRoute executes the branch and records the score against the model’s prior stage.')}</p><a class="text-link" href={en ? '/en/docs/decision-api/' : '/docs/decision-api/'}>{t('查看决策协议', 'Explore the decision contract')} →</a></div></article>
  </div></div></section>

  <section class="section wrap" id="performance">
    <div class="section-title"><div><div class="eyebrow section-label">{t('04 / 为下一次决策保留证据', '04 / Evidence for the next decision')}</div><h2>{t('不只知道选了谁，', 'See more than who was chosen.')}<br>{t('也看得见做得怎样。', 'See how the work went.')}</h2></div><p>{t('查看当前计划所选模型一段时间内的阶段胜任度，无需输入内部模型 ID。', 'Review stage competence over time for models selected by the current plan—without typing internal model IDs.')}</p></div>
    <figure class="product-shot"><img src={`/decision-assets/quality-${en ? 'en' : 'zh-CN'}.png`} alt={t('HiRoute 运行表现界面，包含阶段评分、未评分和部分历史', 'HiRoute runtime performance with stage scores, unrated work, and partial history')} loading="lazy"></figure>
    <p class="caption">{t('真实产品组件 · 演示数据，非模型评测。保留未评分、部分历史和评分尚未覆盖最新轮次等实际状态。', 'Real product components · Illustrative data, not a model benchmark. Unrated, partial, and not-yet-covered turns remain explicit.')}</p>
    <div class="proof-bottom"><article><h3>{t('分数始终带着范围', 'A score keeps its scope')}</h3><p>{t('评分属于具体计划、版本、模型和执行阶段；旧评分不会假装覆盖新增轮次。', 'A score belongs to a plan, revision, model, and execution stage; new turns are not silently covered by an older assessment.')}</p></article><article><h3>{t('证据可以帮助细分计划', 'Evidence can refine work plans')}</h3><p>{t('主 Agent 可查询高低分任务，结合证据判断是否需要建立更聚焦的工作场景。', 'A main agent can query high- and low-scoring tasks, inspect evidence, and propose a narrower work plan.')}</p></article></div>
    <div class="specialization"><div class="specialization-heading"><span class="eyebrow">{t('从执行证据到更合适的委派', 'From evidence to better delegation')}</span><h3>{t('任务更聚焦，模型就有更合适的位置。', 'Focused work gives each model a clearer role.')}</h3><p>{t('先看多次执行证据，再决定是否拆出更专门的场景。', 'Inspect repeated execution evidence before proposing a specialized scenario.')}</p></div><div class="specialization-flow"><article><span class="step-number">01 / {t('观察', 'OBSERVE')}</span><h4>{t('同一模型，不同任务表现不同', 'Performance varies by task')}</h4><p>{t('先按计划、版本和任务范围查看阶段证据。', 'Inspect stages by plan, revision, and task scope.')}</p></article><span class="flow-arrow">→</span><article><span class="step-number">02 / {t('细分', 'SPECIALIZE')}</span><h4>{t('明确更聚焦的工作场景', 'Define a narrower scenario')}</h4><p>{t('缩小范围，明确输入与验证条件。', 'Narrow the scope and make acceptance criteria explicit.')}</p></article><span class="flow-arrow">→</span><article><span class="step-number">03 / {t('委派', 'DELEGATE')}</span><h4>{t('把任务交给适合的计划', 'Delegate to the fitting plan')}</h4><p>{t('再观察后续表现，不凭单次低分自动改计划。', 'Observe later performance; one low score never rewrites a plan automatically.')}</p></article></div></div>
  </section>

  <section class="section wrap ecosystem-section" id="ecosystem">
    <div class="section-title"><div><div class="eyebrow section-label">{t('05 / Agent 生态', '05 / Agent ecosystem')}</div><h2>{t('不绑定一种 Agent，', 'Not tied to one agent.')}<br>{t('也不局限于编程。', 'Not limited to coding.')}</h2></div><p>{t('集成状态按真实支持范围开放；当前可用与规划方向明确分开。', 'Integration status follows real support; available and planned paths stay visibly separate.')}</p></div>
    <div class="ecosystem-groups"><article><h3>{t('当前适配', 'Available now')}</h3><div class="agent-names"><span>Codex</span><span>Claude Code</span></div></article><article class="ecosystem-planned"><h3>{t('后续方向', 'Planned')}</h3><div class="agent-names"><span>Qoder</span><span>Pi</span><span>DeepSeek Harness</span><span>OpenCode</span><span>Hermes Agent</span><span>OpenClaw</span></div><p>{t('具体顺序按真实适配和验证推进。', 'Order depends on real integration and validation.')}</p></article></div>
  </section>

  <section class="section wrap extension-section" id="extensions">
    <div><div class="eyebrow section-label">{t('06 / 一套接口，接入你的策略', '06 / Your policy, one interface')}</div><h2>{t('把你的判断方式，', 'Your decision policy.')}<br>{t('接入 HiRoute。', 'One HiRoute interface.')}</h2><p>{t('用 Jev、LLM 或自己的策略实现决策服务。通用协议支持允许分支选择与可选胜任度评分。', 'Build a decision service with Jev, an LLM, or your own policy. The general API supports allowed-branch choice and optional competence scoring.')}</p><a class="text-link" href={en ? '/en/docs/decision-api/' : '/docs/decision-api/'}>{t('决策 API 文档', 'Decision API documentation')} →</a><br><a class="text-link" href="/api/decision.openapi.json" download>{t('下载 OpenAPI', 'Download OpenAPI')} ↓</a></div>
    <div class="code-box"><div class="code-heading">{t('决策 API / 单次请求', 'DECISION API / SINGLE REQUEST')}</div><pre><code><span class="accent">POST</span> /v1/decisions

&#123;
  "branch_id": "smart_saving_simple",
  "assessment": &#123; "score": 0.82, "partial": false &#125;
&#125;</code></pre><span class="muted">{t('assessment 可选，并需要可评分历史目标', 'Assessment is optional and requires a history target')}</span></div>
  </section>

  <section class="section wrap" id="start">
    <div class="download-row"><div><div class="eyebrow section-label">{t('07 / 从 HiRoute 开始', '07 / Start with HiRoute')}</div><h2>{t('保留工作流，', 'Keep your workflow.')}<br>{t('重新安排算力。', 'Rearrange the compute.')}</h2><p>{release ? t(`稳定版本 ${release.version} 已通过统一发布清单提供 ${releaseKinds}。`, `Stable ${release.version} serves ${releaseKinds} through one release manifest.`) : t('公开版本正在准备中。macOS 使用桌面应用，Linux 可通过一条命令安装完整的无界面管理端。', 'The first public release is being prepared. Use Desktop on macOS or install the complete headless management surface on Linux with one command.')}</p><div class="actions"><a class="button" href={en ? '/en/download/' : '/download/'}>{t('选择安装方式', 'Choose an install path')} ↗</a><a class="button outline" href={en ? '/en/docs/' : '/docs/'}>{t('阅读快速开始', 'Read the Quickstart')} ↗</a></div></div>
      <div class="download-state">{release && linuxArtifact ? <><b>{t('Linux 无界面版', 'Linux headless')} · {release.version}</b><p>{linuxArtifact.architecture} · {formatBytes(linuxArtifact.size, language)}</p><code>curl -fsSL https://hiroute.ai/install.sh | sh</code><a class="text-link" href={en ? '/en/docs/install-linux/' : '/docs/install-linux/'}>{t('查看安装与启动步骤', 'Installation and startup')} →</a><span class="tag">SHA256 {linuxArtifact.sha256.slice(0, 12)}…</span></> : release && preferredArtifact ? <><b>HiRoute {release.version}</b><p>macOS {preferredArtifact.architecture} · {formatBytes(preferredArtifact.size, language)}</p><a class="button download-button" href={artifactUrl(release, preferredArtifact)}>{t('下载桌面应用', 'Download Desktop')}</a><span class="tag">{preferredArtifact.distribution === 'self-signed' ? t('自签名', 'SELF-SIGNED') : 'DEVELOPER ID'} · SHA256 {preferredArtifact.sha256.slice(0, 12)}…</span></> : <><b>{t('桌面应用 + 无界面版', 'Desktop + headless')}</b><p>{t('发布前先完成完整性检查、安装走查和发布审核。', 'Integrity checks, installation review, and release approval come first.')}</p><span class="tag">{t('准备中', 'IN PREPARATION')}</span></>}</div>
    </div>
  </section>

  <section class="section wrap faq-section" id="faq"><div class="eyebrow section-label">{t('08 / 常见问题', '08 / Questions')}</div><h2>{t('常见问题', 'Frequently asked questions')}</h2>
    <details><summary>{t('模型切换会破坏 KV cache 吗？', 'Does model switching destroy the KV cache?')}</summary><p>{t('不同模型不能共享 KV cache。HiRoute 在 ContextHold 允许重选的自然边界做决定；阶段内连续工具续轮保持模型稳定。实际命中仍取决于模型服务、配置和缓存生命周期。', 'Different models do not share KV cache. HiRoute decides at natural boundaries where ContextHold permits reselection; ordinary tool continuations stay on the same model. Actual hits still depend on provider, configuration, and cache lifetime.')}</p></details>
    <details id="history-faq"><summary>{t('上下文重建后，决策服务还能看到历史吗？', 'Can the decision service still see history after context rebuild?')}</summary><p>{t('可以看到 HiRoute 独立维护的简化 Agent 轮次历史：用户问题、接受的回答、工具名称与粗粒度状态、执行分支。它不是完整对话转录，淘汰或重启后可标记为部分历史。', 'It receives HiRoute’s independent simplified Agent-turn history: user input, accepted output, tool names and coarse outcomes, and executed branches. It is not a full transcript and can be marked partial after eviction or restart.')}</p></details>
    <details><summary>{t('一定要部署 Jev 吗？', 'Must I deploy Jev?')}</summary><p>{t('不需要。内置规则可以开始路由；Jev 是官方可选扩展，也可以按同一 Decision API 实现自己的服务。', 'No. Built-in rules are enough to start; Jev is an optional official extension, and you can implement your own service against the same Decision API.')}</p></details>
    <details><summary>{t('胜任度评分是不是成功率？', 'Is competence a success rate?')}</summary><p>{t('不是。它表达模型对具体执行阶段的胜任程度，必须结合计划、版本、评分覆盖范围和部分证据状态理解。', 'No. It represents competence for a specific execution stage and must be interpreted with plan, revision, assessment coverage, and partial-evidence state.')}</p></details>
    <details><summary>{t('安装包从哪里下载？', 'Where are installers served from?')}</summary><p>{t('下载链接直接指向 hiroute.ai/releases/<版本>/<文件名> 的不可变 OSS 对象；不存在的文件不会回退到首页。', 'Links point directly to immutable OSS objects under hiroute.ai/releases/<version>/<filename>; missing files never fall back to the homepage.')}</p></details>
  </section>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import DocsNav from './DocsNav.astro';
import { decisionPages, renderDecisionDoc } from '../lib/decision-docs.mjs';
import { localePath } from '../lib/locale.mjs';
import { breadcrumbs } from '../lib/seo.mjs';
const { language = 'zh', page } = Astro.props;
const english = language === 'en';
const { slug, title: titles, description } = decisionPages[page];
const title = titles[language].includes('HiRoute') ? titles[language] : `${titles[language]} · HiRoute`;
const path = localePath(language, `/docs/${slug}/`);
const alternatePath = localePath(english ? 'zh' : 'en', `/docs/${slug}/`);
const html = await renderDecisionDoc(page, language);
const trail = breadcrumbs([['HiRoute', localePath(language)], [english ? 'Docs' : '文档', localePath(language, '/docs/')], [decisionPages[page][language], path]]);
---
<SiteLayout language={language} title={title} description={description[language]}
  path={path} alternatePath={alternatePath} structuredData={[trail]}>
  <div class="docs-shell wrap">
    <DocsNav language={language} active={page} />
    <article class="docs-content" set:html={html} />
  </div>
</SiteLayout>

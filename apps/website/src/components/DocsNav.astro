---
const { language = 'zh', active } = Astro.props;
const en = language === 'en';
const prefix = en ? '/en' : '';
---
<aside class="docs-nav" aria-label={en ? 'HiRoute documentation' : 'HiRoute 文档'}>
  <span>{en ? 'GET STARTED' : '开始使用'}</span>
  <a class:list={{active:active === 'quickstart'}} href={`${prefix}/docs/`}>{en ? 'Quickstart' : '快速开始'}</a>
  <a class:list={{active:active === 'install-macos'}} href={`${prefix}/docs/install-macos/`}>{en ? 'Install on macOS' : 'macOS 安装与首次启动'}</a>
  <a class:list={{active:active === 'install-linux'}} href={`${prefix}/docs/install-linux/`}>{en ? 'Linux headless' : 'Linux 无界面版安装'}</a>

  <span>{en ? 'USE HIROUTE' : '使用 HIROUTE'}</span>
  <a class:list={{active:active === 'model-routing'}} href={`${prefix}/docs/model-routing/`}>{en ? 'Smart model routing' : '智能模型路由'}</a>
  <a class:list={{active:active === 'task-routing'}} href={`${prefix}/docs/task-routing/`}>{en ? 'Smart task routing' : '智能任务路由'}</a>
  <a class:list={{active:active === 'cli'}} href={`${prefix}/docs/cli/`}>HiRoute CLI</a>

  <span>{en ? 'DECISIONS' : '决策机制'}</span>
  <a class:list={{active:active === 'mechanism'}} href={`${prefix}/docs/decision-extensions/`}>{en ? 'Decision models and routing' : '决策模型与路由机制'}</a>
  <a class:list={{active:active === 'api'}} href={`${prefix}/docs/decision-api/`}>{en ? 'Custom extension API' : '自定义扩展 API'}</a>
  <a class:list={{active:active === 'jev'}} href={`${prefix}/docs/jev-decider/`}>{en ? 'Jev reference extension' : 'Jev 参考扩展'}</a>
  <a href="/api/decision.openapi.json" download>{en ? 'Download OpenAPI' : '下载 OpenAPI'}</a>
</aside>

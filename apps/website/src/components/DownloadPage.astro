---
import SiteLayout from '../layouts/SiteLayout.astro';
import { releaseManifest } from '../lib/releases.mjs';
import { architectureLabel, installPlatforms } from '../lib/install-platforms.mjs';
import ReleaseArtifact from './ReleaseArtifact.astro';
import InstallPlatforms from './InstallPlatforms.astro';
import InstallDetails from './InstallDetails.astro';
import InstallCommand from './InstallCommand.astro';
import { localePath } from '../lib/locale.mjs';
const { language = 'zh' } = Astro.props;
const t = (zh, en) => language === 'en' ? en : zh;
const stable = releaseManifest.releases.find(release => release.channel === 'stable');
const preview = releaseManifest.releases.find(release => release.channel === 'preview');
const platforms = installPlatforms(stable, language);
const guide = slug => localePath(language, `/docs/${slug}/`);
const formatDate = value => new Intl.DateTimeFormat(language === 'en' ? 'en' : 'zh-CN', { dateStyle: 'long' }).format(new Date(value));
---
<SiteLayout language={language} title={t('安装 HiRoute：macOS、Omarchy、Windows 与 Linux Server', 'Install HiRoute on macOS, Omarchy, Windows and Linux Server')}
  description={t('选择运行环境，下载 HiRoute 桌面应用或安装 Linux 服务。提供架构选择、签名校验、安装命令与首次启动步骤。', 'Choose your platform, download HiRoute Desktop or install the Linux service. Find architecture options, signature verification, commands and first-launch steps.')}
  path={localePath(language, '/download/')} alternatePath={localePath(language === 'en' ? 'zh' : 'en', '/download/')}>
  <section class="page-hero wrap download-hero">
    <div class="eyebrow section-label">{t('开始使用', 'GET STARTED')}</div>
    <h1>{t('安装 HiRoute', 'Install HiRoute')}</h1>
    <p>{t('选择你的运行环境。用桌面应用管理本机，或用 Web UI 与 CLI 管理服务器。', 'Choose your environment. Use the desktop app on your computer, or the Web UI and CLI on a server.')}</p>
    {stable && <div class="release-meta">
      <span class="release-channel">{t(`稳定版 ${stable.version}`, `Stable ${stable.version}`)}</span>
      <time datetime={stable.published_at}>{formatDate(stable.published_at)}</time>
      <a class="text-link" href={localePath(language, '/changelog/')}>{t('更新日志', 'Changelog')} →</a>
    </div>}
  </section>

  <section class="wrap install-picker" data-install-picker aria-label={t('选择并安装', 'Choose and install')}>
    <InstallPlatforms platforms={platforms} language={language} picker />
    <div class="install-prompt" data-install-prompt hidden>
      <span aria-hidden="true">↑</span>
      <h2>{t('从你的运行环境开始', 'Start with your environment')}</h2>
      <p>{t('选择上方卡片，查看安装包和完整步骤。', 'Choose a card above to see the download and installation steps.')}</p>
    </div>
    {platforms.map(platform => <article class="install-panel" id={platform.id} data-install-panel aria-labelledby={`${platform.id}-heading`}>
      <header class="install-panel-heading">
        <div><span class="install-platform-type">{platform.type}</span><h2 id={`${platform.id}-heading`}>{platform.name}</h2></div>
        <a class="text-link" href={guide(platform.guide)}>{t('安装指南', 'Installation guide')} →</a>
      </header>
      {platform.artifacts.length === 0 ? <p class="install-unavailable">{t('此平台暂未提供稳定版安装包。可先阅读安装指南，了解运行要求。', 'A stable package is not available for this platform yet. Read the installation guide for its requirements.')}</p> : <>
        <p class="install-requirements">
          {platform.id === 'macos' && t(`macOS ${platform.artifacts[0].minimum_os} 或更高版本。在“关于本机”中确认 Apple 芯片或 Intel。`, `macOS ${platform.artifacts[0].minimum_os} or later. Check About This Mac for Apple silicon or Intel.`)}
          {platform.id === 'omarchy' && t('Omarchy 桌面环境。运行 uname -m 确认架构，安装时需要 sudo。', 'Omarchy desktop environment. Run uname -m to check your architecture. Installation requires sudo.')}
          {platform.id === 'windows' && t('Windows x64 · 按当前用户安装 · 自带服务与 CLI', 'Windows x64 · Per-user installation · Service and CLI included')}
          {platform.id === 'linux' && t('x86_64 或 ARM64 · glibc 2.31+ · curl 与 Python 3 · 按当前用户安装', 'x86_64 or ARM64 · glibc 2.31+ · curl and Python 3 · Per-user installation')}
        </p>
        {platform.kind === 'desktop' ? <>
          {platform.artifacts.length > 1 && <nav class="install-architectures" aria-label={t(`${platform.name} 芯片架构`, `${platform.name} architecture`)}>
            {platform.artifacts.map(artifact => <a href={`#${platform.id}-${artifact.architecture}`} data-install-architecture>
              {architectureLabel(platform.id, artifact.architecture, language)}
            </a>)}
          </nav>}
          {platform.artifacts.map(artifact => <InstallDetails release={stable} artifact={artifact} platform={platform} language={language} />)}
        </> : <>
          <ol class="install-steps">
            <li><h3>{t('安装 HiRoute', 'Install HiRoute')}</h3>
              <p>{t('安装器自动识别架构，下载并校验最新稳定版，安装到 ~/.local。', 'The installer detects your architecture, downloads and verifies the latest stable release, and installs under ~/.local.')}</p>
              <InstallCommand command="curl -fsSL https://hiroute.ai/install.sh | sh" language={language} label={t('安装命令', 'installation command')} />
              <details class="install-verification"><summary>{t('先查看脚本', 'Inspect the script first')}</summary>
                <InstallCommand command="curl -fsSLo install.sh https://hiroute.ai/install.sh && less install.sh" language={language} label={t('脚本检查命令', 'script inspection command')} />
                <p>{t('查看并确认刚下载的脚本后，再运行它。', 'After reviewing the downloaded script, run it.')}</p>
                <InstallCommand command="sh install.sh" language={language} label={t('已审阅脚本的执行命令', 'command to run the reviewed script')} />
              </details>
            </li>
            <li><h3>{t('启动并检查服务', 'Start and check the service')}</h3>
              <InstallCommand command={'hiroute service start\nhiroute system status'} language={language} label={t('服务启动与检查命令', 'service startup and status commands')} />
              <p>{t('如果找不到 hiroute，请将 ~/.local/bin 加入 PATH 后重新打开终端。', 'If hiroute is not found, add ~/.local/bin to PATH and open a new terminal.')}</p>
            </li>
            <li><h3>{t('连接模型，开始使用', 'Connect a model and get started')}</h3>
              <p>{t('使用 CLI 完成配置，或按指南启用 Web UI，在浏览器中管理模型、路由和 Agent。', 'Configure HiRoute with the CLI, or follow the guide to enable the Web UI and manage models, routes and Agents in your browser.')}</p>
              <a class="text-link" href={guide('install-linux')}>{t('启用 Web UI 与远程访问', 'Enable the Web UI and remote access')} →</a>
            </li>
          </ol>
          <details class="install-verification"><summary>{t('校验与其他下载', 'Checksums and other downloads')}</summary>
            <p>{t('离线安装或手动校验时，下载对应架构的归档与伴随清单。', 'For offline installation or manual verification, download the archive and companion manifest for your architecture.')}</p>
            <div class="artifact-list">{platform.artifacts.map(artifact => <ReleaseArtifact release={stable} artifact={artifact} language={language} />)}</div>
          </details>
          <div class="install-next"><a class="text-link" href={guide('models')}>{t('接入第一个模型', 'Connect your first model')} →</a><a class="text-link" href={guide('cli')}>{t('CLI 使用指南', 'CLI guide')} →</a></div>
        </>}
      </>}
    </article>)}
  </section>
  {preview && <section class="content-section wrap release-section" id="preview">
    <details class="install-verification"><summary>{t(`预览版 ${preview.version}`, `Preview ${preview.version}`)}</summary>
      <p>{preview.notes[language]}</p>
      <div class="artifact-list">{preview.artifacts.map(artifact => <ReleaseArtifact release={preview} artifact={artifact} language={language} />)}</div>
    </details>
  </section>}
  <script is:inline src="/scripts/install.js" defer></script>
</SiteLayout>

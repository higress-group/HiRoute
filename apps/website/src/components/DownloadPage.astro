---
import SiteLayout from '../layouts/SiteLayout.astro';
import { artifactUrl, formatBytes, releaseManifest } from '../lib/releases.mjs';
import ReleaseArtifact from './ReleaseArtifact.astro';
import { localePath } from '../lib/locale.mjs';
const { language = 'zh' } = Astro.props;
const en = language === 'en';
const t = (zh, english) => en ? english : zh;
const path = localePath(language, '/download/');
const alternatePath = localePath(en ? 'zh' : 'en', '/download/');
const docs = slug => localePath(language, `/docs/${slug}/`);
const changelog = localePath(language, '/changelog/');
const formatDate = value => new Intl.DateTimeFormat(en ? 'en' : 'zh-CN', { dateStyle: 'long' }).format(new Date(value));
const stable = releaseManifest.releases.find(release => release.channel === 'stable');
const preview = releaseManifest.releases.find(release => release.channel === 'preview');
const stableArtifacts = (kind, platform) => stable?.artifacts.filter(artifact => artifact.kind === kind && artifact.platform === platform) ?? [];
const macArtifacts = stableArtifacts('desktop', 'macOS').sort((a, b) => Number(a.architecture !== 'arm64') - Number(b.architecture !== 'arm64'));
const macMinimum = macArtifacts[0]?.minimum_os ?? '15.0';
const stableLinux = stableArtifacts('standalone', 'Linux');
const linuxArchitectures = stableLinux.map(artifact => artifact.architecture).join(' / ');
const distributionLabel = distribution => distribution === 'unsigned' ? t('未签名 · 请核对 SHA-256', 'Unsigned · verify SHA-256')
  : distribution === 'self-signed' ? t('自签名 · 首次打开需手动确认', 'Self-signed · approve on first launch') : t('Developer ID 签名与公证', 'Developer ID signed and notarized');
const desktopPlatforms = [{
  id: 'macos', name: 'macOS', artifacts: macArtifacts, button: t('下载 DMG', 'Download DMG'),
  summary: t(`需要 macOS ${macMinimum} 或更高版本。应用内运行本机服务，可在设置中安装 CLI。`, `Requires macOS ${macMinimum} or later. The app runs the local service and can install the CLI from Settings.`),
  option: artifact => artifact.architecture === 'arm64' ? [t('Apple 芯片', 'Apple silicon'), 'arm64 · DMG'] : [t('Intel 芯片', 'Intel'), `${artifact.architecture} · DMG`],
  guide: docs('install-macos'), guideLabel: t('安装与首次启动', 'Install and first launch'),
}, {
  id: 'windows', name: 'Windows', artifacts: stableArtifacts('desktop', 'Windows'), button: t('下载安装包', 'Download installer'),
  summary: t('适用于 Windows x64。按当前用户安装，自带服务与 CLI，不需要管理员权限。', 'For Windows x64. Installs for the current user with the service and CLI included; no administrator rights required.'),
  option: () => [t('x64 安装包', 'x64 installer'), 'NSIS'],
  guide: docs('install-windows'), guideLabel: t('SmartScreen 提示与安装步骤', 'SmartScreen prompt and installation'),
}];
---
<SiteLayout language={language} title={t('下载 HiRoute：macOS、Windows 桌面应用与 Linux', 'Download HiRoute for macOS, Windows and Linux')}
  description={t('下载 HiRoute：macOS / Windows 桌面应用，Linux Web UI 与 CLI。', 'Download HiRoute: macOS / Windows Desktop and Linux Web UI and CLI.')}
  path={path} alternatePath={alternatePath}>
  <section class="page-hero wrap download-hero"><div class="eyebrow section-label">{t('下载', 'DOWNLOAD')}</div><h1>{t('下载 HiRoute', 'Download HiRoute')}</h1><p>{t('macOS 与 Windows 桌面应用自带本机服务，安装后即可在应用中接入模型、配置路由和 Agent。服务器和远程工作站可以使用 Linux Web UI 与 CLI。', 'macOS and Windows Desktop include the local service, so you can set up models, routes and Agents right in the app. Servers and remote workstations can use the Linux Web UI and CLI.')}</p>
    {stable && <div class="release-meta"><span class="release-channel">{t(`稳定版 ${stable.version}`, `Stable ${stable.version}`)}</span><time datetime={stable.published_at}>{formatDate(stable.published_at)}</time><a class="text-link" href={changelog}>{t('更新日志', 'Changelog')} →</a></div>}
  </section>

  <section class="content-section wrap desktop-downloads">
    {stable ? <div class="platform-grid">{desktopPlatforms.map(platform => <article class="platform-card" id={platform.id}>
      <div><span class="platform-kind">{t('桌面应用', 'Desktop')}</span><h2>{platform.name}</h2><p>{platform.artifacts.length > 0 ? platform.summary : t('安装包准备中，通过完整性检查、安装走查和发布审核后出现在这里。', 'The package appears here after integrity checks, installation review and release approval.')}</p></div>
      {platform.artifacts.length > 0 && <div class="platform-options">{platform.artifacts.map((artifact, index) => {
        const [label, detail] = platform.option(artifact);
        return <div class="platform-option"><div><strong>{label}</strong><span>{detail} · {formatBytes(artifact.size, language)}</span></div><a class:list={['button', { outline: index > 0 }]} href={artifactUrl(stable, artifact)}>{platform.button}</a><code>SHA256 {artifact.sha256}</code></div>;
      })}</div>}
      <div class="platform-foot">{[...new Set(platform.artifacts.map(artifact => artifact.distribution))].map(distribution => <span class:list={['distribution-badge', { 'self-signed': distribution === 'self-signed' }]}>{distributionLabel(distribution)}</span>)}<a class="text-link" href={platform.guide}>{platform.guideLabel} →</a></div>
    </article>)}</div> : <div class="empty-release"><span>{t('准备中', 'IN PREPARATION')}</span><h2>{t('首个公开版本尚未发布', 'The first public release is not published yet')}</h2><p>{t('安装包通过完整性检查、安装走查和发布审核后才会出现在这里。你可以先阅读快速开始。', 'Packages appear here only after integrity checks, installation review, and release approval. Start with the Quickstart in the meantime.')}</p><div class="actions"><a class="button" href={localePath(language, '/docs/')}>{t('快速开始', 'Quickstart')} ↗</a></div></div>}
  </section>

  <section class="content-section wrap linux-section" id="linux">
    <div class="platform-heading"><div><span class="platform-kind">{t('Web UI 与 CLI', 'Web UI and CLI')}</span><h2>Linux</h2><p>{t('适合服务器、远程工作站和自动化环境。启用 Web UI 后，可以在另一台电脑的浏览器中接入模型、配置路由和 Agent、查看会话；也可以只用 CLI。', 'For servers, remote workstations and automation. With the Web UI enabled, connect models, configure routes and Agents, and inspect sessions from a browser on another computer, or use only the CLI.')}</p></div><a class="text-link" href={docs('install-linux')}>{t('Linux 安装与 Web UI', 'Linux installation and Web UI')} →</a></div>
    <div class:list={['install-command', { unavailable: stableLinux.length === 0 }]}>
      <span>{stableLinux.length > 0 ? t(`一条命令，按当前用户安装 · ${linuxArchitectures}`, `One command, installed for the current user · ${linuxArchitectures}`) : t('首个 Linux 稳定包准备中', 'First stable Linux package in preparation')}</span>
      <pre><code>curl -fsSL https://hiroute.ai/install.sh | sh</code></pre>
      <p>{stableLinux.length > 0 ? t('安装器识别架构，下载最新稳定版并校验后安装到 ~/.local；不使用 sudo，也不会自动启动服务。安装后运行 hiroute service start，再用 hiroute system status 确认服务。Web UI 默认关闭，按 Linux 指南启用。', 'The installer detects the architecture, downloads the latest stable release, verifies it and installs under ~/.local. It uses no sudo and never starts the service automatically. Afterwards, run hiroute service start and confirm readiness with hiroute system status. The Web UI is off by default; enable it with the Linux guide.') : t('命令已经纳入发布流程；在首个稳定包通过完整性检查和安装走查后开放。当前执行会明确返回“尚无稳定包”，不会下载候选构建。', 'The command is wired into the release flow and becomes active after the first stable package passes integrity and installation review. Until then it exits clearly instead of downloading a candidate build.')}</p>
    </div>
    <div class="install-extras">
      <details class="review-install"><summary>{t('希望先查看脚本？', 'Prefer to inspect the script first?')}</summary><pre><code>curl -fsSLo install.sh https://hiroute.ai/install.sh
less install.sh
sh install.sh</code></pre></details>
      {stableLinux.length > 0 && <details class="review-install manual-archives"><summary>{t('手动下载归档与伴随清单', 'Manual archives and companion manifests')}</summary><p>{t('用于离线安装、镜像和审计。', 'For offline installation, mirroring and audits.')}</p><div class="artifact-list">{stableLinux.map(artifact => <ReleaseArtifact release={stable} artifact={artifact} language={language} />)}</div></details>}
    </div>
  </section>

  {preview && <section class="content-section wrap release-section" id="preview"><article class="release-card"><div class="release-heading"><div><span class="release-channel">{t('预览版', 'Preview')}</span><h2>HiRoute {preview.version}</h2><p>{preview.notes[language]}</p></div><time datetime={preview.published_at}>{formatDate(preview.published_at)}</time></div><div class="artifact-list">{preview.artifacts.map(artifact => <ReleaseArtifact release={preview} artifact={artifact} language={language} />)}</div></article></section>}

  <section class="content-section wrap install-note"><h2>{t('安装须知', 'Before you install')}</h2><ol><li>{t('下载后，用安装包旁的完整 SHA256 核对文件。', 'After downloading, verify the file against the full SHA256 shown next to it.')}</li><li>{t(`macOS 桌面应用要求 macOS ${macMinimum} 或更高版本：Apple 芯片选择 arm64，Intel 芯片选择 x86_64。`, `macOS Desktop requires macOS ${macMinimum} or later. Choose arm64 for Apple silicon and x86_64 for Intel.`)}</li><li>{t('Windows 桌面应用只支持 x64，按当前用户安装，不需要管理员权限。', 'Windows Desktop supports x64 only and installs for the current user without administrator rights.')}</li><li>{t('Linux 独立服务版按当前用户安装。安装完成后由你启动服务并检查状态。', 'Linux standalone installs for the current user. Start the service and verify its status after installing.')}</li><li>{t('Omarchy 桌面应用与 CLI 共用当前用户的兼容 Linux 服务。macOS 和 Windows 桌面应用使用各自的服务。', 'Omarchy Desktop and the CLI share the current user’s compatible Linux service. The macOS and Windows apps use their own services.')}</li></ol><div class="self-signed-note"><strong>{t('关于 macOS 自签名版本', 'About self-signed macOS builds')}</strong><p>{t('短期发布没有 Apple Developer ID 签名和公证。macOS 首次阻止启动时，请在“系统设置 → 隐私与安全性”中确认“仍要打开”；不需要关闭 Gatekeeper 或 SIP。', 'Near-term releases do not have an Apple Developer ID signature or notarization. If macOS blocks the first launch, approve Open Anyway under System Settings → Privacy & Security. Do not disable Gatekeeper or SIP.')}</p><a class="text-link" href={docs('install-macos')}>{t('查看完整 macOS 步骤', 'Read the macOS installation steps')} →</a></div><div class="self-signed-note"><strong>{t('关于 Windows 未签名版本', 'About unsigned Windows builds')}</strong><p>{t('下载后先核对 SHA-256；遇到 SmartScreen 未知发布者提示时，按安装指南确认来源后继续。', 'Verify SHA-256 before opening the installer; follow the installation guide for a SmartScreen unknown-publisher prompt.')}</p><a class="text-link" href={docs('install-windows')}>{t('查看 Windows 安装与恢复步骤', 'Read Windows installation and recovery steps')} →</a></div><a class="text-link" href={changelog}>{t('查看更新日志', 'View changelog')} →</a></section>
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import { releaseManifest } from '../lib/releases.mjs';
import ReleaseArtifact from './ReleaseArtifact.astro';
const { language = 'zh' } = Astro.props;
const en = language === 'en';
const t = (zh, english) => en ? english : zh;
const channelLabel = channel => en ? channel : channel === 'stable' ? '稳定版' : channel === 'preview' ? '预览版' : channel;
const path = en ? '/en/download/' : '/download/';
const alternatePath = en ? '/download/' : '/en/download/';
const stable = releaseManifest.releases.find(release => release.channel === 'stable');
const preview = releaseManifest.releases.find(release => release.channel === 'preview');
const shown = [stable, preview].filter((release, index, all) => release && all.indexOf(release) === index);
const stableLinux = stable?.artifacts.filter(artifact => artifact.kind === 'standalone' && artifact.platform === 'Linux') ?? [];
const linuxArchitectures = stableLinux.map(artifact => artifact.architecture).join(' / ');
---
<SiteLayout language={language} title={t('下载 HiRoute', 'Download HiRoute') + ' · HiRoute'}
  description={t('在 macOS 或 Windows 使用桌面应用，或在 Linux 安装 HiRoute 无界面版。', 'Use HiRoute Desktop on macOS or Windows, or install HiRoute headless on Linux.')}
  path={path} alternatePath={alternatePath}>
  <section class="page-hero wrap"><div class="eyebrow section-label">{t('下载', 'DOWNLOAD')}</div><h1>{t('选择你的运行方式', 'Choose how to run HiRoute')}</h1><p>{t('macOS 与 Windows 提供可视化桌面应用；Linux 提供面向服务器和自动化环境的无界面命令行。选择适合你的安装包，并可通过 SHA256 校验文件完整性。', 'macOS and Windows provide the visual Desktop app. Linux provides a headless CLI for servers and automation. Choose the package for your platform and verify its integrity with the provided SHA256 checksum.')}</p></section>

  <section class="content-section wrap platform-install">
    <div class="platform-heading"><div><span class="release-channel">{t('Linux · 无界面版', 'Linux · headless')}</span><h2>{t('一条命令，按当前用户安装', 'One command, installed for the current user')}</h2><p>{t('安装器识别 x86_64 或 aarch64，下载最新稳定版，校验后安装到 ~/.local；不使用 sudo，也不会自动启动服务。', 'The installer detects x86_64 or aarch64, downloads the latest stable release, verifies it, and installs under ~/.local. It uses no sudo and does not start the service automatically.')}</p></div><a class="text-link" href={en ? '/en/docs/install-linux/' : '/docs/install-linux/'}>{t('Linux 无界面版指南', 'Linux headless guide')} →</a></div>
    <div class:list={['install-command', { unavailable: stableLinux.length === 0 }]}>
      <span>{stableLinux.length > 0 ? t(`稳定版 ${stable.version} · ${linuxArchitectures}`, `Stable ${stable.version} · ${linuxArchitectures}`) : t('首个 Linux 稳定包准备中', 'First stable Linux package in preparation')}</span>
      <pre><code>curl -fsSL https://hiroute.ai/install.sh | sh</code></pre>
      <p>{stableLinux.length > 0 ? t('安装完成后，显式运行 hiroute service start，再用 system status 确认服务。', 'After installation, run hiroute service start explicitly, then confirm readiness with system status.') : t('命令已经纳入发布流程；在首个稳定包通过完整性检查和安装走查后开放。当前执行会明确返回“尚无稳定包”，不会下载候选构建。', 'The command is wired into the release flow and becomes active after the first stable package passes integrity and installation review. Until then it exits clearly instead of downloading a candidate build.')}</p>
    </div>
    <details class="review-install"><summary>{t('希望先查看脚本？', 'Prefer to inspect the script first?')}</summary><pre><code>curl -fsSLo install.sh https://hiroute.ai/install.sh
less install.sh
sh install.sh</code></pre></details>
  </section>

  <section class="content-section wrap release-section">
    <div class="platform-heading"><div><span class="release-channel">{t('桌面应用 / 手动包', 'Desktop / manual packages')}</span><h2>{t('版本与发布文件', 'Versions and release files')}</h2><p>{t('macOS 下载 DMG，Windows x64 下载 NSIS 安装包；Linux 一行安装是推荐入口，归档与伴随清单仍保留给离线、镜像和审计场景。', 'Download a DMG for macOS or an NSIS installer for Windows x64. The one-line command is the recommended Linux path; archives and companion manifests remain available for offline, mirroring, and audit workflows.')}</p></div></div>
    {shown.length === 0 ? <div class="empty-release"><span>{t('准备中', 'IN PREPARATION')}</span><h2>{t('首个公开版本尚未发布', 'The first public release is not published yet')}</h2><p>{t('安装包通过完整性检查、安装走查和发布审核后才会出现在这里。你可以先阅读快速开始。', 'Packages appear here only after integrity checks, installation review, and release approval. Start with the Quickstart in the meantime.')}</p><div class="actions"><a class="button" href={en ? '/en/docs/' : '/docs/'}>{t('快速开始', 'Quickstart')} ↗</a></div></div> : shown.map(release => <article class="release-card"><div class="release-heading"><div><span class="release-channel">{channelLabel(release.channel)}</span><h2>HiRoute {release.version}</h2><p>{release.notes[language]}</p></div><time datetime={release.published_at}>{new Intl.DateTimeFormat(en ? 'en' : 'zh-CN', { dateStyle: 'long' }).format(new Date(release.published_at))}</time></div><div class="artifact-list">{release.artifacts.map(artifact => <ReleaseArtifact release={release} artifact={artifact} language={language} />)}</div></article>)}
  </section>

  <section class="content-section wrap install-note"><h2>{t('安装边界', 'Installation boundaries')}</h2><ol><li>{t('Linux 无界面版按当前用户安装，不要求 root；桌面应用与独立服务版（standalone）不应在同一 HOME 中同时管理服务。', 'Linux headless is a per-user installation with no root requirement. Desktop and standalone must not manage the service in the same HOME.')}</li><li>{t('Linux 安装不会自动启动服务；安装完成后由你显式启动并检查状态。', 'Linux installation never starts the service automatically; start it explicitly and verify status after installation.')}</li><li>{t('macOS 桌面应用当前要求 macOS 15.0 或更高版本，架构必须与设备匹配。', 'The current Desktop package requires macOS 15.0 or later and must match the device architecture.')}</li></ol><div class="self-signed-note"><strong>{t('关于 macOS 自签名版本', 'About self-signed macOS builds')}</strong><p>{t('短期发布没有 Apple Developer ID 签名和公证。macOS 首次阻止启动时，请在“系统设置 → 隐私与安全性”中确认“仍要打开”；不需要关闭 Gatekeeper 或 SIP。', 'Near-term releases do not have an Apple Developer ID signature or notarization. If macOS blocks the first launch, approve Open Anyway under System Settings → Privacy & Security. Do not disable Gatekeeper or SIP.')}</p><a class="text-link" href={en ? '/en/docs/install-macos/' : '/docs/install-macos/'}>{t('查看完整 macOS 步骤', 'Read the macOS installation steps')} →</a></div><div class="self-signed-note"><strong>{t('关于 Windows 未签名版本', 'About unsigned Windows builds')}</strong><p>{t('Windows 桌面版按当前用户安装，只支持 x64。下载后先核对 SHA-256；遇到 SmartScreen 未知发布者提示时，按安装指南确认来源后继续。', 'Windows Desktop installs for the current user and supports x64. Verify SHA-256 before opening it; follow the installation guide for a SmartScreen unknown-publisher prompt.')}</p><a class="text-link" href={en ? '/en/docs/install-windows/' : '/docs/install-windows/'}>{t('查看 Windows 安装与恢复步骤', 'Read Windows installation and recovery steps')} →</a></div><a class="text-link" href={en ? '/en/changelog/' : '/changelog/'}>{t('查看更新日志', 'View changelog')} →</a></section>
</SiteLayout>

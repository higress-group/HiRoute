---
import SiteLayout from '../layouts/SiteLayout.astro';
import { artifactManifestUrl, artifactUrl, formatBytes, releaseManifest } from '../lib/releases.mjs';
const { language = 'zh' } = Astro.props;
const en = language === 'en';
const t = (zh, english) => en ? english : zh;
const channelLabel = channel => en ? channel : channel === 'stable' ? '稳定版' : channel === 'preview' ? '预览版' : channel;
const path = en ? '/en/download/' : '/download/';
const alternatePath = en ? '/download/' : '/en/download/';
const stable = releaseManifest.releases.find(release => release.channel === 'stable');
const preview = releaseManifest.releases.find(release => release.channel === 'preview');
const shown = [stable, preview].filter((release, index, all) => release && all.indexOf(release) === index);
const stableLinux = stable?.artifacts.filter(artifact => artifact.kind === 'standalone') ?? [];
const linuxArchitectures = stableLinux.map(artifact => artifact.architecture).join(' / ');
---
<SiteLayout language={language} title={t('下载 HiRoute', 'Download HiRoute') + ' · HiRoute'}
  description={t('在 macOS 使用桌面应用，或在 Linux 用一条命令安装 HiRoute 无界面版。', 'Use HiRoute Desktop on macOS or install HiRoute headless on Linux with one command.')}
  path={path} alternatePath={alternatePath}>
  <section class="page-hero wrap"><div class="eyebrow section-label">{t('下载', 'DOWNLOAD')}</div><h1>{t('选择你的运行方式', 'Choose how to run HiRoute')}</h1><p>{t('macOS 提供可视化桌面应用；Linux 提供面向服务器和自动化环境的无界面命令行。发布文件都来自 hiroute.ai 的不可变 OSS 对象，并公开版本与 SHA256。', 'macOS provides the visual Desktop app. Linux provides a headless CLI for servers and automation. Every published file is an immutable hiroute.ai OSS object with a declared version and SHA256.')}</p></section>

  <section class="content-section wrap platform-install">
    <div class="platform-heading"><div><span class="release-channel">{t('Linux · 无界面版', 'Linux · headless')}</span><h2>{t('一条命令，按当前用户安装', 'One command, installed for the current user')}</h2><p>{t('安装器识别 x86_64 或 aarch64，下载稳定版的不可变清单和归档，验证内容后安装到 ~/.local；不使用 sudo，也不会自动启动服务。', 'The installer detects x86_64 or aarch64, downloads the stable immutable manifest and archive, verifies them, and installs under ~/.local. It uses no sudo and does not start the service automatically.')}</p></div><a class="text-link" href={en ? '/en/docs/install-linux/' : '/docs/install-linux/'}>{t('Linux 无界面版指南', 'Linux headless guide')} →</a></div>
    <div class:list={['install-command', { unavailable: stableLinux.length === 0 }]}>
      <span>{stableLinux.length > 0 ? t(`稳定版 ${stable.version} · ${linuxArchitectures}`, `Stable ${stable.version} · ${linuxArchitectures}`) : t('首个 Linux 稳定包准备中', 'First stable Linux package in preparation')}</span>
      <pre><code>curl -fsSL https://hiroute.ai/install.sh | sh</code></pre>
      <p>{stableLinux.length > 0 ? t('安装完成后，显式运行 hiroute service start，再用 system status 确认服务。', 'After installation, run hiroute service start explicitly, then confirm readiness with system status.') : t('命令已经纳入发布流程；在首个稳定包通过完整性检查和安装走查后开放。当前执行会明确返回“尚无稳定包”，不会下载候选构建。', 'The command is wired into the release flow and becomes active after the first stable package passes integrity and installation review. Until then it exits clearly instead of downloading a candidate build.')}</p>
    </div>
    <details class="review-install"><summary>{t('希望先查看脚本？', 'Prefer to inspect the script first?')}</summary><pre><code>curl -fsSLo install.sh https://hiroute.ai/install.sh
less install.sh
sh install.sh</code></pre></details>
  </section>

  <section class="content-section wrap release-section">
    <div class="platform-heading"><div><span class="release-channel">macOS · {t('桌面应用 / 手动包', 'Desktop / manual packages')}</span><h2>{t('版本与发布文件', 'Versions and release files')}</h2><p>{t('桌面应用直接下载 DMG；Linux 一行安装是推荐入口，归档与伴随清单仍保留给离线、镜像和审计场景。', 'Download a DMG for Desktop. The one-line command is the recommended Linux path; archives and companion manifests remain available for offline, mirroring, and audit workflows.')}</p></div></div>
    {shown.length === 0 ? <div class="empty-release"><span>{t('准备中', 'IN PREPARATION')}</span><h2>{t('首个公开版本尚未发布', 'The first public release is not published yet')}</h2><p>{t('安装包通过完整性检查、安装走查和发布审核后才会出现在这里。你可以先阅读快速开始。', 'Packages appear here only after integrity checks, installation review, and release approval. Start with the Quickstart in the meantime.')}</p><div class="actions"><a class="button" href={en ? '/en/docs/' : '/docs/'}>{t('快速开始', 'Quickstart')} ↗</a></div></div> : shown.map(release => <article class="release-card"><div class="release-heading"><div><span class="release-channel">{channelLabel(release.channel)}</span><h2>HiRoute {release.version}</h2><p>{release.notes[language]}</p></div><time datetime={release.published_at}>{new Intl.DateTimeFormat(en ? 'en' : 'zh-CN', { dateStyle: 'long' }).format(new Date(release.published_at))}</time></div><div class="artifact-list">{release.artifacts.map(artifact => artifact.kind === 'desktop' ? <div class="artifact-row"><div><strong>{t('macOS 桌面应用', 'macOS Desktop')} · {artifact.architecture}</strong><span>{t(`最低 macOS ${artifact.minimum_os}`, `macOS ${artifact.minimum_os}+`)}</span><span class:list={['distribution-badge', { 'self-signed': artifact.distribution === 'self-signed' }]}>{artifact.distribution === 'self-signed' ? t('自签名 · 首次启动需手动确认', 'Self-signed · manual approval required on first launch') : t('Developer ID 签名与公证', 'Developer ID signed and notarized')}</span><code>SHA256 {artifact.sha256}</code></div><a class="button" href={artifactUrl(release, artifact)}>{t('下载 DMG', 'Download DMG')} · {formatBytes(artifact.size, language)}</a></div> : <div class="artifact-row"><div><strong>{t('Linux 无界面版', 'Linux headless')} · {artifact.architecture}</strong><span>{artifact.target} · {formatBytes(artifact.size, language)}</span><span class="distribution-badge">{t('未签名 · 清单与 SHA256 验证', 'Unsigned · manifest and SHA256 verified')}</span><code>SHA256 {artifact.sha256}</code><a class="companion-link" href={artifactManifestUrl(release, artifact)} download>{t('下载伴随清单', 'Download companion manifest')}</a></div><a class="button outline" href={artifactUrl(release, artifact)}>{t('手动下载归档', 'Manual archive')} ↓</a></div>)}</div></article>)}
  </section>

  <section class="content-section wrap install-note"><h2>{t('安装边界', 'Installation boundaries')}</h2><ol><li>{t('Linux 无界面版按当前用户安装，不要求 root；桌面应用与独立服务版（standalone）不应在同一 HOME 中同时管理服务。', 'Linux headless is a per-user installation with no root requirement. Desktop and standalone must not manage the service in the same HOME.')}</li><li>{t('Linux 安装不会自动启动服务；安装完成后由你显式启动并检查状态。', 'Linux installation never starts the service automatically; start it explicitly and verify status after installation.')}</li><li>{t('macOS 桌面应用当前要求 macOS 15.0 或更高版本，架构必须与设备匹配。', 'The current Desktop package requires macOS 15.0 or later and must match the device architecture.')}</li></ol><div class="self-signed-note"><strong>{t('关于 macOS 自签名版本', 'About self-signed macOS builds')}</strong><p>{t('短期发布没有 Apple Developer ID 签名和公证。macOS 首次阻止启动时，请在“系统设置 → 隐私与安全性”中确认“仍要打开”；不需要关闭 Gatekeeper 或 SIP。', 'Near-term releases do not have an Apple Developer ID signature or notarization. If macOS blocks the first launch, approve Open Anyway under System Settings → Privacy & Security. Do not disable Gatekeeper or SIP.')}</p><a class="text-link" href={en ? '/en/docs/install-macos/' : '/docs/install-macos/'}>{t('查看完整 macOS 步骤', 'Read the macOS installation steps')} →</a></div><a class="text-link" href={en ? '/en/changelog/' : '/changelog/'}>{t('查看更新日志', 'View changelog')} →</a></section>
</SiteLayout>

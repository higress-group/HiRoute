{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiRoute",
  "version": "0.3.2-dev.1",
  "identifier": "ai.hiroute.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "status",
        "console"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../desktop/src-tauri/icons/icon.ico",
      "../../desktop/src-tauri/icons/icon.png"
    ],
    "resources": {
      "resources/standalone/": "standalone/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh",
        "languages": [
          "English"
        ]
      }
    }
  }
}

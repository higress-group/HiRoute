        {
          "contract": "hiroute.observation.execution-fact-envelope/v1",
          "mode": "recovery_read_only",
          "owner": "observation-storage",
          "reason": "Authenticate already-persisted V1 observations during read and backfill; live ingestion rejects them.",
          "removal_condition": "Remove only when an inventory of every active activity.db and every still-supported backup reports zero V1 observation rows; a backup containing V1 must either retain the authenticated reader or be explicitly retired by its retention owner.",
          "allowed_paths": [
            "crates/domain/src/observation/execution_validation.rs",
            "crates/domain/src/observation/execution_tests.rs",
            "e2e/golden/p0-gateway-golden.json",
            "e2e/schema/p0-execution-fact.schema.json",
            "tools/e2e-harness/src/p0/types.rs"
          ]
        },
        {
          "contract": "hiroute.observation.execution-fact-envelope/v2",
          "mode": "frozen_fixture",
          "owner": "gateway-e2e-oracle",
          "reason": "Preserve the prior production collector and its explicit incompatibility assertion outside current candidate smoke.",
          "removal_condition": "Remove only in the same change that deletes the sealed Oracle collector schema, its frozen types, and its dedicated historical test.",
          "allowed_paths": [
            "e2e/schema/p0-production-collector.schema.json",
            "tools/e2e-harness/src/p0/production/collector.rs",

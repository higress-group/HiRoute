          "contract": "hiroute.gateway.publication-snapshot/v2",
          "mode": "frozen_fixture",
          "owner": "gateway-e2e-oracle",
          "reason": "Seed only the historical sealed Oracle before its current-input adapter replaces the publication with V3.",
          "removal_condition": "Remove only in the same change that deletes the historical Oracle input adapter and its sealed V2 seed fixture.",

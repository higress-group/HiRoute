          "contract": "hiroute.gateway-publication/v2",
          "mode": "recovery_read_only",
          "owner": "routing-publication",
          "reason": "Authenticate persisted Product publications and the frozen deterministic fixture, then convert them to V3 before a new write.",
          "removal_condition": "Remove only when inventories of active, prepared, and last-known-good publication slots, recovery journals, and every still-supported backup report zero V2 aggregates; a backup containing V2 must retain conversion or be explicitly retired.",

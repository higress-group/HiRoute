        "hiroute.e2e.sut-build-attestation"
      ],
      "current_contracts": [
        "hiroute.e2e.sut-build-attestation/v3"
      ],
      "legacy_support": [
        {
          "contract": "hiroute.e2e.sut-build-attestation/v1",
          "mode": "frozen_fixture",
          "owner": "gateway-e2e-oracle",
          "reason": "Keep the sealed historical Gateway Oracle build proof isolated from current candidate preparation.",
          "removal_condition": "Remove only with the sealed Oracle launcher schema, frozen attestation type, and its dedicated historical test.",
          "allowed_paths": [
            "e2e/schema/p0-production-launcher.schema.json",
            "tools/e2e-harness/src/p0/production/types.rs",
            "tools/e2e-harness/tests/p0_gateway_oracle.rs"
          ]
        }
      ]
    },
    {

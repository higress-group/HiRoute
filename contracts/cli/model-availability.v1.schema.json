{
  "$id": "hiroute://contracts/cli/model-availability.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "featured": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "headline": {
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string"
              },
              "zh": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "zh"
            ],
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "included_on": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "new_model",
              "model_update"
            ]
          },
          "links": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "model_configuration_id": {
            "type": "string"
          },
          "note": {
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string"
              },
              "zh": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "zh"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "model_configuration_id",
          "headline",
          "note",
          "links",
          "included_on"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "models": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "executable",
                      "needs_connection"
                    ]
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "needs_newer_client"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "version"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "used_by_published_plans"
                  }
                },
                "required": [
                  "kind",
                  "count"
                ],
                "type": "object"
              }
            ]
          },
          "binding_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "display_name": {
            "type": "string"
          },
          "facts": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "context_tokens": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "publisher_id": {
                    "type": "string"
                  },
                  "reasoning": {
                    "anyOf": [
                      {
                        "oneOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "toggle",
                                  "budget"
                                ]
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "const": "profiles"
                              },
                              "profiles": {
                                "items": {
                                  "type": "string"
                                },
                                "type": "array"
                              }
                            },
                            "required": [
                              "kind",
                              "profiles"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tool": {
                    "type": "boolean"
                  },
                  "vision": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "publisher_id",
                  "context_tokens",
                  "tool",
                  "vision",
                  "reasoning"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "identity_stability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model_configuration_id": {
            "type": "string"
          },
          "origin": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "client_version": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "embedded"
                  }
                },
                "required": [
                  "kind",
                  "client_version"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "included_on": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "feed"
                  },
                  "sequence": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "sequence",
                  "included_on"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "published"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "model_configuration_id",
          "display_name",
          "origin",
          "identity_stability",
          "availability",
          "binding_ids",
          "facts"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "featured",
    "models"
  ],
  "type": "object"
}

{
  "$id": "hiroute://contracts/cli/worker-exec-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cwd": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "input": {
      "additionalProperties": false,
      "description": "The final labeled prompt is limited to 256 KiB.",
      "properties": {
        "acceptance_criteria": {
          "maxLength": 262144,
          "type": "string"
        },
        "constraints": {
          "maxLength": 262144,
          "type": "string"
        },
        "context": {
          "maxLength": 262144,
          "type": "string"
        },
        "goal": {
          "maxLength": 262144,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "goal"
      ],
      "type": "object"
    },
    "parent_task_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_./:-]+$",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_./:-]+$",
      "type": "string"
    },
    "run_timeout_secs": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "hiroute.worker-exec-request/v1"
    },
    "submission_key": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_./:-]+$",
      "type": "string"
    },
    "title": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plan_id",
    "cwd",
    "run_timeout_secs",
    "input",
    "submission_key"
  ],
  "type": "object"
}

{
  "$id": "hiroute://contracts/cli/model-feed-status.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "minimum": 0,
          "type": "integer"
        },
        "ignored_embedded": {
          "minimum": 0,
          "type": "integer"
        },
        "newer_client": {
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "applied",
        "ignored_embedded",
        "newer_client",
        "unresolved"
      ],
      "type": "object"
    },
    "disclosure": {
      "type": "string"
    },
    "disclosure_acknowledged": {
      "type": "boolean"
    },
    "held": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "issued_at": {
              "type": "string"
            },
            "retrieved_at": {
              "minimum": 0,
              "type": "integer"
            },
            "sequence": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "sequence",
            "issued_at",
            "retrieved_at"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "highest_accepted_sequence": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_attempt": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "at": {
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "enum": [
                "ok",
                "not_modified",
                "already_current",
                "not_published",
                "network",
                "size",
                "schema",
                "validation",
                "older_sequence"
              ]
            }
          },
          "required": [
            "at",
            "result",
            "reason"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_automatic_attempt_at": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery_available": {
      "type": "boolean"
    },
    "retrieval_enabled": {
      "type": "boolean"
    },
    "verification": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "validated",
                "none"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "discarded"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "recovery_available",
    "retrieval_enabled",
    "held",
    "highest_accepted_sequence",
    "last_attempt",
    "verification",
    "counts",
    "next_automatic_attempt_at",
    "disclosure",
    "disclosure_acknowledged"
  ],
  "type": "object"
}
